    "design_rules": {
      "material_priority": [
        [
          "green_black_soft_leather_commander_uniform",
          0.31
        ],
        [
          "black_reptile_pattern_leather_vest",
          0.18
        ],
        [
          "silver_hard_rubber_carapace",
          0.24
        ],
        [
          "simulated_bone_silver_shoulders",
          0.12
        ],
        [
          "dark_leather_lacing_straps_and_understructure",
          0.08
        ],
        [
          "aged_fasteners_and_production_wear",
          0.05
        ],
        [
          "restrained_organic_growth_detail",
          0.02
        ]
      ],
      "construction": [
        "fitted green-black Wraith commander leather uniform as the continuous base garment",
        "black reptile-pattern leather vest and upper-back yoke taken from screen-used commander tailoring",
        "single anatomically coherent silver hard-rubber front/back carapace rather than stacks of invented plates",
        "layered simulated-bone shoulder protection derived from screen-used Wraith drone armour",
        "flexible dark leather left visible at waist, flanks, inner arms and joints",
        "side/back lacing, snaps and closure hardware as practical costume construction",
        "small restrained thigh guards only where the PowerArmor silhouette needs lower-body protection",
        "production wear, rubbed edges and hand-built irregularity"
      ],
      "motifs": [
        "Wraith commander reptile-leather tailoring",
        "screen-used drone carapace material language",
        "bone shoulder anatomy",
        "predatory organic asymmetry",
        "aged leather and practical fasteners",
        "continuous costume construction beneath armour"
      ],
      "avoid": [
        "historical WNG apparel input",
        "anonymous armour panels",
        "stacked geometric plates",
        "purple armour with cyan lines",
        "uniform glow piping",
        "superhero chest segmentation",
        "ship fins pasted onto clothing",
        "flat vector polygons",
        "cloud noise",
        "clean generic marine armour"
      ]
    },
    "primary_research_basis": [
      "Propworx screen-used Wraith male commander costume: green leather trenchcoat; black reptile-pattern leather vest with epaulettes, snaps, zipper and side/back lacing; black leather trousers, gauntlets and boots",
      "Propworx Wraith Drone Uniform technical description: black leather under-vest; hard-rubber silver front/back carapace with clear covering; simulated-bone silver shoulder and thigh armour; leather chaps, greaves and gauntlets",
      "Val Halverson costume-designer Q&A: Wraith costumes use substantial real leather, contrast leather, gauntlets and belts as constructed wardrobe rather than generic painted sci-fi surfaces"
    ]
  },
