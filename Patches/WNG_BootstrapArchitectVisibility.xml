<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!--
    The Wraith engine seed is a technical growth/deployment endpoint, not a normal construction
    shortcut. Default acquisition is host/corpse growth. The settings-enabled bypass fabricates a
    deployable core instead, so this Def must never generate its own unconditional Architect icon.
  -->
  <Operation Class="PatchOperationRemove">
    <xpath>Defs/ThingDef[defName="WNG_WraithGravEngineSeed"]/designationCategory</xpath>
  </Operation>
</Patch>
