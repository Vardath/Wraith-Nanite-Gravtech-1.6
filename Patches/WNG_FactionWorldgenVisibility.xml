<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- RimWorld's world-creation faction picker requires
       maxConfigurableAtWorldCreation > 0.  Starting/worldgen flags alone are
       not enough to make a modded FactionDef appear in the Add list. -->
  <Operation Class="PatchOperationSequence">
    <operations>
      <li Class="PatchOperationAdd">
        <xpath>/Defs/FactionDef[defName="WNG_WraithBrood"]</xpath>
        <value><hidden>false</hidden><maxCountAtGameStart>1</maxCountAtGameStart><maxConfigurableAtWorldCreation>1</maxConfigurableAtWorldCreation><configurationListOrderPriority>120</configurationListOrderPriority></value>
      </li>
      <li Class="PatchOperationAdd">
        <xpath>/Defs/FactionDef[defName="WNG_WraithCinderCourt"]</xpath>
        <value><hidden>false</hidden><maxCountAtGameStart>1</maxCountAtGameStart><maxConfigurableAtWorldCreation>1</maxConfigurableAtWorldCreation><configurationListOrderPriority>121</configurationListOrderPriority></value>
      </li>
      <li Class="PatchOperationAdd">
        <xpath>/Defs/FactionDef[defName="WNG_WraithVeiledHive"]</xpath>
        <value><hidden>false</hidden><maxCountAtGameStart>1</maxCountAtGameStart><maxConfigurableAtWorldCreation>1</maxConfigurableAtWorldCreation><configurationListOrderPriority>122</configurationListOrderPriority></value>
      </li>
      <li Class="PatchOperationAdd">
        <xpath>/Defs/FactionDef[defName="WNG_WraithExiles"]</xpath>
        <value><hidden>false</hidden><maxCountAtGameStart>1</maxCountAtGameStart><maxConfigurableAtWorldCreation>1</maxConfigurableAtWorldCreation><configurationListOrderPriority>123</configurationListOrderPriority></value>
      </li>
      <li Class="PatchOperationAdd">
        <xpath>/Defs/FactionDef[defName="WNG_PrecursorCollective"]</xpath>
        <value><hidden>false</hidden><maxCountAtGameStart>1</maxCountAtGameStart><maxConfigurableAtWorldCreation>1</maxConfigurableAtWorldCreation><configurationListOrderPriority>124</configurationListOrderPriority></value>
      </li>
      <li Class="PatchOperationAdd">
        <xpath>/Defs/FactionDef[defName="WNG_HumanFormEnclave"]</xpath>
        <value><hidden>false</hidden><maxCountAtGameStart>1</maxCountAtGameStart><maxConfigurableAtWorldCreation>1</maxConfigurableAtWorldCreation><configurationListOrderPriority>125</configurationListOrderPriority></value>
      </li>

      <li Class="PatchOperationReplace">
        <xpath>/Defs/FactionDef[defName="WNG_ReplicatorSwarm"]/hidden</xpath>
        <value><hidden>false</hidden></value>
      </li>
      <li Class="PatchOperationReplace">
        <xpath>/Defs/FactionDef[defName="WNG_ReplicatorSwarm"]/canMakeRandomly</xpath>
        <value><canMakeRandomly>true</canMakeRandomly></value>
      </li>
      <li Class="PatchOperationReplace">
        <xpath>/Defs/FactionDef[defName="WNG_ReplicatorSwarm"]/settlementGenerationWeight</xpath>
        <value><settlementGenerationWeight>0.10</settlementGenerationWeight></value>
      </li>
      <li Class="PatchOperationAdd">
        <xpath>/Defs/FactionDef[defName="WNG_ReplicatorSwarm"]</xpath>
        <value><maxCountAtGameStart>1</maxCountAtGameStart><maxConfigurableAtWorldCreation>1</maxConfigurableAtWorldCreation><configurationListOrderPriority>126</configurationListOrderPriority></value>
      </li>
    </operations>
  </Operation>
</Patch>
