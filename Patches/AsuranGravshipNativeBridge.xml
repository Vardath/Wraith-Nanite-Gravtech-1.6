<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!--
    Asuran gravships use Odyssey's exact GravEngine at runtime. The WNG engine-theme comp enforces
    same-family facility links, so these Defs can participate in native launch/range/fuel checks
    without allowing Wraith, vanilla-chemfuel or future Goa'uld facilities to satisfy this engine.
  -->
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="GravEngine"]/comps/li[@Class="CompProperties_AffectedByFacilities"]/linkableFacilities</xpath>
    <value>
      <li>WNG_AsuranControlInterface</li>
      <li>WNG_AsuranNaniteSludgeTank</li>
      <li>WNG_AsuranLargeNaniteSludgeTank</li>
      <li>WNG_AsuranSmallThruster</li>
      <li>WNG_AsuranLargeThruster</li>
      <li>WNG_AsuranFieldExtender</li>
      <li>WNG_AsuranSignalJammer</li>
      <li>WNG_AsuranFuelOptimizer</li>
      <li>WNG_AsuranShieldEmitter</li>
    </value>
  </Operation>

  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="GravEngine"]/building/relatedBuildCommands</xpath>
    <value><li>WNG_AsuranHullSeed</li></value>
  </Operation>

  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="GravEngine"]/building/relatedTerrain</xpath>
    <value><li>WNG_AsuranSubstructure</li></value>
  </Operation>
</Patch>
