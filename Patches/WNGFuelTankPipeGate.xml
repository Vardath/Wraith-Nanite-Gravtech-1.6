<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!--
    FuelTankBase normally contributes directly to Odyssey fuel accounting. WNG deliberately adds
    physical fuel piping, so each WNG tank replaces its inherited facility comp with a native
    CompGravshipFacility subclass whose CanBeActive additionally requires a same-family pipe path
    to the themed engine. CompRefuelable remains the actual stored-fuel authority.
  -->

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="WNG_WraithBioSludgeTank"]/comps</xpath>
    <value>
      <comps Inherit="False">
        <li Class="WraithNaniteGravtech.CompProperties_WNGFuelTankFacility">
          <family>Wraith</family><connectivityCheckIntervalTicks>60</connectivityCheckIntervalTicks>
          <providesFuel>true</providesFuel><componentTypeDef>FuelStorage</componentTypeDef><requiresLOS>false</requiresLOS>
          <showMaxSimultaneous>false</showMaxSimultaneous><maxSimultaneous>9999</maxSimultaneous><maxDistance>500</maxDistance>
        </li>
        <li Class="CompProperties_Refuelable">
          <fuelCapacity>250</fuelCapacity><targetFuelLevelConfigurable>true</targetFuelLevelConfigurable><initialConfigurableTargetFuelLevel>250</initialConfigurableTargetFuelLevel>
          <fuelFilter><thingDefs><li>WNG_WraithBioSludge</li></thingDefs></fuelFilter><fuelLabel>Bio sludge</fuelLabel><fuelGizmoLabel>Bio sludge</fuelGizmoLabel>
          <consumeFuelOnlyWhenUsed>true</consumeFuelOnlyWhenUsed><autoRefuelPercent>1</autoRefuelPercent><showFuelGizmo>true</showFuelGizmo><drawOutOfFuelOverlay>false</drawOutOfFuelOverlay>
          <showAllowAutoRefuelToggle>true</showAllowAutoRefuelToggle><canEjectFuel>true</canEjectFuel><drawFuelGaugeInMap>false</drawFuelGaugeInMap>
        </li>
        <li Class="CompProperties_Breakdownable" />
        <li Class="WraithNaniteGravtech.CompProperties_WNGGravshipPartTheme"><theme>Wraith</theme></li>
      </comps>
    </value>
  </Operation>

