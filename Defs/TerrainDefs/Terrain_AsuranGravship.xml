<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Native Odyssey recognizes gravship foundation membership through the Substructure tag. -->
  <TerrainDef ParentName="FloorBase">
    <defName>WNG_AsuranSubstructure</defName>
    <label>Asuran gravship substructure</label>
    <description>A precise Ancient-derived deck lattice reconstructed by Asuran nanites. It participates in Odyssey's real connected-substructure system while remaining visually and materially distinct from Wraith living decks.</description>
    <!-- Temporary mechanics-validation art; final release requires dedicated Asuran geometric deck art. -->
    <texturePath>Terrain/Surfaces/Substructure/Substructure</texturePath>
    <fertility>0</fertility>
    <edgeType>Hard</edgeType>
    <renderPrecedence>399</renderPrecedence>
    <constructEffect>ConstructMetal</constructEffect>
    <isPaintable>false</isPaintable>
    <designationCategory>WNG</designationCategory>
    <isFoundation>true</isFoundation>
    <preventCraters>true</preventCraters>
    <affordances><li>Substructure</li></affordances>
    <statBases>
      <WorkToBuild>650</WorkToBuild>
      <Flammability>0.02</Flammability>
      <CleaningTimeFactor>0.7</CleaningTimeFactor>
    </statBases>
    <costList>
      <WNG_NaniteSludge>1</WNG_NaniteSludge>
      <Plasteel>2</Plasteel>
    </costList>
    <researchPrerequisites><li>WNG_AsuranGravships</li></researchPrerequisites>
    <requireInspectedGravEngine>true</requireInspectedGravEngine>
    <terrainAffordanceNeeded>Walkable</terrainAffordanceNeeded>
    <resourcesFractionWhenDeconstructed>0.5</resourcesFractionWhenDeconstructed>
    <tags><li>Substructure</li></tags>
    <placeWorkers>
      <li>PlaceWorker_InSubstructureFootprint</li>
      <li>PlaceWorker_BuildingsValidOverSubstructure</li>
    </placeWorkers>
  </TerrainDef>
</Defs>
