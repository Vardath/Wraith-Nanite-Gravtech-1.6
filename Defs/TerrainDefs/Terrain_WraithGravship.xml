<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Native Odyssey sees substructure by the Substructure tag rather than exact DefName. -->
  <TerrainDef ParentName="FloorBase">
    <defName>WNG_WraithLivingSubstructure</defName>
    <label>Wraith living substructure</label>
    <description>A cultivated living deck lattice adapted to the Odyssey gravship framework. It functions as genuine gravship substructure while remaining part of Wraith living-ship construction.</description>
    <!-- Temporary mechanics-validation art; final release requires Wraith living-deck art. -->
    <texturePath>Terrain/Surfaces/Substructure/Substructure</texturePath>
    <fertility>0</fertility>
    <edgeType>Hard</edgeType>
    <renderPrecedence>399</renderPrecedence>
    <constructEffect>ConstructMetal</constructEffect>
    <isPaintable>false</isPaintable>
    <designationCategory>WNG</designationCategory>
    <isFoundation>true</isFoundation>
    <preventCraters>true</preventCraters>
    <affordances>
      <li>Substructure</li>
    </affordances>
    <statBases>
      <WorkToBuild>700</WorkToBuild>
      <Flammability>0.15</Flammability>
      <CleaningTimeFactor>0.9</CleaningTimeFactor>
    </statBases>
    <costList>
      <WNG_WraithBioSludge>1</WNG_WraithBioSludge>
      <Steel>3</Steel>
    </costList>
    <researchPrerequisites>
      <li>WNG_WraithGravships</li>
    </researchPrerequisites>
    <requireInspectedGravEngine>true</requireInspectedGravEngine>
    <terrainAffordanceNeeded>Walkable</terrainAffordanceNeeded>
    <resourcesFractionWhenDeconstructed>0.5</resourcesFractionWhenDeconstructed>
    <tags>
      <li>Substructure</li>
    </tags>
    <placeWorkers>
      <li>PlaceWorker_InSubstructureFootprint</li>
      <li>PlaceWorker_BuildingsValidOverSubstructure</li>
    </placeWorkers>
  </TerrainDef>
</Defs>
