<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    Universal-crafting escape-hatch recipes are intentionally separate from the normal
    acquisition recipes. The global option is OFF by default; the worker is the sole
    availability authority for these fallback bills, so normal research/faction/worker
    restrictions remain untouched when the override is disabled.
  -->
  <RecipeDef>
    <defName>WNG_UniversalMake_AsuranSleeperStatue</defName>
    <label>make Asuran lattice sculpture (universal fallback)</label>
    <description>Universal-crafting fallback for the Asuran lattice sculpture. It uses the same physical materials, Artistic skill and work as the normal Asuran-only fabrication route, but is available to ordinary sculptors only while Enable universal WNG crafting is turned on.</description>
    <jobString>Making Asuran lattice sculpture.</jobString>
    <workerClass>WraithNaniteGravtech.RecipeWorker_UniversalCraftOnly</workerClass>
    <workAmount>32000</workAmount>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <workSkill>Artistic</workSkill>
    <skillRequirements><Artistic>6</Artistic></skillRequirements>
    <ingredients>
      <li><filter><thingDefs><li>Plasteel</li></thingDefs></filter><count>35</count></li>
      <li><filter><thingDefs><li>ComponentSpacer</li></thingDefs></filter><count>1</count></li>
      <li><filter><thingDefs><li>WNG_AsuranNaniteSlurry</li></thingDefs></filter><count>30</count></li>
      <li><filter><thingDefs><li>Silver</li></thingDefs></filter><count>100</count></li>
    </ingredients>
    <fixedIngredientFilter><thingDefs><li>Plasteel</li><li>ComponentSpacer</li><li>WNG_AsuranNaniteSlurry</li><li>Silver</li></thingDefs></fixedIngredientFilter>
    <products><WNG_AsuranSleeperStatue>1</WNG_AsuranSleeperStatue></products>
    <recipeUsers><li>TableSculpting</li></recipeUsers>
    <effectWorking>Sculpt</effectWorking>
    <soundWorking>Recipe_Sculpt</soundWorking>
  </RecipeDef>

