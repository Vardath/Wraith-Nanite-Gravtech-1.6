  <!--
    Precursor/Ancient universal fallbacks use the vanilla fabrication bench because the
    normal recipes are physically manufactured technology whose only special station is
    WNG_PrecursorFabricator. Inputs, output counts, work and skill requirements mirror
    the current clean normal recipes; only the research/station gate is bypassed while
    the global universal-crafting option is enabled.
  -->
  <RecipeDef>
    <defName>WNG_Universal_ReconstructAncientDrone</defName>
    <label>reconstruct Ancient drone (universal fallback)</label>
    <description>Universal-crafting fallback for one stable Ancient drone weapon. Uses the same physical inputs and work as the normal Asuran-fabricator route.</description>
    <jobString>Reconstructing Ancient drone.</jobString>
    <workerClass>WraithNaniteGravtech.RecipeWorker_UniversalCraftOnly</workerClass>
    <workAmount>5500</workAmount>
    <workSkill>Crafting</workSkill>
    <ingredients>
      <li><filter><thingDefs><li>Plasteel</li></thingDefs></filter><count>20</count></li>
      <li><filter><thingDefs><li>Uranium</li></thingDefs></filter><count>5</count></li>
      <li><filter><thingDefs><li>ComponentSpacer</li></thingDefs></filter><count>1</count></li>
    </ingredients>
    <fixedIngredientFilter><thingDefs><li>Plasteel</li><li>Uranium</li><li>ComponentSpacer</li></thingDefs></fixedIngredientFilter>
    <products><WNG_AncientDrone>1</WNG_AncientDrone></products>
    <recipeUsers><li>FabricationBench</li></recipeUsers>
  </RecipeDef>

