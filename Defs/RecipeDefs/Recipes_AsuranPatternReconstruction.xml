<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    Pattern reconstruction is a bounded foreign-technology use of the current Asuran nanite-slurry
    economy. Slurry quantities preserve the older raw Replicator-matter burden at the current
    10 Blocks -> 20 slurry conversion ratio. Balance remains provisional pending live playtesting.
  -->
  <RecipeDef>
    <defName>WNG_ReconstructChargeRifle</defName>
    <label>reconstruct charge rifle from pattern</label>
    <description>Reconstruct a learned charge-rifle pattern from stabilized Asuran nanite slurry and spacer-grade structural material. Requires a powered same-faction Pattern Archive carrying the scanned charge-rifle pattern.</description>
    <jobString>Reconstructing charge rifle from pattern.</jobString>
    <workerClass>WraithNaniteGravtech.RecipeWorker_AsuranPatternLocked</workerClass>
    <workAmount>24000</workAmount>
    <workSkill>Crafting</workSkill>
    <researchPrerequisite>WNG_PrecursorFabrication</researchPrerequisite>
    <skillRequirements><Crafting>8</Crafting></skillRequirements>
    <ingredients>
      <li><filter><thingDefs><li>Plasteel</li></thingDefs></filter><count>40</count></li>
      <li><filter><thingDefs><li>ComponentSpacer</li></thingDefs></filter><count>2</count></li>
      <li><filter><thingDefs><li>WNG_AsuranNaniteSlurry</li></thingDefs></filter><count>40</count></li>
    </ingredients>
    <fixedIngredientFilter><thingDefs><li>Plasteel</li><li>ComponentSpacer</li><li>WNG_AsuranNaniteSlurry</li></thingDefs></fixedIngredientFilter>
    <products><Gun_ChargeRifle>1</Gun_ChargeRifle></products>
    <recipeUsers><li>WNG_PrecursorFabricator</li></recipeUsers>
  </RecipeDef>

