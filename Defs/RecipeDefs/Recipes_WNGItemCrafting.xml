<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    Explicit WNG-only item crafting recipes.
    These replace ThingDef.recipeMaker-generated recipes so WNG never participates in
    RimWorld's global generated make-recipe pass. Every recipe is routed only to a WNG-owned
    station, isolating vanilla and earlier-loaded mods' bill lists from WNG recipe generation.
  -->
  <RecipeDef Name="Template_WNG_Make_WraithHunterCoat">
    <defName>WNG_Make_WraithHunterCoat</defName>
    <label>make wraith hunter coat</label>
    <description>Manufacture wraith hunter coat using WNG's dedicated production chain.</description>
    <jobString>Making wraith hunter coat.</jobString>
    <workAmount>14000</workAmount>
    <workSkill>Crafting</workSkill>
    <researchPrerequisite>WNG_BiologicalCultivation</researchPrerequisite>
    <skillRequirements><Crafting>4</Crafting></skillRequirements>
    <ingredients>
      <li><filter><thingDefs><li>WNG_Biomass</li></thingDefs></filter><count>24</count></li>
    </ingredients>
    <fixedIngredientFilter><thingDefs><li>WNG_Biomass</li></thingDefs></fixedIngredientFilter>
    <products><WNG_WraithHunterCoat>1</WNG_WraithHunterCoat></products>
    <recipeUsers><li>WNG_LivingForge</li></recipeUsers>
  </RecipeDef>

