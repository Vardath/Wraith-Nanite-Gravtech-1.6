<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ScenarioDef ParentName="ScenarioBase">
    <defName>WNG_WraithLandfall</defName>
    <label>Wraith: Landfall</label>
    <description>A small Wraith hunting cell has made landfall on a rimworld. You begin with living weapons, cultivated biomass and the means to establish a first living forge.</description>
    <scenario>
      <summary>Three player-aligned Wraith begin on the surface.</summary>
      <playerFaction><factionDef>PlayerColony</factionDef></playerFaction>
      <parts Inherit="False">
        <li Class="ScenPart_ConfigPage_ConfigureStartingPawns_Xenotypes">
          <def>ConfigurePawnsXenotypes</def>
          <pawnChoiceCount>8</pawnChoiceCount>
          <customSummary>Start with three player-aligned Wraith.</customSummary>
          <overrideKinds><li><xenotype>WNG_Wraith</xenotype><pawnKind>WNG_PlayerWraith</pawnKind></li></overrideKinds>
          <xenotypeCounts><li><xenotype>WNG_Wraith</xenotype><count>3</count><requiredAtStart>true</requiredAtStart><allowedDevelopmentalStages>Adult</allowedDevelopmentalStages></li></xenotypeCounts>
        </li>
        <li Class="ScenPart_PlayerPawnsArriveMethod"><def>PlayerPawnsArriveMethod</def><method>Standing</method></li>
        <li Class="ScenPart_StartingThing_Defined"><def>StartingThing_Defined</def><thingDef>WNG_WraithCarbine</thingDef><count>2</count></li>
        <li Class="ScenPart_StartingThing_Defined"><def>StartingThing_Defined</def><thingDef>WNG_WraithStunner</thingDef></li>
        <li Class="ScenPart_StartingThing_Defined"><def>StartingThing_Defined</def><thingDef>WNG_Biomass</thingDef><count>80</count></li>
        <li Class="ScenPart_StartingThing_Defined"><def>StartingThing_Defined</def><thingDef>WNG_LivingForgeSeed</thingDef></li>
        <li Class="ScenPart_StartingThing_Defined"><def>StartingThing_Defined</def><thingDef>MedicineIndustrial</thingDef><count>12</count></li>
        <li Class="ScenPart_GameStartDialog"><def>GameStartDialog</def><text>Your hunting cell has landed far from any established hive. Prey, raw matter and unfamiliar civilizations surround you. Establish a living foothold, feed carefully, and grow whatever technology you need.</text><closeSound>GameStartSting</closeSound></li>
      </parts>
    </scenario>
  </ScenarioDef>

  <ScenarioDef ParentName="ScenarioBase">
    <defName>WNG_WraithOrbit</defName>
    <label>Wraith: In Orbit</label>
    <description>A Wraith cell begins in orbit aboard a functioning gravship platform, with enough living material to refit the vessel toward an organic design.</description>
    <scenario>
      <summary>Three player-aligned Wraith begin in orbit with a gravship.</summary>
      <playerFaction><factionDef>PlayerColony</factionDef></playerFaction>
      <parts Inherit="False">
        <li Class="ScenPart_PlanetLayer"><def>PlanetLayerFixed</def><tag>Orbit</tag><layer>Orbit</layer><settingsDef>Orbit</settingsDef><hide>true</hide><connections><Surface><zoomMode>ZoomIn</zoomMode></Surface></connections></li>
        <li Class="ScenPart_ConfigPage_ConfigureStartingPawns_Xenotypes">
          <def>ConfigurePawnsXenotypes</def><pawnChoiceCount>8</pawnChoiceCount><customSummary>Start with three player-aligned Wraith in orbit.</customSummary>
          <overrideKinds><li><xenotype>WNG_Wraith</xenotype><pawnKind>WNG_PlayerWraith</pawnKind></li></overrideKinds>
          <xenotypeCounts><li><xenotype>WNG_Wraith</xenotype><count>3</count><requiredAtStart>true</requiredAtStart><allowedDevelopmentalStages>Adult</allowedDevelopmentalStages></li></xenotypeCounts>
        </li>
        <li Class="ScenPart_ForcedMap"><def>ForcedMap</def><mapGenerator>OrbitalRelay</mapGenerator><layerDef>Orbit</layerDef></li>
        <li Class="ScenPart_PlayerPawnsArriveMethod"><def>PlayerPawnsArriveMethod</def><method>Gravship</method></li>
        <li Class="ScenPart_StartingResearch"><def>StartingResearch</def><project>BasicGravtech</project></li>
        <li Class="ScenPart_StartingThing_Defined"><def>StartingThing_Defined</def><thingDef>WNG_WraithCarbine</thingDef><count>2</count></li>
        <li Class="ScenPart_StartingThing_Defined"><def>StartingThing_Defined</def><thingDef>WNG_WraithStunner</thingDef></li>
        <li Class="ScenPart_StartingThing_Defined"><def>StartingThing_Defined</def><thingDef>WNG_Biomass</thingDef><count>120</count></li>
        <li Class="ScenPart_StartingThing_Defined"><def>StartingThing_Defined</def><thingDef>WNG_LivingForgeSeed</thingDef></li>
        <li Class="ScenPart_StartingThing_Defined"><def>StartingThing_Defined</def><thingDef>Chemfuel</thingDef><count>120</count></li>
        <li Class="ScenPart_GameStartDialog"><def>GameStartDialog</def><text>You begin above the rimworld with a usable gravship and only a small stock of living material. Refit the vessel, descend to feed and harvest, or remain in orbit while you grow an organic fleet.</text><closeSound>GameStartSting</closeSound></li>
      </parts>
    </scenario>
  </ScenarioDef>

  <ScenarioDef ParentName="ScenarioBase">
    <defName>WNG_HumanFormReplicatorLandfall</defName>
    <label>Human-form Replicators: Landfall</label>
    <description>Three player-aligned human-form nanite beings begin on the surface with precursor equipment and the ability to reconstruct themselves and interface directly with biological minds.</description>
    <scenario>
      <summary>Three player human-form Replicators begin on the surface.</summary>
      <playerFaction><factionDef>PlayerColony</factionDef></playerFaction>
      <parts Inherit="False">
        <li Class="ScenPart_ConfigPage_ConfigureStartingPawns_Xenotypes">
          <def>ConfigurePawnsXenotypes</def><pawnChoiceCount>8</pawnChoiceCount><customSummary>Start with three player human-form Replicators.</customSummary>
          <overrideKinds><li><xenotype>WNG_NanitePrecursor</xenotype><pawnKind>WNG_PlayerHumanFormReplicator</pawnKind></li></overrideKinds>
          <xenotypeCounts><li><xenotype>WNG_NanitePrecursor</xenotype><count>3</count><requiredAtStart>true</requiredAtStart><allowedDevelopmentalStages>Adult</allowedDevelopmentalStages></li></xenotypeCounts>
        </li>
        <li Class="ScenPart_PlayerPawnsArriveMethod"><def>PlayerPawnsArriveMethod</def><method>Standing</method></li>
        <li Class="ScenPart_StartingThing_Defined"><def>StartingThing_Defined</def><thingDef>WNG_PrecursorPulseRifle</thingDef><count>2</count></li>
        <li Class="ScenPart_StartingThing_Defined"><def>StartingThing_Defined</def><thingDef>WNG_PrecursorFieldArmor</thingDef><count>2</count></li>
        <li Class="ScenPart_StartingThing_Defined"><def>StartingThing_Defined</def><thingDef>Plasteel</thingDef><count>180</count></li>
        <li Class="ScenPart_StartingThing_Defined"><def>StartingThing_Defined</def><thingDef>ComponentSpacer</thingDef><count>6</count></li>
        <li Class="ScenPart_StartingThing_Defined"><def>StartingThing_Defined</def><thingDef>ComponentIndustrial</thingDef><count>20</count></li>
        <li Class="ScenPart_GameStartDialog"><def>GameStartDialog</def><text>You have arrived intact, but without an established city or network. Build a precursor foothold, study the inhabitants, and decide whether to coexist, recruit, subjugate, copy, or simply outlast them.</text><closeSound>GameStartSting</closeSound></li>
      </parts>
    </scenario>
  </ScenarioDef>

  <ScenarioDef ParentName="ScenarioBase">
    <defName>WNG_HumanFormReplicatorOrbit</defName>
    <label>Human-form Replicators: In Orbit</label>
    <description>Three player-aligned human-form nanite beings begin in orbit with a native Odyssey gravship and precursor materials for a compact advanced vessel.</description>
    <scenario>
      <summary>Three player human-form Replicators begin in orbit with a gravship.</summary>
      <playerFaction><factionDef>PlayerColony</factionDef></playerFaction>
      <parts Inherit="False">
        <li Class="ScenPart_PlanetLayer"><def>PlanetLayerFixed</def><tag>Orbit</tag><layer>Orbit</layer><settingsDef>Orbit</settingsDef><hide>true</hide><connections><Surface><zoomMode>ZoomIn</zoomMode></Surface></connections></li>
        <li Class="ScenPart_ConfigPage_ConfigureStartingPawns_Xenotypes">
          <def>ConfigurePawnsXenotypes</def><pawnChoiceCount>8</pawnChoiceCount><customSummary>Start with three player human-form Replicators in orbit.</customSummary>
          <overrideKinds><li><xenotype>WNG_NanitePrecursor</xenotype><pawnKind>WNG_PlayerHumanFormReplicator</pawnKind></li></overrideKinds>
          <xenotypeCounts><li><xenotype>WNG_NanitePrecursor</xenotype><count>3</count><requiredAtStart>true</requiredAtStart><allowedDevelopmentalStages>Adult</allowedDevelopmentalStages></li></xenotypeCounts>
        </li>
        <li Class="ScenPart_ForcedMap"><def>ForcedMap</def><mapGenerator>OrbitalRelay</mapGenerator><layerDef>Orbit</layerDef></li>
        <li Class="ScenPart_PlayerPawnsArriveMethod"><def>PlayerPawnsArriveMethod</def><method>Gravship</method></li>
        <li Class="ScenPart_StartingResearch"><def>StartingResearch</def><project>BasicGravtech</project></li>
        <li Class="ScenPart_StartingThing_Defined"><def>StartingThing_Defined</def><thingDef>WNG_PrecursorPulseRifle</thingDef><count>2</count></li>
        <li Class="ScenPart_StartingThing_Defined"><def>StartingThing_Defined</def><thingDef>WNG_PrecursorFieldArmor</thingDef><count>2</count></li>
        <li Class="ScenPart_StartingThing_Defined"><def>StartingThing_Defined</def><thingDef>Plasteel</thingDef><count>220</count></li>
        <li Class="ScenPart_StartingThing_Defined"><def>StartingThing_Defined</def><thingDef>ComponentSpacer</thingDef><count>10</count></li>
        <li Class="ScenPart_StartingThing_Defined"><def>StartingThing_Defined</def><thingDef>Chemfuel</thingDef><count>120</count></li>
        <li Class="ScenPart_GameStartDialog"><def>GameStartDialog</def><text>Your group begins in orbit with a functioning gravship and enough advanced material to shape it into a compact precursor vessel. Land when useful, remain above the world when safer, and expand deliberately.</text><closeSound>GameStartSting</closeSound></li>
      </parts>
    </scenario>
  </ScenarioDef>
</Defs>
