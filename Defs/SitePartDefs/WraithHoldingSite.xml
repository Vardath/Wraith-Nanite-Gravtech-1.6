<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <SitePartDef>
    <defName>WNG_WraithHoldingSite</defName>
    <label>Wraith holding site</label>
    <description>A traced Wraith holding site containing an abducted pawn. The captive at this site is the exact pawn taken from the colony, not a generated substitute.</description>
    <workerClass>WraithNaniteGravtech.SitePartWorker_WraithHoldingSite</workerClass>
    <siteTexture>World/WorldObjects/Sites/GenericSite</siteTexture>
    <expandingIconTexture>World/WorldObjects/Expanding/Sites/Prisoner</expandingIconTexture>
    <forceExitAndRemoveMapCountdownDurationDays>6</forceExitAndRemoveMapCountdownDurationDays>
    <requiresFaction>true</requiresFaction>
    <wantsThreatPoints>true</wantsThreatPoints>
    <handlesWorldObjectTimeoutInspectString>false</handlesWorldObjectTimeoutInspectString>
    <tags>
      <li>WNG_WraithHoldingSite</li>
    </tags>
  </SitePartDef>

  <GenStepDef>
    <defName>WNG_WraithHoldingSite</defName>
    <linkWithSite>WNG_WraithHoldingSite</linkWithSite>
    <order>460</order>
    <genStep Class="GenStep_PrisonerWillingToJoin">
      <count>1</count>
      <nearMapCenter>true</nearMapCenter>
    </genStep>
  </GenStepDef>
</Defs>
