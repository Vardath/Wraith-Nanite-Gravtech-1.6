<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <SitePartDef>
    <defName>WNG_AncientPrecursorVault</defName>
    <label>abandoned precursor vault</label>
    <description>A sealed precursor-era installation whose power signature has only recently become detectable. Old automated security and intact high-energy artifacts may remain inside.</description>
    <workerClass>WraithNaniteGravtech.SitePartWorker_AncientPrecursorVault</workerClass>
    <siteTexture>World/WNG_AncientPrecursorVault</siteTexture>
    <expandingIconTexture>World/WNG_AncientPrecursorVault</expandingIconTexture>
    <applyFactionColorToSiteTexture>false</applyFactionColorToSiteTexture>
    <showFactionInInspectString>false</showFactionInInspectString>
    <requiresFaction>false</requiresFaction>
    <approachOrderString>Approach {0}</approachOrderString>
    <approachingReportString>Approaching {0}</approachingReportString>
    <arrivedLetterLabelPart>Abandoned precursor vault</arrivedLetterLabelPart>
    <arrivedLetter>You have reached the precursor vault. The surviving structure is sealed and old machine signatures remain active inside. Breach it carefully; surviving power artifacts may still be recoverable.</arrivedLetter>
    <arrivedLetterDef>ThreatBig</arrivedLetterDef>
    <wantsThreatPoints>true</wantsThreatPoints>
    <badEvenIfNoMap>true</badEvenIfNoMap>
    <forceExitAndRemoveMapCountdownDurationDays>5</forceExitAndRemoveMapCountdownDurationDays>
    <considerEnteringAsAttack>false</considerEnteringAsAttack>
    <mainPartAllThreatsLabel>ancient security</mainPartAllThreatsLabel>
    <minMapSize>(200,1,200)</minMapSize>
    <gravShipsCanLandOn>true</gravShipsCanLandOn>
  </SitePartDef>
</Defs>
