<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <RecipeDef>
    <defName>WNG_BootstrapCraftLivingForge</defName>
    <label>fabricate living forge</label>
    <description>Optionally fabricate a minified living forge from conventional industrial materials. This bootstrap route is controlled in Wraith &amp; Nanite Gravtech mod settings and is disabled by default.</description>
    <jobString>Fabricating a living forge.</jobString>
    <workerClass>WraithNaniteGravtech.RecipeWorker_WNGBootstrapBuilding</workerClass>
    <workAmount>18000</workAmount><workSkill>Crafting</workSkill><researchPrerequisite>WNG_BiologicalCultivation</researchPrerequisite>
    <skillRequirements><Crafting>6</Crafting></skillRequirements>
    <ingredients>
      <li><filter><thingDefs><li>Steel</li></thingDefs></filter><count>180</count></li>
      <li><filter><thingDefs><li>ComponentIndustrial</li></thingDefs></filter><count>8</count></li>
      <li><filter><categories><li>MeatRaw</li></categories></filter><count>40</count></li>
    </ingredients>
    <fixedIngredientFilter><thingDefs><li>Steel</li><li>ComponentIndustrial</li></thingDefs><categories><li>MeatRaw</li></categories></fixedIngredientFilter>
    <recipeUsers><li>FabricationBench</li></recipeUsers>
  </RecipeDef>

  <RecipeDef>
    <defName>WNG_BootstrapCraftAsuranFabricator</defName>
    <label>fabricate Asuran fabricator</label>
    <description>Optionally fabricate a minified Asuran fabricator/synthesizer from spacer-grade conventional resources. Controlled in WNG mod settings and disabled by default.</description>
    <jobString>Fabricating an Asuran fabricator.</jobString>
    <workerClass>WraithNaniteGravtech.RecipeWorker_WNGBootstrapBuilding</workerClass>
    <workAmount>32000</workAmount><workSkill>Crafting</workSkill><researchPrerequisite>WNG_PrecursorFabrication</researchPrerequisite>
    <skillRequirements><Crafting>8</Crafting></skillRequirements>
    <ingredients>
      <li><filter><thingDefs><li>Plasteel</li></thingDefs></filter><count>120</count></li>
      <li><filter><thingDefs><li>ComponentSpacer</li></thingDefs></filter><count>4</count></li>
      <li><filter><thingDefs><li>ComponentIndustrial</li></thingDefs></filter><count>12</count></li>
    </ingredients>
    <fixedIngredientFilter><thingDefs><li>Plasteel</li><li>ComponentSpacer</li><li>ComponentIndustrial</li></thingDefs></fixedIngredientFilter>
    <recipeUsers><li>FabricationBench</li></recipeUsers>
  </RecipeDef>

  <RecipeDef>
    <defName>WNG_BootstrapCraftWraithGravEngine</defName>
    <label>fabricate Wraith grav engine</label>
    <description>Optional direct fabrication of a minified Wraith grav engine for players who do not want to use host incubation. Disabled by default.</description>
    <jobString>Fabricating a Wraith grav engine.</jobString>
    <workerClass>WraithNaniteGravtech.RecipeWorker_WNGBootstrapBuilding</workerClass>
    <workAmount>60000</workAmount><workSkill>Crafting</workSkill><researchPrerequisite>WNG_BiologicalCultivation</researchPrerequisite>
    <skillRequirements><Crafting>10</Crafting></skillRequirements>
    <ingredients>
      <li><filter><thingDefs><li>Plasteel</li></thingDefs></filter><count>220</count></li>
      <li><filter><thingDefs><li>ComponentSpacer</li></thingDefs></filter><count>8</count></li>
      <li><filter><categories><li>MeatRaw</li></categories></filter><count>100</count></li>
    </ingredients>
    <fixedIngredientFilter><thingDefs><li>Plasteel</li><li>ComponentSpacer</li></thingDefs><categories><li>MeatRaw</li></categories></fixedIngredientFilter>
    <recipeUsers><li>FabricationBench</li></recipeUsers>
  </RecipeDef>

  <RecipeDef>
    <defName>WNG_BootstrapCraftPrecursorGravEngine</defName>
    <label>fabricate Precursor grav engine</label>
    <description>Optional direct fabrication of a minified Precursor grav engine from spacer-grade materials. Disabled by default.</description>
    <jobString>Fabricating a Precursor grav engine.</jobString>
    <workerClass>WraithNaniteGravtech.RecipeWorker_WNGBootstrapBuilding</workerClass>
    <workAmount>72000</workAmount><workSkill>Crafting</workSkill><researchPrerequisite>WNG_PrecursorFabrication</researchPrerequisite>
    <skillRequirements><Crafting>12</Crafting></skillRequirements>
    <ingredients>
      <li><filter><thingDefs><li>Plasteel</li></thingDefs></filter><count>300</count></li>
      <li><filter><thingDefs><li>ComponentSpacer</li></thingDefs></filter><count>12</count></li>
      <li><filter><thingDefs><li>Uranium</li></thingDefs></filter><count>80</count></li>
    </ingredients>
    <fixedIngredientFilter><thingDefs><li>Plasteel</li><li>ComponentSpacer</li><li>Uranium</li></thingDefs></fixedIngredientFilter>
    <recipeUsers><li>FabricationBench</li></recipeUsers>
  </RecipeDef>
</Defs>
