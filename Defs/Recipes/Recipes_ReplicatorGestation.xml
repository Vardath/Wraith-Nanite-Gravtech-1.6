<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <RecipeDef ParentName="LightMechanoidRecipe">
    <defName>WNG_ChildsToy</defName>
    <label>Child's Toy</label>
    <description>Gestate a controlled modular mechanical toy from dormant Replicator substrate. The toy is not an active Replicator while controlled; if control is lost for too long, its concealed lattice unfolds into a hostile Replicator.</description>
    <researchPrerequisite>WNG_ReplicatorGestation</researchPrerequisite>
    <ingredients Inherit="False">
      <li>
        <filter><thingDefs><li>Steel</li></thingDefs></filter>
        <count>35</count>
      </li>
      <li>
        <filter><thingDefs><li>WNG_ReplicatorMatter</li></thingDefs></filter>
        <count>10</count>
      </li>
      <li>
        <filter><thingDefs><li>SubcoreBasic</li></thingDefs></filter>
        <count>1</count>
      </li>
    </ingredients>
    <formingTicks>90000</formingTicks>
    <products><WNG_ChildsToy>1</WNG_ChildsToy></products>
    <descriptionHyperlinks><ThingDef>WNG_ChildsToy</ThingDef></descriptionHyperlinks>
  </RecipeDef>
</Defs>
