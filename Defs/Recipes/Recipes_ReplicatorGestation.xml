<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <RecipeDef ParentName="LightMechanoidRecipe">
    <defName>WNG_ChildsToy</defName>
    <label>Child's Toy</label>
    <description>Gestate an innocuous-looking modular mechanical toy. Once released from the gestator, the assembly identifies itself only as a Replicator.</description>
    <researchPrerequisite>WNG_ReplicatorGestation</researchPrerequisite>
    <ingredients Inherit="False">
      <li>
        <filter><thingDefs><li>Steel</li></thingDefs></filter>
        <count>35</count>
      </li>
      <li>
        <filter><thingDefs><li>WNG_ReplicatorMatter</li></thingDefs></filter>
        <count>10</count>
      </li>
      <li>
        <filter><thingDefs><li>SubcoreBasic</li></thingDefs></filter>
        <count>1</count>
      </li>
    </ingredients>
    <formingTicks>90000</formingTicks>
    <products><WNG_ReplicatorDrone>1</WNG_ReplicatorDrone></products>
    <descriptionHyperlinks><ThingDef>WNG_ReplicatorDrone</ThingDef></descriptionHyperlinks>
  </RecipeDef>
</Defs>
