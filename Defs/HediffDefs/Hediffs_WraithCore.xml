<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <HediffDef>
    <defName>WNG_LifeForceStarved</defName>
    <label>life-force starvation</label>
    <description>Life Force reserves are critically low. Regeneration is heavily reduced and the Wraith becomes weak until it feeds.</description>
    <isBad>true</isBad><duplicationAllowed>false</duplicationAllowed><scenarioCanAdd>false</scenarioCanAdd>
    <stages><li><capMods>
      <li><capacity>Moving</capacity><offset>-0.20</offset></li>
      <li><capacity>Manipulation</capacity><offset>-0.15</offset></li>
      <li><capacity>Consciousness</capacity><offset>-0.10</offset></li>
    </capMods></li></stages>
  </HediffDef>

  <HediffDef>
    <defName>WNG_LifeForceTorpor</defName>
    <label>life-force torpor</label>
    <description>With no usable Life Force remaining, the Wraith has entered a near-dormant survival state until some reserve is restored.</description>
    <isBad>true</isBad><duplicationAllowed>false</duplicationAllowed><scenarioCanAdd>false</scenarioCanAdd>
    <stages><li><capMods>
      <li><capacity>Moving</capacity><setMax>0.02</setMax></li>
      <li><capacity>Manipulation</capacity><setMax>0.05</setMax></li>
      <li><capacity>Consciousness</capacity><setMax>0.15</setMax></li>
    </capMods></li></stages>
  </HediffDef>

  <HediffDef>
    <defName>WNG_WraithHibernating</defName>
    <label>wraith hibernation</label>
    <description>The Wraith has deliberately collapsed into deep hibernation. Life Force consumption is greatly reduced while movement and awareness are almost eliminated.</description>
    <hediffClass>HediffWithComps</hediffClass><isBad>false</isBad><duplicationAllowed>false</duplicationAllowed><scenarioCanAdd>false</scenarioCanAdd>
    <comps><li Class="HediffCompProperties_Disappears"><disappearsAfterTicks>180000~180000</disappearsAfterTicks><showRemainingTime>true</showRemainingTime></li></comps>
    <stages><li><capMods>
      <li><capacity>Moving</capacity><setMax>0.08</setMax></li>
      <li><capacity>Manipulation</capacity><setMax>0.08</setMax></li>
      <li><capacity>Consciousness</capacity><setMax>0.18</setMax></li>
    </capMods></li></stages>
  </HediffDef>

  <HediffDef>
    <defName>WNG_LifeDrained</defName>
    <label>life drained</label>
    <description>A large portion of this pawn's vitality has been stripped away by Wraith feeding. The acute condition fades, but the biological aging remains.</description>
    <hediffClass>HediffWithComps</hediffClass><isBad>true</isBad><duplicationAllowed>false</duplicationAllowed><scenarioCanAdd>false</scenarioCanAdd>
    <comps><li Class="HediffCompProperties_Disappears"><disappearsAfterTicks>60000~120000</disappearsAfterTicks><showRemainingTime>true</showRemainingTime></li></comps>
  </HediffDef>

  <HediffDef>
    <defName>WNG_FedRecently</defName>
    <label>fed recently</label>
    <description>This Wraith has fed recently. Its tissues are saturated with stolen vitality and regenerate substantially faster for roughly one day.</description>
    <hediffClass>HediffWithComps</hediffClass><isBad>false</isBad><duplicationAllowed>false</duplicationAllowed><scenarioCanAdd>false</scenarioCanAdd>
    <comps><li Class="HediffCompProperties_Disappears"><disappearsAfterTicks>60000~60000</disappearsAfterTicks><showRemainingTime>true</showRemainingTime></li></comps>
  </HediffDef>
</Defs>
