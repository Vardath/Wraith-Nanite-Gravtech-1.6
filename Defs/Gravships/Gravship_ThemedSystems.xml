<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="SmallThruster">
    <defName>WNG_OrganicThruster</defName>
    <label>wraith gravship drive organ</label>
    <description>A grown propulsion organ performing the native Odyssey small-thruster role for a Wraith gravship.</description>
    <designationCategory>WNG_Architect</designationCategory><uiOrder>2201</uiOrder>
    <graphicData><graphicClass>Graphic_Multi</graphicClass><texPath>Things/Building/Wraith/Gravship/WNG_OrganicThruster</texPath><drawSize>(1.1,2.2)</drawSize></graphicData>
    <statBases><MaxHitPoints>430</MaxHitPoints><Flammability>0.12</Flammability><Beauty>2</Beauty><WorkToBuild>9800</WorkToBuild><Mass>16</Mass></statBases>
    <costList Inherit="False"><WNG_Biomass>90</WNG_Biomass><GravlitePanel>22</GravlitePanel><ComponentIndustrial>2</ComponentIndustrial></costList>
    <researchPrerequisites Inherit="False"><li>WNG_OrganicFlight</li><li>BasicGravtech</li></researchPrerequisites>
    <placeWorkers Inherit="False"><li>PlaceWorker_GravshipThruster</li><li>WraithNaniteGravtech.PlaceWorker_RequireWraithGravshipSubstructure</li></placeWorkers>
  </ThingDef>

  <ThingDef ParentName="SmallThruster">
    <defName>WNG_PrecursorVectorThruster</defName>
    <label>Asuran gravship vector drive</label>
    <description>A compact Asuran field-vectoring drive performing the native Odyssey small-thruster role.</description>
    <designationCategory>WNG_Architect</designationCategory><uiOrder>2202</uiOrder>
    <graphicData><graphicClass>Graphic_Multi</graphicClass><texPath>Things/Building/Precursor/Gravship/WNG_PrecursorVectorThruster</texPath><drawSize>(1.1,2.2)</drawSize></graphicData>
    <statBases><MaxHitPoints>500</MaxHitPoints><Flammability>0</Flammability><Beauty>7</Beauty><WorkToBuild>12500</WorkToBuild><Mass>14</Mass></statBases>
    <costList Inherit="False"><Plasteel>100</Plasteel><GravlitePanel>28</GravlitePanel><ComponentSpacer>2</ComponentSpacer></costList>
    <researchPrerequisites Inherit="False"><li>WNG_SkimmerSystems</li><li>BasicGravtech</li></researchPrerequisites>
    <placeWorkers Inherit="False"><li>PlaceWorker_GravshipThruster</li><li>WraithNaniteGravtech.PlaceWorker_RequireAsuranGravshipSubstructure</li></placeWorkers>
  </ThingDef>

  <ThingDef ParentName="GravshipShieldGenerator">
    <defName>WNG_PrecursorShieldEmitter</defName>
    <label>Asuran gravship shield emitter</label>
    <description>A precision Asuran emitter performing the native Odyssey gravship-shield role. It retains the vanilla charge, activation, EMP and projectile-interception behavior while using Asuran construction and art.</description>
    <designationCategory>WNG_Architect</designationCategory><uiOrder>2452</uiOrder>
    <graphicData><graphicClass>Graphic_Single</graphicClass><texPath>Things/Building/Precursor/Gravship/WNG_PrecursorShieldEmitter</texPath><drawSize>(3,3)</drawSize></graphicData>
    <statBases><MaxHitPoints>430</MaxHitPoints><Flammability>0</Flammability><Mass>62</Mass><Beauty>8</Beauty></statBases>
    <costList Inherit="False"><Plasteel>240</Plasteel><GravlitePanel>100</GravlitePanel><ComponentSpacer>8</ComponentSpacer></costList>
    <researchPrerequisites Inherit="False"><li>WNG_PrecursorShields</li><li>AdvancedGravtech</li></researchPrerequisites>
    <placeWorkers Inherit="False"><li>WraithNaniteGravtech.PlaceWorker_RequireAsuranGravshipSubstructure</li></placeWorkers>
    <comps>
      <li Class="WraithNaniteGravtech.CompProperties_ReplicatorShieldEngagementMonitor"><radius>27.9</radius><sampleIntervalTicks>300</sampleIntervalTicks></li>
    </comps>
  </ThingDef>
</Defs>
