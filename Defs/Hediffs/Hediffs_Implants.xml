<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <HediffDef><defName>WNG_PredatorReflexOrgan</defName><hediffClass>HediffWithComps</hediffClass><label>predator reflex organ</label><labelNoun>predator reflex organ</labelNoun><description>A grown Wraith reflex symbiote integrated with the host's motor pathways.</description><isBad>false</isBad><spawnThingOnRemoved>WNG_PredatorReflexOrgan</spawnThingOnRemoved><stages><li><statOffsets><MeleeHitChance>0.08</MeleeHitChance><MeleeDodgeChance>0.06</MeleeDodgeChance></statOffsets><capMods><li><capacity>Consciousness</capacity><offset>0.03</offset></li></capMods></li></stages></HediffDef>

  <HediffDef><defName>WNG_MyomerReinforcementGland</defName><hediffClass>HediffWithComps</hediffClass><label>myomer reinforcement gland</label><labelNoun>myomer reinforcement gland</labelNoun><description>Wraith-grown contractile reinforcement spread through the host's major muscle groups.</description><isBad>false</isBad><spawnThingOnRemoved>WNG_MyomerReinforcementGland</spawnThingOnRemoved><stages><li><statOffsets><CarryingCapacity>12</CarryingCapacity></statOffsets><statFactors><MeleeWeapon_DamageMultiplier>1.12</MeleeWeapon_DamageMultiplier></statFactors><capMods><li><capacity>Manipulation</capacity><offset>0.08</offset></li><li><capacity>Moving</capacity><offset>0.04</offset></li></capMods></li></stages></HediffDef>

  <HediffDef><defName>WNG_RegenerativeVesicle</defName><hediffClass>HediffWithComps</hediffClass><label>regenerative vesicle</label><labelNoun>regenerative vesicle</labelNoun><description>A Wraith-grown repair reservoir that slowly closes ordinary injuries without reconstructing missing anatomy.</description><isBad>false</isBad><spawnThingOnRemoved>WNG_RegenerativeVesicle</spawnThingOnRemoved><stages><li><capMods><li><capacity>BloodFiltration</capacity><offset>0.05</offset></li></capMods></li></stages><comps><li Class="WraithNaniteGravtech.HediffCompProperties_ImplantRegeneration"><intervalTicks>2400</intervalTicks><healAmount>0.55</healAmount><pauseDuringNaniteEMP>false</pauseDuringNaniteEMP></li></comps></HediffDef>

  <HediffDef><defName>WNG_MetabolicReserveNode</defName><hediffClass>HediffWithComps</hediffClass><label>metabolic reserve node</label><labelNoun>metabolic reserve node</labelNoun><description>A living reserve organ that reduces ordinary food and rest pressure without eliminating either need.</description><isBad>false</isBad><spawnThingOnRemoved>WNG_MetabolicReserveNode</spawnThingOnRemoved><stages><li><statFactors><HungerRateMultiplier>0.72</HungerRateMultiplier><RestFallRateFactor>0.78</RestFallRateFactor><RestRateMultiplier>1.10</RestRateMultiplier></statFactors></li></stages></HediffDef>

  <HediffDef><defName>WNG_SensoryCrownOrgan</defName><hediffClass>HediffWithComps</hediffClass><label>sensory crown organ</label><labelNoun>sensory crown organ</labelNoun><description>A cultured neural fan that improves sensory integration and subtle psychic perception.</description><isBad>false</isBad><spawnThingOnRemoved>WNG_SensoryCrownOrgan</spawnThingOnRemoved><stages><li><statOffsets><ShootingAccuracyPawn>0.4</ShootingAccuracyPawn><PsychicSensitivity>0.12</PsychicSensitivity></statOffsets><capMods><li><capacity>Sight</capacity><offset>0.08</offset></li><li><capacity>Hearing</capacity><offset>0.08</offset></li></capMods></li></stages></HediffDef>

  <HediffDef><defName>WNG_VitalFeedbackOrgan</defName><hediffClass>HediffWithComps</hediffClass><label>vital feedback organ</label><labelNoun>vital feedback organ</labelNoun><description>A permanent anti-feeding symbiote that collapses Wraith life-force transfer and drives damaging feedback into the feeding Wraith. The bearer still suffers a smaller shock.</description><isBad>false</isBad><spawnThingOnRemoved>WNG_VitalFeedbackOrgan</spawnThingOnRemoved></HediffDef>

  <HediffDef><defName>WNG_NaniteMotorLattice</defName><hediffClass>HediffWithComps</hediffClass><label>nanite motor lattice</label><labelNoun>nanite motor lattice</labelNoun><description>An Asuran motor-control mesh that improves movement, manipulation and weapon response.</description><isBad>false</isBad><spawnThingOnRemoved>WNG_NaniteMotorLattice</spawnThingOnRemoved><stages><li><statFactors><AimingDelayFactor>0.90</AimingDelayFactor></statFactors><capMods><li><capacity>Manipulation</capacity><offset>0.10</offset></li><li><capacity>Moving</capacity><offset>0.06</offset></li></capMods></li></stages></HediffDef>

  <HediffDef><defName>WNG_AutonomicEfficiencyLattice</defName><hediffClass>HediffWithComps</hediffClass><label>autonomic efficiency lattice</label><labelNoun>autonomic efficiency lattice</labelNoun><description>A distributed Asuran controller that reduces metabolic waste and makes restorative rest more efficient without removing biological needs.</description><isBad>false</isBad><spawnThingOnRemoved>WNG_AutonomicEfficiencyLattice</spawnThingOnRemoved><stages><li><statFactors><HungerRateMultiplier>0.80</HungerRateMultiplier><RestFallRateFactor>0.80</RestFallRateFactor><RestRateMultiplier>1.15</RestRateMultiplier></statFactors></li></stages></HediffDef>

  <HediffDef><defName>WNG_AdaptiveSensorMesh</defName><hediffClass>HediffWithComps</hediffClass><label>adaptive sensor mesh</label><labelNoun>adaptive sensor mesh</labelNoun><description>A precursor sensor mesh that correlates visual, auditory and weapon-alignment data.</description><isBad>false</isBad><spawnThingOnRemoved>WNG_AdaptiveSensorMesh</spawnThingOnRemoved><stages><li><statOffsets><ShootingAccuracyPawn>0.6</ShootingAccuracyPawn></statOffsets><statFactors><AimingDelayFactor>0.94</AimingDelayFactor></statFactors><capMods><li><capacity>Sight</capacity><offset>0.10</offset></li><li><capacity>Hearing</capacity><offset>0.10</offset></li></capMods></li></stages></HediffDef>

  <HediffDef><defName>WNG_ReconstructionMicroforge</defName><hediffClass>HediffWithComps</hediffClass><label>reconstruction microforge</label><labelNoun>reconstruction microforge</labelNoun><description>A miniature nanite maintenance forge that slowly repairs existing injuries but cannot replace missing anatomy or reconstruct a dead person.</description><isBad>false</isBad><spawnThingOnRemoved>WNG_ReconstructionMicroforge</spawnThingOnRemoved><comps><li Class="WraithNaniteGravtech.HediffCompProperties_ImplantRegeneration"><intervalTicks>1800</intervalTicks><healAmount>0.45</healAmount><pauseDuringNaniteEMP>true</pauseDuringNaniteEMP></li></comps></HediffDef>

  <HediffDef><defName>WNG_EMPShuntLattice</defName><hediffClass>HediffWithComps</hediffClass><label>EMP shunt lattice</label><labelNoun>EMP shunt lattice</labelNoun><description>A hardened distribution lattice that reduces the duration of human-form nanite coordination collapse after EMP exposure. It does not provide EMP immunity.</description><isBad>false</isBad><spawnThingOnRemoved>WNG_EMPShuntLattice</spawnThingOnRemoved></HediffDef>

  <HediffDef><defName>WNG_SovereignNeuralLattice</defName><hediffClass>HediffWithComps</hediffClass><label>sovereign neural lattice</label><labelNoun>sovereign neural lattice</labelNoun><description>A cross-technology command lattice that permits Ancient control-chair compatibility and one-target Replicator sovereign directives without conferring Queen identity or passive swarm coordination.</description><isBad>false</isBad><spawnThingOnRemoved>WNG_SovereignNeuralLattice</spawnThingOnRemoved><comps><li Class="HediffCompProperties_GiveAbility"><abilityDef>WNG_SovereignLatticeDirective</abilityDef></li></comps></HediffDef>

  <HediffDef><defName>WNG_VitalFeedbackBacklash</defName><hediffClass>HediffWithComps</hediffClass><label>vital feedback backlash</label><description>Severe neurological and metabolic disruption caused when a Vital Feedback Organ collapses a Wraith feeding channel back into the predator.</description><isBad>true</isBad><stages><li><capMods><li><capacity>Consciousness</capacity><offset>-0.12</offset></li><li><capacity>Moving</capacity><offset>-0.10</offset></li></capMods></li></stages><comps><li Class="HediffCompProperties_Disappears"><disappearsAfterTicks>18000</disappearsAfterTicks></li></comps></HediffDef>
  <HediffDef><defName>WNG_VitalFeedbackShock</defName><hediffClass>HediffWithComps</hediffClass><label>vital feedback shock</label><description>Short-lived autonomic shock caused by the implanted body's defensive rejection of an attempted Wraith feeding link.</description><isBad>true</isBad><stages><li><capMods><li><capacity>Consciousness</capacity><offset>-0.05</offset></li></capMods></li></stages><comps><li Class="HediffCompProperties_Disappears"><disappearsAfterTicks>9000</disappearsAfterTicks></li></comps></HediffDef>
</Defs>
