<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <HediffDef>
    <defName>WNG_NaniteEMPReceiver</defName>
    <label>nanite EMP receiver</label>
    <description>Internal nanite control substrate used to detect electromagnetic disruption.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <scenarioCanAdd>false</scenarioCanAdd>
    <everCurableByItem>false</everCurableByItem>
    <comps>
      <li Class="WraithNaniteGravtech.HediffCompProperties_NaniteEMPReceiver" />
    </comps>
  </HediffDef>

  <HediffDef>
    <defName>WNG_NaniteEMPDisruption</defName>
    <label>nanite EMP disruption</label>
    <description>Electromagnetic interference has broken coordination between the body's nanite systems. Movement and work are impaired and nanite reconstruction is suspended until the swarm resynchronizes.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>true</isBad>
    <scenarioCanAdd>false</scenarioCanAdd>
    <stages>
      <li>
        <statFactors>
          <MoveSpeed>0.55</MoveSpeed>
          <GlobalWorkSpeed>0.50</GlobalWorkSpeed>
          <MedicalTendSpeed>0.65</MedicalTendSpeed>
        </statFactors>
      </li>
    </stages>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>2400~4200</disappearsAfterTicks>
      </li>
    </comps>
  </HediffDef>
</Defs>
