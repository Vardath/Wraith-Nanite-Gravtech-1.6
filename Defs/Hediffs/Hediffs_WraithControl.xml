<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <HediffDef>
    <defName>WNG_Withered</defName>
    <label>withered</label>
    <description>Vital systems have been forcibly destabilised, producing severe weakness and age-like systemic decline.</description>
    <isBad>true</isBad>
    <duplicationAllowed>false</duplicationAllowed>
    <maxSeverity>1</maxSeverity>
    <stages>
      <li>
        <minSeverity>0</minSeverity>
        <capMods>
          <li><capacity>Moving</capacity><offset>-0.10</offset></li>
          <li><capacity>Manipulation</capacity><offset>-0.10</offset></li>
          <li><capacity>Consciousness</capacity><offset>-0.05</offset></li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.4</minSeverity>
        <capMods>
          <li><capacity>Moving</capacity><offset>-0.30</offset></li>
          <li><capacity>Manipulation</capacity><offset>-0.25</offset></li>
          <li><capacity>Consciousness</capacity><offset>-0.15</offset></li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.8</minSeverity>
        <capMods>
          <li><capacity>Moving</capacity><setMax>0.25</setMax></li>
          <li><capacity>Manipulation</capacity><setMax>0.30</setMax></li>
          <li><capacity>Consciousness</capacity><setMax>0.35</setMax></li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>WNG_Enthralled</defName>
    <label>enthralled</label>
    <description>A deep neuropsychic compulsion suppresses independent resistance and makes the target unusually compliant. This effect deliberately does not change faction ownership.</description>
    <isBad>true</isBad>
    <duplicationAllowed>false</duplicationAllowed>
    <maxSeverity>1</maxSeverity>
    <stages>
      <li>
        <statOffsets>
          <MentalBreakThreshold>-0.20</MentalBreakThreshold>
          <PsychicSensitivity>0.25</PsychicSensitivity>
        </statOffsets>
        <capMods>
          <li><capacity>Consciousness</capacity><offset>-0.05</offset></li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>WNG_WraithSleeperDirective</defName>
    <label>latent wraith directive</label>
    <description>A hidden companion state used to execute dormant Wraith commands in a recovered enthralled colonist. It is reconciled from the visible Enthralled condition and removed automatically if that condition is cured or the pawn becomes an intentional slave.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>true</isBad>
    <duplicationAllowed>false</duplicationAllowed>
    <comps>
      <li Class="WraithNaniteGravtech.HediffCompProperties_WraithSleeperSabotage">
        <sabotageIntervalTicks>180000~360000</sabotageIntervalTicks>
        <sabotageChance>0.55</sabotageChance>
        <intelligenceIntervalTicks>300000~600000</intelligenceIntervalTicks>
        <intelligenceLeakChance>0.30</intelligenceLeakChance>
        <noTargetRetryTicks>60000</noTargetRetryTicks>
      </li>
    </comps>
  </HediffDef>
</Defs>
