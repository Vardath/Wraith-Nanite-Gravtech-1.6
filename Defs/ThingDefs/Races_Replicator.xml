<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef Name="WNG_ReplicatorRaceBase" ParentName="LightMechanoid" Abstract="True">
    <description>A modular autonomous machine assembled from self-replicating blocks.</description>
    <race><body>Mech_Light</body><intelligence>ToolUser</intelligence><mechWeightClass>Light</mechWeightClass><hasCorpse>false</hasCorpse><hasMeat>false</hasMeat></race>
    <comps><li Class="WraithNaniteGravtech.CompProperties_ReplicatorState" /></comps>
  </ThingDef>
  <ThingDef ParentName="WNG_ReplicatorRaceBase"><defName>WNG_ReplicatorDrone</defName><label>replicator</label><description>The irreducible base block Replicator. Two compatible units can reorganize into a Hunter.</description><statBases><MarketValue>520</MarketValue><MoveSpeed>4.1</MoveSpeed><ArmorRating_Blunt>0.12</ArmorRating_Blunt><ArmorRating_Sharp>0.24</ArmorRating_Sharp><ArmorRating_Heat>0.18</ArmorRating_Heat></statBases><race><baseBodySize>0.55</baseBodySize></race><tools Inherit="False"><li><label>cutting limbs</label><capacities><li>Cut</li><li>Blunt</li></capacities><power>7.5</power><cooldownTime>1.7</cooldownTime></li></tools><comps><li Class="WraithNaniteGravtech.CompProperties_ReplicatorHierarchy"><upgradePawnKind>WNG_ReplicatorHunter</upgradePawnKind><unitsRequired>2</unitsRequired><assemblyRadius>7</assemblyRadius><assemblyCheckTicks>2500</assemblyCheckTicks></li></comps></ThingDef>
  <ThingDef ParentName="WNG_ReplicatorRaceBase"><defName>WNG_ReplicatorHunter</defName><label>replicator hunter</label><description>A fast pursuit form. Two compatible Hunters can reorganize into a Bulwark; genuine destruction releases two base Replicators.</description><statBases><MarketValue>1450</MarketValue><MoveSpeed>5.4</MoveSpeed><ArmorRating_Blunt>0.18</ArmorRating_Blunt><ArmorRating_Sharp>0.30</ArmorRating_Sharp><ArmorRating_Heat>0.20</ArmorRating_Heat></statBases><race><baseBodySize>0.85</baseBodySize></race><tools Inherit="False"><li><label>scything limbs</label><capacities><li>Cut</li></capacities><power>13</power><cooldownTime>1.35</cooldownTime></li></tools><comps><li Class="WraithNaniteGravtech.CompProperties_ReplicatorHierarchy"><upgradePawnKind>WNG_ReplicatorBulwark</upgradePawnKind><unitsRequired>2</unitsRequired><assemblyRadius>8</assemblyRadius><assemblyCheckTicks>2500</assemblyCheckTicks><splitChildPawnKind>WNG_ReplicatorDrone</splitChildPawnKind><splitCount>2</splitCount><splitRecombineDelayTicks>2500</splitRecombineDelayTicks></li></comps></ThingDef>
  <ThingDef ParentName="WNG_ReplicatorRaceBase"><defName>WNG_ReplicatorBulwark</defName><label>replicator bulwark</label><description>A dense heavy block form. Two compatible Bulwarks can reorganize into a Titan; genuine destruction releases two Hunters.</description><statBases><MarketValue>3900</MarketValue><MoveSpeed>3.25</MoveSpeed><ArmorRating_Blunt>0.38</ArmorRating_Blunt><ArmorRating_Sharp>0.52</ArmorRating_Sharp><ArmorRating_Heat>0.34</ArmorRating_Heat></statBases><race><baseBodySize>1.45</baseBodySize><mechWeightClass>Medium</mechWeightClass></race><tools Inherit="False"><li><label>armored crusher</label><capacities><li>Blunt</li><li>Cut</li></capacities><power>22</power><cooldownTime>2.1</cooldownTime></li></tools><comps><li Class="WraithNaniteGravtech.CompProperties_ReplicatorHierarchy"><upgradePawnKind>WNG_ReplicatorTitan</upgradePawnKind><unitsRequired>2</unitsRequired><assemblyRadius>9</assemblyRadius><assemblyCheckTicks>2500</assemblyCheckTicks><splitChildPawnKind>WNG_ReplicatorHunter</splitChildPawnKind><splitCount>2</splitCount><splitRecombineDelayTicks>2500</splitRecombineDelayTicks></li></comps></ThingDef>
  <ThingDef ParentName="WNG_ReplicatorRaceBase"><defName>WNG_ReplicatorTitan</defName><label>replicator titan</label><description>A massive block construct. Two compatible Titans can reorganize into a Siege Mass; genuine destruction releases two Bulwarks.</description><statBases><MarketValue>9000</MarketValue><MoveSpeed>2.65</MoveSpeed><ArmorRating_Blunt>0.52</ArmorRating_Blunt><ArmorRating_Sharp>0.66</ArmorRating_Sharp><ArmorRating_Heat>0.42</ArmorRating_Heat></statBases><race><baseBodySize>2.4</baseBodySize><mechWeightClass>Heavy</mechWeightClass></race><tools Inherit="False"><li><label>siege mandibles</label><capacities><li>Blunt</li><li>Cut</li></capacities><power>34</power><cooldownTime>2.7</cooldownTime></li></tools><comps><li Class="WraithNaniteGravtech.CompProperties_ReplicatorHierarchy"><upgradePawnKind>WNG_ReplicatorSiegeMass</upgradePawnKind><unitsRequired>2</unitsRequired><assemblyRadius>10</assemblyRadius><assemblyCheckTicks>2500</assemblyCheckTicks><splitChildPawnKind>WNG_ReplicatorBulwark</splitChildPawnKind><splitCount>2</splitCount><splitRecombineDelayTicks>2500</splitRecombineDelayTicks></li></comps></ThingDef>
  <ThingDef ParentName="WNG_ReplicatorRaceBase"><defName>WNG_ReplicatorSiegeMass</defName><label>replicator siege mass</label><description>The largest ordinary concentration in the block hierarchy. Genuine destruction releases two operational Titans instead of making the constituent swarm disappear.</description><statBases><MarketValue>19000</MarketValue><MoveSpeed>1.85</MoveSpeed><ArmorRating_Blunt>0.58</ArmorRating_Blunt><ArmorRating_Sharp>0.72</ArmorRating_Sharp><ArmorRating_Heat>0.48</ArmorRating_Heat></statBases><race><baseBodySize>3.8</baseBodySize><mechWeightClass>Heavy</mechWeightClass></race><tools Inherit="False"><li><label>devouring ram</label><capacities><li>Blunt</li><li>Cut</li></capacities><power>48</power><cooldownTime>3.2</cooldownTime></li></tools><comps><li Class="WraithNaniteGravtech.CompProperties_ReplicatorHierarchy"><splitChildPawnKind>WNG_ReplicatorTitan</splitChildPawnKind><splitCount>2</splitCount><splitRecombineDelayTicks>2500</splitRecombineDelayTicks></li></comps></ThingDef>
  <PawnKindDef Name="WNG_ReplicatorKindBase" ParentName="LightMechanoidKind" Abstract="True"><weaponTags Inherit="False" /></PawnKindDef>
  <PawnKindDef ParentName="WNG_ReplicatorKindBase"><defName>WNG_ReplicatorDrone</defName><label>replicator</label><race>WNG_ReplicatorDrone</race><combatPower>38</combatPower><lifeStages><li><bodyGraphicData><texPath>Things/Pawn/Replicator/WNG_ReplicatorDrone</texPath><shaderType>Cutout</shaderType><graphicClass>Graphic_Multi</graphicClass><drawSize>0.9</drawSize></bodyGraphicData></li></lifeStages></PawnKindDef>
  <PawnKindDef ParentName="WNG_ReplicatorKindBase"><defName>WNG_ReplicatorHunter</defName><label>replicator hunter</label><race>WNG_ReplicatorHunter</race><combatPower>95</combatPower><lifeStages><li><bodyGraphicData><texPath>Things/Pawn/Replicator/WNG_ReplicatorHunter</texPath><shaderType>Cutout</shaderType><graphicClass>Graphic_Multi</graphicClass><drawSize>1.25</drawSize></bodyGraphicData></li></lifeStages></PawnKindDef>
  <PawnKindDef ParentName="WNG_ReplicatorKindBase"><defName>WNG_ReplicatorBulwark</defName><label>replicator bulwark</label><race>WNG_ReplicatorBulwark</race><combatPower>230</combatPower><lifeStages><li><bodyGraphicData><texPath>Things/Pawn/Replicator/WNG_ReplicatorBulwark</texPath><shaderType>Cutout</shaderType><graphicClass>Graphic_Multi</graphicClass><drawSize>1.8</drawSize></bodyGraphicData></li></lifeStages></PawnKindDef>
  <PawnKindDef ParentName="WNG_ReplicatorKindBase"><defName>WNG_ReplicatorTitan</defName><label>replicator titan</label><race>WNG_ReplicatorTitan</race><combatPower>520</combatPower><lifeStages><li><bodyGraphicData><texPath>Things/Pawn/Replicator/WNG_ReplicatorTitan</texPath><shaderType>Cutout</shaderType><graphicClass>Graphic_Multi</graphicClass><drawSize>2.6</drawSize></bodyGraphicData></li></lifeStages></PawnKindDef>
  <PawnKindDef ParentName="WNG_ReplicatorKindBase"><defName>WNG_ReplicatorSiegeMass</defName><label>replicator siege mass</label><race>WNG_ReplicatorSiegeMass</race><combatPower>980</combatPower><lifeStages><li><bodyGraphicData><texPath>Things/Pawn/Replicator/WNG_ReplicatorSiegeMass</texPath><shaderType>Cutout</shaderType><graphicClass>Graphic_Multi</graphicClass><drawSize>3.5</drawSize></bodyGraphicData></li></lifeStages></PawnKindDef>
</Defs>
