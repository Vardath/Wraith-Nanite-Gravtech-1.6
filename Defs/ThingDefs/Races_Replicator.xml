<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef Name="WNG_ReplicatorRaceBase" ParentName="LightMechanoid" Abstract="True">
    <description>A modular autonomous machine built from self-replicating blocks.</description>
    <race><body>Mech_Light</body><intelligence>ToolUser</intelligence><thinkTreeMain>WNG_Replicator</thinkTreeMain><mechWeightClass>Light</mechWeightClass><hasCorpse>false</hasCorpse><hasMeat>false</hasMeat></race>
    <comps>
      <li Class="WraithNaniteGravtech.CompProperties_ReplicatorState"><antiShieldEvidenceRequired>3</antiShieldEvidenceRequired></li>
      <li Class="WraithNaniteGravtech.CompProperties_ReplicatorSovereignty"><validationIntervalTicks>60</validationIntervalTicks></li>
      <li Class="WraithNaniteGravtech.CompProperties_ReplicatorAdaptationEffects"><armorDamageMultiplier>0.80</armorDamageMultiplier><shieldCapacity>40</shieldCapacity><shieldRechargePerTick>0.02</shieldRechargePerTick><powerHealingMultiplier>1.5</powerHealingMultiplier><rangedRange>18</rangedRange><rangedCooldownTicks>240</rangedCooldownTicks><rangedDamage>7</rangedDamage><rangedArmorPenetration>0.15</rangedArmorPenetration><antiShieldDamageMultiplier>1.5</antiShieldDamageMultiplier><overlayScalePerBodySize>1.05</overlayScalePerBodySize></li>
      <li Class="WraithNaniteGravtech.CompProperties_ReplicatorEMP"><suppressionTicks>1800</suppressionTicks></li>
      <li Class="WraithNaniteGravtech.CompProperties_ReplicatorRegeneration"><intervalTicks>600</intervalTicks><healAmount>0.20</healAmount></li>
      <li Class="WraithNaniteGravtech.CompProperties_ReplicatorAssimilation"><searchRadius>45</searchRadius><searchIntervalTicks>600</searchIntervalTicks><workTicks>300</workTicks><itemUnitsPerBite>10</itemUnitsPerBite><matterPerMarketValue>0.02</matterPerMarketValue><matterPerBuildingHitPoint>0.025</matterPerBuildingHitPoint><minimumMatterYield>1</minimumMatterYield><offspringMatterCost>10</offspringMatterCost><maxOffspringPerAssimilation>2</maxOffspringPerAssimilation><maxHostileReplicatorsPerMap>120</maxHostileReplicatorsPerMap><offspringPawnKind>WNG_ReplicatorDrone</offspringPawnKind></li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="WNG_ReplicatorRaceBase"><defName>WNG_ReplicatorDrone</defName><label>replicator</label><description>The irreducible base Replicator. Nearby base units can reorganize upward into a Hunter.</description><statBases><MarketValue>520</MarketValue><MoveSpeed>4.1</MoveSpeed></statBases><race><baseBodySize>0.55</baseBodySize></race><tools Inherit="False"><li><label>cutting limbs</label><capacities><li>Cut</li><li>Blunt</li></capacities><power>7.5</power><cooldownTime>1.7</cooldownTime></li></tools><comps><li Class="WraithNaniteGravtech.CompProperties_ReplicatorHierarchy"><upgradePawnKind>WNG_ReplicatorHunter</upgradePawnKind><unitsRequired>3</unitsRequired><assemblyRadius>7</assemblyRadius><assemblyCheckTicks>3000</assemblyCheckTicks></li><li Class="WraithNaniteGravtech.CompProperties_ReplicatorSalvage"><minMatter>2</minMatter><maxMatter>4</maxMatter><fragmentDefName>WNG_ReplicatorCoreFragment</fragmentDefName><fragmentChance>0.04</fragmentChance></li></comps></ThingDef>

  <ThingDef ParentName="WNG_ReplicatorRaceBase"><defName>WNG_ReplicatorHunter</defName><label>replicator hunter</label><description>A fast pursuit form assembled from base Replicators. Hunters can reorganize upward into Bulwarks; a genuinely destroyed Hunter breaks back down into base Replicators.</description><statBases><MarketValue>1450</MarketValue><MoveSpeed>5.4</MoveSpeed></statBases><race><baseBodySize>0.85</baseBodySize></race><tools Inherit="False"><li><label>scything limbs</label><capacities><li>Cut</li></capacities><power>13</power><cooldownTime>1.35</cooldownTime></li></tools><comps><li Class="WraithNaniteGravtech.CompProperties_ReplicatorHierarchy"><upgradePawnKind>WNG_ReplicatorBulwark</upgradePawnKind><unitsRequired>3</unitsRequired><assemblyRadius>8</assemblyRadius><assemblyCheckTicks>3600</assemblyCheckTicks><splitChildPawnKind>WNG_ReplicatorDrone</splitChildPawnKind><splitCount>2</splitCount><splitRecombineDelayTicks>2500</splitRecombineDelayTicks></li><li Class="WraithNaniteGravtech.CompProperties_ReplicatorSalvage"><minMatter>4</minMatter><maxMatter>7</maxMatter><fragmentDefName>WNG_ReplicatorCoreFragment</fragmentDefName><fragmentChance>0.08</fragmentChance></li></comps></ThingDef>

  <ThingDef ParentName="WNG_ReplicatorRaceBase"><defName>WNG_ReplicatorBulwark</defName><label>replicator bulwark</label><description>A dense heavy Replicator body. Bulwarks can reorganize upward into Titans; a genuinely destroyed Bulwark breaks back down into Hunters.</description><statBases><MarketValue>3900</MarketValue><MoveSpeed>3.25</MoveSpeed></statBases><race><baseBodySize>1.45</baseBodySize><mechWeightClass>Medium</mechWeightClass></race><tools Inherit="False"><li><label>armored crusher</label><capacities><li>Blunt</li><li>Cut</li></capacities><power>22</power><cooldownTime>2.1</cooldownTime></li></tools><comps><li Class="WraithNaniteGravtech.CompProperties_ReplicatorHierarchy"><upgradePawnKind>WNG_ReplicatorTitan</upgradePawnKind><unitsRequired>2</unitsRequired><assemblyRadius>9</assemblyRadius><assemblyCheckTicks>4500</assemblyCheckTicks><splitChildPawnKind>WNG_ReplicatorHunter</splitChildPawnKind><splitCount>2</splitCount><splitRecombineDelayTicks>2500</splitRecombineDelayTicks></li><li Class="WraithNaniteGravtech.CompProperties_ReplicatorSalvage"><minMatter>8</minMatter><maxMatter>13</maxMatter><fragmentDefName>WNG_ReplicatorCoreFragment</fragmentDefName><fragmentChance>0.14</fragmentChance></li></comps></ThingDef>

  <ThingDef ParentName="WNG_ReplicatorRaceBase"><defName>WNG_ReplicatorTitan</defName><label>replicator titan</label><description>A massive mobile Replicator construct. Titans can reorganize upward into a Siege Mass; a genuinely destroyed Titan breaks back down into Bulwarks, which remain unable to recombine for the configured post-breakup interval.</description><statBases><MarketValue>9000</MarketValue><MoveSpeed>2.65</MoveSpeed></statBases><race><baseBodySize>2.4</baseBodySize><mechWeightClass>Heavy</mechWeightClass></race><tools Inherit="False"><li><label>siege mandibles</label><capacities><li>Blunt</li><li>Cut</li></capacities><power>34</power><cooldownTime>2.7</cooldownTime></li></tools><comps><li Class="WraithNaniteGravtech.CompProperties_ReplicatorHierarchy"><upgradePawnKind>WNG_ReplicatorSiegeMass</upgradePawnKind><unitsRequired>2</unitsRequired><assemblyRadius>10</assemblyRadius><assemblyCheckTicks>5000</assemblyCheckTicks><splitChildPawnKind>WNG_ReplicatorBulwark</splitChildPawnKind><splitCount>2</splitCount><splitRecombineDelayTicks>2500</splitRecombineDelayTicks></li><li Class="WraithNaniteGravtech.CompProperties_ReplicatorRegeneration"><intervalTicks>500</intervalTicks><healAmount>0.30</healAmount></li><li Class="WraithNaniteGravtech.CompProperties_ReplicatorSalvage"><minMatter>18</minMatter><maxMatter>28</maxMatter><fragmentDefName>WNG_ReplicatorCoreFragment</fragmentDefName><fragmentChance>0.25</fragmentChance></li></comps></ThingDef>

  <ThingDef ParentName="WNG_ReplicatorRaceBase"><defName>WNG_ReplicatorController</defName><label>replicator controller</label><description>A coordination-focused mature swarm body. Nearby same-domain Replicators use its target focus while retaining their own specialist roles.</description><statBases><MarketValue>3100</MarketValue><MoveSpeed>3.75</MoveSpeed></statBases><race><baseBodySize>1.2</baseBodySize><mechWeightClass>Medium</mechWeightClass></race><tools Inherit="False"><li><label>coordination limbs</label><capacities><li>Blunt</li><li>Cut</li></capacities><power>12</power><cooldownTime>1.9</cooldownTime></li></tools><modExtensions><li Class="WraithNaniteGravtech.ReplicatorSpecialistExtension"><controllerRadius>30</controllerRadius></li></modExtensions><comps><li Class="WraithNaniteGravtech.CompProperties_ReplicatorSalvage"><minMatter>7</minMatter><maxMatter>11</maxMatter><fragmentDefName>WNG_ReplicatorCoreFragment</fragmentDefName><fragmentChance>0.18</fragmentChance></li></comps></ThingDef>

  <PawnKindDef Name="WNG_ReplicatorKindBase" ParentName="LightMechanoidKind" Abstract="True"><weaponTags Inherit="False" /></PawnKindDef>
  <PawnKindDef ParentName="WNG_ReplicatorKindBase"><defName>WNG_ReplicatorDrone</defName><label>replicator</label><race>WNG_ReplicatorDrone</race><combatPower>38</combatPower><lifeStages><li><bodyGraphicData><texPath>Things/Pawn/Replicator/WNG_ReplicatorDrone</texPath><shaderType>Cutout</shaderType><graphicClass>Graphic_Multi</graphicClass><drawSize>0.9</drawSize></bodyGraphicData></li></lifeStages></PawnKindDef>
  <PawnKindDef ParentName="WNG_ReplicatorKindBase"><defName>WNG_ReplicatorHunter</defName><label>replicator hunter</label><race>WNG_ReplicatorHunter</race><combatPower>95</combatPower><lifeStages><li><bodyGraphicData><texPath>Things/Pawn/Replicator/WNG_ReplicatorHunter</texPath><shaderType>Cutout</shaderType><graphicClass>Graphic_Multi</graphicClass><drawSize>1.25</drawSize></bodyGraphicData></li></lifeStages></PawnKindDef>
  <PawnKindDef ParentName="WNG_ReplicatorKindBase"><defName>WNG_ReplicatorBulwark</defName><label>replicator bulwark</label><race>WNG_ReplicatorBulwark</race><combatPower>230</combatPower><lifeStages><li><bodyGraphicData><texPath>Things/Pawn/Replicator/WNG_ReplicatorBulwark</texPath><shaderType>Cutout</shaderType><graphicClass>Graphic_Multi</graphicClass><drawSize>1.8</drawSize></bodyGraphicData></li></lifeStages></PawnKindDef>
  <PawnKindDef ParentName="WNG_ReplicatorKindBase"><defName>WNG_ReplicatorTitan</defName><label>replicator titan</label><race>WNG_ReplicatorTitan</race><combatPower>520</combatPower><lifeStages><li><bodyGraphicData><texPath>Things/Pawn/Replicator/WNG_ReplicatorTitan</texPath><shaderType>Cutout</shaderType><graphicClass>Graphic_Multi</graphicClass><drawSize>2.6</drawSize></bodyGraphicData></li></lifeStages></PawnKindDef>
  <PawnKindDef ParentName="WNG_ReplicatorKindBase"><defName>WNG_ReplicatorController</defName><label>replicator controller</label><race>WNG_ReplicatorController</race><combatPower>125</combatPower><lifeStages><li><bodyGraphicData><texPath>Things/Pawn/Replicator/WNG_ReplicatorController</texPath><shaderType>Cutout</shaderType><graphicClass>Graphic_Multi</graphicClass><drawSize>1.45</drawSize></bodyGraphicData></li></lifeStages></PawnKindDef>
</Defs>
