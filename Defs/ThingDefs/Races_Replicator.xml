<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef Name="WNG_ReplicatorRaceBase" ParentName="LightMechanoid" Abstract="True">
    <description>A modular autonomous machine assembled from self-replicating elements. Replicator forms can recombine into larger bodies and break back down into smaller operational forms when destroyed.</description>
    <race>
      <body>Mech_Light</body>
      <intelligence>ToolUser</intelligence>
      <thinkTreeMain>WNG_Replicator</thinkTreeMain>
      <mechWeightClass>Light</mechWeightClass>
      <hasCorpse>false</hasCorpse>
      <hasMeat>false</hasMeat>
      <lifeStageAges>
        <li><def>MechanoidFullyFormed</def><minAge>0</minAge></li>
        <li><def>MechanoidFullyFormed</def><minAge>100</minAge></li>
      </lifeStageAges>
    </race>
    <comps>
      <li Class="WraithNaniteGravtech.CompProperties_ReplicatorControl" />
      <li Class="WraithNaniteGravtech.CompProperties_ReplicatorMaterial" />
      <li Class="WraithNaniteGravtech.CompProperties_ReplicatorAdaptation" />
      <li Class="WraithNaniteGravtech.CompProperties_ReplicatorEMPSuppression"><suppressionTicks>1800</suppressionTicks></li>
      <li Class="WraithNaniteGravtech.CompProperties_ReplicatorLatticeOverride" />
      <li Class="WraithNaniteGravtech.CompProperties_ReplicatorRegeneration">
        <intervalTicks>600</intervalTicks>
        <healAmount>0.20</healAmount>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="WNG_ReplicatorRaceBase">
    <defName>WNG_ReplicatorDrone</defName><label>replicator</label>
    <description>The irreducible base Replicator: a small six-legged machine made from interchangeable blocks. Three nearby base units can reorganize into a hunter form.</description>
    <statBases><MarketValue>520</MarketValue><MoveSpeed>4.1</MoveSpeed><ArmorRating_Blunt>0.12</ArmorRating_Blunt><ArmorRating_Sharp>0.24</ArmorRating_Sharp><ArmorRating_Heat>0.18</ArmorRating_Heat><MechEnergyLossPerHP>0.8</MechEnergyLossPerHP></statBases>
    <race><baseBodySize>0.55</baseBodySize><hasCorpse>false</hasCorpse><hasMeat>false</hasMeat></race>
    <tools Inherit="False"><li><label>cutting limbs</label><capacities><li>Cut</li><li>Blunt</li></capacities><power>7.5</power><cooldownTime>1.7</cooldownTime></li></tools>
    <comps>
      <li Class="WraithNaniteGravtech.CompProperties_ReplicatorHierarchy"><upgradePawnKind>WNG_ReplicatorHunter</upgradePawnKind><unitsRequired>3</unitsRequired><assemblyRadius>7</assemblyRadius><assemblyIntervalTicks>3000</assemblyIntervalTicks></li>
      <li Class="WraithNaniteGravtech.CompProperties_ReplicatorSalvage"><minMatter>2</minMatter><maxMatter>4</maxMatter></li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="WNG_ReplicatorRaceBase">
    <defName>WNG_ReplicatorHunter</defName><label>replicator hunter</label>
    <description>A fast pursuit form assembled from several base Replicators. It sacrifices armor for speed and elongated cutting limbs. Three hunters can reorganize into a bulwark; destroying one releases two base Replicators.</description>
    <statBases><MarketValue>1450</MarketValue><MoveSpeed>5.4</MoveSpeed><ArmorRating_Blunt>0.18</ArmorRating_Blunt><ArmorRating_Sharp>0.30</ArmorRating_Sharp><ArmorRating_Heat>0.20</ArmorRating_Heat><MechEnergyLossPerHP>0.72</MechEnergyLossPerHP></statBases>
    <race><baseBodySize>0.85</baseBodySize></race>
    <tools Inherit="False"><li><label>scything forelimbs</label><capacities><li>Cut</li></capacities><power>13</power><cooldownTime>1.35</cooldownTime></li></tools>
    <comps>
      <li Class="WraithNaniteGravtech.CompProperties_ReplicatorHierarchy"><upgradePawnKind>WNG_ReplicatorBulwark</upgradePawnKind><unitsRequired>3</unitsRequired><assemblyRadius>8</assemblyRadius><assemblyIntervalTicks>3600</assemblyIntervalTicks><splitChildPawnKind>WNG_ReplicatorDrone</splitChildPawnKind><splitCount>2</splitCount></li>
      <li Class="WraithNaniteGravtech.CompProperties_ReplicatorSalvage"><minMatter>4</minMatter><maxMatter>7</maxMatter></li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="WNG_ReplicatorRaceBase">
    <defName>WNG_ReplicatorBulwark</defName><label>replicator bulwark</label>
    <description>A dense defensive Replicator body with broad armored flanks and reinforced crushing limbs. Two bulwarks can assemble a siege titan. Destroying one releases two hunter forms.</description>
    <statBases><MarketValue>3900</MarketValue><MoveSpeed>3.25</MoveSpeed><ArmorRating_Blunt>0.38</ArmorRating_Blunt><ArmorRating_Sharp>0.52</ArmorRating_Sharp><ArmorRating_Heat>0.34</ArmorRating_Heat><MechEnergyLossPerHP>0.55</MechEnergyLossPerHP></statBases>
    <race><baseBodySize>1.45</baseBodySize><mechWeightClass>Medium</mechWeightClass></race>
    <tools Inherit="False"><li><label>armored crusher</label><capacities><li>Blunt</li><li>Cut</li></capacities><power>22</power><cooldownTime>2.1</cooldownTime></li></tools>
    <comps>
      <li Class="WraithNaniteGravtech.CompProperties_ReplicatorHierarchy"><upgradePawnKind>WNG_ReplicatorTitan</upgradePawnKind><unitsRequired>2</unitsRequired><assemblyRadius>9</assemblyRadius><assemblyIntervalTicks>4500</assemblyIntervalTicks><splitChildPawnKind>WNG_ReplicatorHunter</splitChildPawnKind><splitCount>2</splitCount></li>
      <li Class="WraithNaniteGravtech.CompProperties_ReplicatorSalvage"><minMatter>8</minMatter><maxMatter>13</maxMatter></li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="WNG_ReplicatorRaceBase">
    <defName>WNG_ReplicatorTitan</defName><label>replicator siege titan</label>
    <description>A massive mobile Replicator construct built from many smaller machines. It is slow, heavily armored and brutally strong; when destroyed it breaks apart into multiple surviving bulwarks rather than disappearing as a single unit.</description>
    <statBases><MarketValue>9000</MarketValue><MoveSpeed>2.65</MoveSpeed><ArmorRating_Blunt>0.52</ArmorRating_Blunt><ArmorRating_Sharp>0.66</ArmorRating_Sharp><ArmorRating_Heat>0.42</ArmorRating_Heat><MechEnergyLossPerHP>0.42</MechEnergyLossPerHP></statBases>
    <race><baseBodySize>2.4</baseBodySize><mechWeightClass>Heavy</mechWeightClass></race>
    <tools Inherit="False"><li><label>siege mandibles</label><capacities><li>Blunt</li><li>Cut</li></capacities><power>34</power><cooldownTime>2.7</cooldownTime></li></tools>
    <comps>
      <li Class="WraithNaniteGravtech.CompProperties_ReplicatorHierarchy"><splitChildPawnKind>WNG_ReplicatorBulwark</splitChildPawnKind><splitCount>2</splitCount></li>
      <li Class="WraithNaniteGravtech.CompProperties_ReplicatorRegeneration"><intervalTicks>500</intervalTicks><healAmount>0.30</healAmount></li>
      <li Class="WraithNaniteGravtech.CompProperties_ReplicatorSalvage"><minMatter>18</minMatter><maxMatter>28</maxMatter></li>
    </comps>
  </ThingDef>

  <!-- Mature-swarm support body. It is deliberately outside the four-rung combat hierarchy: a controller
       emerges by reorganizing one existing Hunter/Bulwark only after the swarm has grown substantially. -->
  <ThingDef ParentName="WNG_ReplicatorRaceBase">
    <defName>WNG_ReplicatorController</defName><label>replicator controller</label>
    <description>A specialized coordination body that emerges only inside a mature Replicator swarm. Its distributed signal lattice improves the speed of nearby same-faction assimilation and recombination, but ordinary Replicators remain fully autonomous if it is destroyed.</description>
    <statBases><MarketValue>3100</MarketValue><MoveSpeed>3.75</MoveSpeed><ArmorRating_Blunt>0.27</ArmorRating_Blunt><ArmorRating_Sharp>0.40</ArmorRating_Sharp><ArmorRating_Heat>0.29</ArmorRating_Heat><MechEnergyLossPerHP>0.62</MechEnergyLossPerHP></statBases>
    <race><baseBodySize>1.20</baseBodySize><mechWeightClass>Medium</mechWeightClass></race>
    <tools Inherit="False"><li><label>coordination limbs</label><capacities><li>Blunt</li><li>Cut</li></capacities><power>12</power><cooldownTime>1.9</cooldownTime></li></tools>
    <comps>
      <li Class="WraithNaniteGravtech.CompProperties_ReplicatorController" />
      <li Class="WraithNaniteGravtech.CompProperties_ReplicatorSalvage"><minMatter>7</minMatter><maxMatter>11</maxMatter></li>
    </comps>
  </ThingDef>

  <PawnKindDef Name="WNG_ReplicatorKindBase" ParentName="LightMechanoidKind" Abstract="True"><weaponTags Inherit="False" /></PawnKindDef>
  <PawnKindDef ParentName="WNG_ReplicatorKindBase"><defName>WNG_ReplicatorDrone</defName><label>replicator</label><race>WNG_ReplicatorDrone</race><combatPower>38</combatPower><lifeStages><li><bodyGraphicData><texPath>Things/Pawn/Replicator/WNG_ReplicatorDrone</texPath><shaderType>Cutout</shaderType><graphicClass>Graphic_Multi</graphicClass><drawSize>0.9</drawSize><shadowData><volume>(0.25,0.25,0.25)</volume></shadowData></bodyGraphicData></li><li><bodyGraphicData><texPath>Things/Pawn/Replicator/WNG_ReplicatorDrone</texPath><shaderType>Cutout</shaderType><graphicClass>Graphic_Multi</graphicClass><drawSize>0.9</drawSize><shadowData><volume>(0.25,0.25,0.25)</volume></shadowData></bodyGraphicData></li></lifeStages></PawnKindDef>
  <PawnKindDef ParentName="WNG_ReplicatorKindBase"><defName>WNG_ReplicatorHunter</defName><label>replicator hunter</label><race>WNG_ReplicatorHunter</race><combatPower>95</combatPower><lifeStages><li><bodyGraphicData><texPath>Things/Pawn/Replicator/WNG_ReplicatorHunter</texPath><shaderType>Cutout</shaderType><graphicClass>Graphic_Multi</graphicClass><drawSize>1.25</drawSize></bodyGraphicData></li><li><bodyGraphicData><texPath>Things/Pawn/Replicator/WNG_ReplicatorHunter</texPath><shaderType>Cutout</shaderType><graphicClass>Graphic_Multi</graphicClass><drawSize>1.25</drawSize></bodyGraphicData></li></lifeStages></PawnKindDef>
  <PawnKindDef ParentName="WNG_ReplicatorKindBase"><defName>WNG_ReplicatorBulwark</defName><label>replicator bulwark</label><race>WNG_ReplicatorBulwark</race><combatPower>230</combatPower><lifeStages><li><bodyGraphicData><texPath>Things/Pawn/Replicator/WNG_ReplicatorBulwark</texPath><shaderType>Cutout</shaderType><graphicClass>Graphic_Multi</graphicClass><drawSize>1.8</drawSize></bodyGraphicData></li><li><bodyGraphicData><texPath>Things/Pawn/Replicator/WNG_ReplicatorBulwark</texPath><shaderType>Cutout</shaderType><graphicClass>Graphic_Multi</graphicClass><drawSize>1.8</drawSize></bodyGraphicData></li></lifeStages></PawnKindDef>
  <PawnKindDef ParentName="WNG_ReplicatorKindBase"><defName>WNG_ReplicatorTitan</defName><label>replicator siege titan</label><race>WNG_ReplicatorTitan</race><combatPower>520</combatPower><lifeStages><li><bodyGraphicData><texPath>Things/Pawn/Replicator/WNG_ReplicatorTitan</texPath><shaderType>Cutout</shaderType><graphicClass>Graphic_Multi</graphicClass><drawSize>2.6</drawSize></bodyGraphicData></li><li><bodyGraphicData><texPath>Things/Pawn/Replicator/WNG_ReplicatorTitan</texPath><shaderType>Cutout</shaderType><graphicClass>Graphic_Multi</graphicClass><drawSize>2.6</drawSize></bodyGraphicData></li></lifeStages></PawnKindDef>
  <PawnKindDef ParentName="WNG_ReplicatorKindBase"><defName>WNG_ReplicatorController</defName><label>replicator controller</label><race>WNG_ReplicatorController</race><combatPower>125</combatPower><lifeStages><li><bodyGraphicData><texPath>Things/Pawn/Replicator/WNG_ReplicatorController</texPath><shaderType>Cutout</shaderType><graphicClass>Graphic_Multi</graphicClass><drawSize>1.45</drawSize></bodyGraphicData></li><li><bodyGraphicData><texPath>Things/Pawn/Replicator/WNG_ReplicatorController</texPath><shaderType>Cutout</shaderType><graphicClass>Graphic_Multi</graphicClass><drawSize>1.45</drawSize></bodyGraphicData></li></lifeStages></PawnKindDef>
</Defs>