<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    Fresh Wraith gravship family. These are built around Odyssey's real gravship classes/comps.
    Graphics are temporary vanilla mechanics-validation art only. Final Wraith living-ship art is
    still required and must preserve directional states, links and native hull corner readability.
  -->

  <ThingDef ParentName="BuildingBase">
    <defName>WNG_WraithGravEngineSeed</defName>
    <label>Wraith grav engine growth core</label>
    <description>A cultivated Wraith propulsion core prepared to mature into a gravship heart. Once construction completes it becomes the real Odyssey grav engine, preserving native gravship discovery, substructure, launch and travel behavior while retaining WNG's Wraith technology marker.</description>
    <tickerType>Normal</tickerType>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <texPath>Things/Building/GravEngine/GravEngine</texPath>
      <drawSize>(3,3)</drawSize>
    </graphicData>
    <statBases>
      <MaxHitPoints>500</MaxHitPoints>
      <WorkToBuild>18000</WorkToBuild>
      <Flammability>0.15</Flammability>
      <Mass>30</Mass>
    </statBases>
    <size>(3,3)</size>
    <fillPercent>0.6</fillPercent>
    <passability>PassThroughOnly</passability>
    <pathCost>20</pathCost>
    <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
    <designationCategory>WNG</designationCategory>
    <researchPrerequisites>
      <li>WNG_WraithGravships</li>
    </researchPrerequisites>
    <constructionSkillPrerequisite>8</constructionSkillPrerequisite>
    <costList>
      <WNG_WraithBioSludge>80</WNG_WraithBioSludge>
      <Plasteel>160</Plasteel>
      <ComponentSpacer>8</ComponentSpacer>
    </costList>
    <placeWorkers>
      <li>WraithNaniteGravtech.PlaceWorker_WNGSingleGravEngine</li>
    </placeWorkers>
    <comps>
      <li Class="WraithNaniteGravtech.CompProperties_WNGGravEngineSeed">
        <theme>Wraith</theme>
        <engineName>Wraith living grav engine</engineName>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="BuildingBase">
    <defName>WNG_WraithLivingHullSeed</defName>
    <label>Wraith living hull</label>
    <description>A cultivated Wraith hull section. On completion it resolves into the exact native Odyssey gravship hull so airtight behavior and angled hull corners remain genuinely functional, while retaining Wraith living-ship identity for WNG systems.</description>
    <tickerType>Normal</tickerType>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <texPath>Things/Building/Linked/GravshipHull/GravshipHull_Atlas</texPath>
    </graphicData>
    <statBases>
      <MaxHitPoints>260</MaxHitPoints>
      <WorkToBuild>450</WorkToBuild>
      <Flammability>0.15</Flammability>
    </statBases>
    <fillPercent>1</fillPercent>
    <passability>Impassable</passability>
    <holdsRoof>true</holdsRoof>
    <blockLight>true</blockLight>
    <terrainAffordanceNeeded>Substructure</terrainAffordanceNeeded>
    <designationCategory>WNG</designationCategory>
    <researchPrerequisites>
      <li>WNG_WraithGravships</li>
    </researchPrerequisites>
    <costList>
      <WNG_WraithBioSludge>2</WNG_WraithBioSludge>
      <Steel>5</Steel>
    </costList>
    <comps>
      <li Class="WraithNaniteGravtech.CompProperties_WNGGravHullSeed">
        <theme>Wraith</theme>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="GravshipComponentBase">
    <defName>WNG_WraithControlInterface</defName>
    <label>Wraith gravship control interface</label>
    <description>A living neural control surface adapted to Odyssey's native gravship pilot-console system. It launches and pilots the connected gravship through the same native destination and flight workflow as a vanilla pilot console.</description>
    <graphicData>
      <graphicClass>Graphic_Multi</graphicClass>
      <texPath>Things/Building/PilotConsole/PilotConsole</texPath>
      <drawSize>(3.7, 2.6)</drawSize>
    </graphicData>
    <statBases>
      <MaxHitPoints>190</MaxHitPoints>
      <Mass>45</Mass>
      <Flammability>0.1</Flammability>
      <Beauty>2</Beauty>
      <WorkToBuild>3000</WorkToBuild>
    </statBases>
    <size>(3,2)</size>
    <rotatable>true</rotatable>
    <fillPercent>0.4</fillPercent>
    <passability>PassThroughOnly</passability>
    <pathCost>14</pathCost>
    <costList>
      <WNG_WraithBioSludge>20</WNG_WraithBioSludge>
      <Plasteel>70</Plasteel>
      <ComponentIndustrial>4</ComponentIndustrial>
    </costList>
    <resourcesFractionWhenDeconstructed>0.5</resourcesFractionWhenDeconstructed>
    <constructionSkillPrerequisite>6</constructionSkillPrerequisite>
    <designationCategory>WNG</designationCategory>
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <researchPrerequisites>
      <li>WNG_WraithGravships</li>
    </researchPrerequisites>
    <terrainAffordanceNeeded>Substructure</terrainAffordanceNeeded>
    <comps>
      <li Class="CompProperties_GravshipFacility">
        <compClass>CompPilotConsole</compClass>
        <componentTypeDef>Controls</componentTypeDef>
        <requiresLOS>false</requiresLOS>
        <showMaxSimultaneous>false</showMaxSimultaneous>
        <maxSimultaneous>1</maxSimultaneous>
        <maxDistance>200</maxDistance>
      </li>
      <li Class="WraithNaniteGravtech.CompProperties_WNGGravshipPartTheme"><theme>Wraith</theme></li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="FuelTankBase">
    <defName>WNG_WraithBioSludgeTank</defName>
    <label>Wraith bio-sludge reservoir</label>
    <description>A living reservoir that stores cultivated Wraith bio sludge as gravship propellant. It is a genuine Odyssey gravship fuel-storage facility and contributes directly to native launch range calculations.</description>
    <graphicData>
      <graphicClass>Graphic_Multi</graphicClass>
      <texPath>Things/Building/ChemfuelTank/ChemfuelTank</texPath>
      <drawSize>(2,2)</drawSize>
    </graphicData>
    <statBases>
      <MaxHitPoints>240</MaxHitPoints>
      <Mass>28</Mass>
      <Flammability>0.35</Flammability>
      <Beauty>-4</Beauty>
      <WorkToBuild>2300</WorkToBuild>
    </statBases>
    <size>(2,2)</size>
    <costList>
      <WNG_WraithBioSludge>12</WNG_WraithBioSludge>
      <Steel>85</Steel>
    </costList>
    <designationCategory>WNG</designationCategory>
    <researchPrerequisites><li>WNG_WraithGravships</li></researchPrerequisites>
    <comps>
      <li Class="CompProperties_Refuelable">
        <fuelCapacity>250</fuelCapacity>
        <targetFuelLevelConfigurable>true</targetFuelLevelConfigurable>
        <initialConfigurableTargetFuelLevel>250</initialConfigurableTargetFuelLevel>
        <fuelFilter><thingDefs><li>WNG_WraithBioSludge</li></thingDefs></fuelFilter>
        <fuelLabel>Bio sludge</fuelLabel>
        <fuelGizmoLabel>Bio sludge</fuelGizmoLabel>
        <consumeFuelOnlyWhenUsed>true</consumeFuelOnlyWhenUsed>
        <autoRefuelPercent>1</autoRefuelPercent>
        <showFuelGizmo>true</showFuelGizmo>
        <drawOutOfFuelOverlay>false</drawOutOfFuelOverlay>
        <showAllowAutoRefuelToggle>true</showAllowAutoRefuelToggle>
        <canEjectFuel>true</canEjectFuel>
        <drawFuelGaugeInMap>false</drawFuelGaugeInMap>
      </li>
      <li Class="WraithNaniteGravtech.CompProperties_WNGGravshipPartTheme"><theme>Wraith</theme></li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="FuelTankBase">
    <defName>WNG_WraithLargeBioSludgeTank</defName>
    <label>large Wraith bio-sludge reservoir</label>
    <description>A large living propellant reservoir integrated into Wraith gravship tissue. It supplies native Odyssey gravship fuel calculations without replacing the base game's flight system.</description>
    <graphicData>
      <graphicClass>Graphic_Multi</graphicClass>
      <texPath>Things/Building/LargeChemfuelTank/LargeChemfuelTank</texPath>
      <drawSize>(3,3)</drawSize>
    </graphicData>
    <statBases>
      <MaxHitPoints>360</MaxHitPoints>
      <Mass>65</Mass>
      <Flammability>0.35</Flammability>
      <Beauty>-4</Beauty>
      <WorkToBuild>3600</WorkToBuild>
    </statBases>
    <size>(3,3)</size>
    <costList>
      <WNG_WraithBioSludge>28</WNG_WraithBioSludge>
      <Steel>140</Steel>
      <Plasteel>35</Plasteel>
    </costList>
    <designationCategory>WNG</designationCategory>
    <researchPrerequisites><li>WNG_WraithGravships</li></researchPrerequisites>
    <comps>
      <li Class="CompProperties_Refuelable">
        <fuelCapacity>750</fuelCapacity>
        <targetFuelLevelConfigurable>true</targetFuelLevelConfigurable>
        <initialConfigurableTargetFuelLevel>750</initialConfigurableTargetFuelLevel>
        <fuelFilter><thingDefs><li>WNG_WraithBioSludge</li></thingDefs></fuelFilter>
        <fuelLabel>Bio sludge</fuelLabel>
        <fuelGizmoLabel>Bio sludge</fuelGizmoLabel>
        <consumeFuelOnlyWhenUsed>true</consumeFuelOnlyWhenUsed>
        <autoRefuelPercent>1</autoRefuelPercent>
        <showFuelGizmo>true</showFuelGizmo>
        <drawOutOfFuelOverlay>false</drawOutOfFuelOverlay>
        <showAllowAutoRefuelToggle>true</showAllowAutoRefuelToggle>
        <canEjectFuel>true</canEjectFuel>
        <drawFuelGaugeInMap>false</drawFuelGaugeInMap>
      </li>
      <li Class="WraithNaniteGravtech.CompProperties_WNGGravshipPartTheme"><theme>Wraith</theme></li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="ThrusterBase">
    <defName>WNG_WraithSmallThruster</defName>
    <label>Wraith small living thruster</label>
    <description>A directional living drive organ that contributes thrust through Odyssey's native gravship propulsion component.</description>
    <graphicData>
      <graphicClass>Graphic_Multi</graphicClass>
      <texPath>Things/Building/SmallThruster/SmallThruster</texPath>
      <drawSize>(1.1,2.2)</drawSize>
    </graphicData>
    <statBases>
      <MaxHitPoints>300</MaxHitPoints>
      <Flammability>0.1</Flammability>
      <Beauty>-2</Beauty>
      <WorkToBuild>9000</WorkToBuild>
      <Mass>18</Mass>
    </statBases>
    <size>(1,2)</size>
    <constructionSkillPrerequisite>6</constructionSkillPrerequisite>
    <costList>
      <WNG_WraithBioSludge>25</WNG_WraithBioSludge>
      <Plasteel>90</Plasteel>
      <ComponentIndustrial>4</ComponentIndustrial>
    </costList>
    <researchPrerequisites><li>WNG_WraithGravships</li></researchPrerequisites>
    <designationCategory>WNG</designationCategory>
    <comps>
      <li Class="CompProperties_GravshipThruster">
        <statOffsets><GravshipRange>10</GravshipRange></statOffsets>
        <componentTypeDef>Thruster</componentTypeDef>
        <exclusionAreaSize>(1,0,5)</exclusionAreaSize>
        <exclusionAreaOffset>(0,0,-5)</exclusionAreaOffset>
        <directionInfluence>20</directionInfluence>
        <flameSize>4</flameSize>
        <flameOffsetsPerDirection>
          <li>(0,0,0.5)</li><li>(0,0,0.5)</li><li>(0,0,0.5)</li><li>(0,0,0.5)</li>
        </flameOffsetsPerDirection>
        <flameShaderType>MoteGlow</flameShaderType>
        <flameShaderParameters><_MainTex>/Things/Mote/SmallThruster_Burn</_MainTex></flameShaderParameters>
        <requiresLOS>false</requiresLOS>
        <maxSimultaneous>4</maxSimultaneous>
        <maxDistance>500</maxDistance>
        <exhaustSettings>
          <exhaustFleckDef>GravshipThrusterExhaust</exhaustFleckDef>
          <emissionsPerSecond>40</emissionsPerSecond>
          <spawnRadiusRange>0~0.5</spawnRadiusRange>
          <velocity>(0,0,-20)</velocity>
          <velocityRotationRange>-10~10</velocityRotationRange>
          <velocityMultiplierRange>0.8~1.2</velocityMultiplierRange>
          <rotationOverTimeRange>-180~180</rotationOverTimeRange>
          <scaleRange>1.5~3</scaleRange>
        </exhaustSettings>
      </li>
      <li Class="WraithNaniteGravtech.CompProperties_WNGGravshipPartTheme"><theme>Wraith</theme></li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="ThrusterBase">
    <defName>WNG_WraithLargeThruster</defName>
    <label>Wraith large living thruster</label>
    <description>A large directional Wraith drive organ using Odyssey's native gravship-thruster exclusion, rotation and range behavior.</description>
    <graphicData>
      <graphicClass>Graphic_Multi</graphicClass>
      <texPath>Things/Building/LateralThruster/LateralThruster</texPath>
      <drawSize>(2.2,2.2)</drawSize>
    </graphicData>
    <statBases>
      <MaxHitPoints>560</MaxHitPoints>
      <Flammability>0.1</Flammability>
      <Beauty>-2</Beauty>
      <WorkToBuild>13500</WorkToBuild>
      <Mass>28</Mass>
    </statBases>
    <size>(2,2)</size>
    <constructionSkillPrerequisite>7</constructionSkillPrerequisite>
    <costList>
      <WNG_WraithBioSludge>45</WNG_WraithBioSludge>
      <Plasteel>150</Plasteel>
      <ComponentIndustrial>6</ComponentIndustrial>
    </costList>
    <researchPrerequisites><li>WNG_WraithGravships</li></researchPrerequisites>
    <designationCategory>WNG</designationCategory>
    <comps>
      <li Class="CompProperties_GravshipThruster">
        <statOffsets><GravshipRange>16</GravshipRange></statOffsets>
        <componentTypeDef>Thruster</componentTypeDef>
        <exclusionAreaSize>(2,0,7)</exclusionAreaSize>
        <exclusionAreaOffset>(0,0,-7)</exclusionAreaOffset>
        <directionInfluence>30</directionInfluence>
        <flameSize>4</flameSize>
        <flameOffsetsPerDirection>
          <li>(0,0,1)</li><li>(0,0,0.5)</li><li>(0,0,0.5)</li><li>(0,0,0.5)</li>
        </flameOffsetsPerDirection>
        <flameShaderType>MoteGlow</flameShaderType>
        <flameShaderParameters><_MainTex>/Things/Mote/LargeThruster_Burn</_MainTex></flameShaderParameters>
        <requiresLOS>false</requiresLOS>
        <maxSimultaneous>6</maxSimultaneous>
        <maxDistance>500</maxDistance>
        <exhaustSettings>
          <exhaustFleckDef>GravshipThrusterExhaust</exhaustFleckDef>
          <emissionsPerSecond>40</emissionsPerSecond>
          <spawnRadiusRange>0~0.5</spawnRadiusRange>
          <velocity>(0,0,-20)</velocity>
          <velocityRotationRange>-10~10</velocityRotationRange>
          <velocityMultiplierRange>0.8~1.2</velocityMultiplierRange>
          <rotationOverTimeRange>-180~180</rotationOverTimeRange>
          <scaleRange>3~5</scaleRange>
        </exhaustSettings>
      </li>
      <li Class="WraithNaniteGravtech.CompProperties_WNGGravshipPartTheme"><theme>Wraith</theme></li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="GravshipComponentBase">
    <defName>WNG_WraithFieldOrgan</defName>
    <label>Wraith grav-field organ</label>
    <description>A living field organ that extends the area and mass the Wraith gravship heart can support. It uses Odyssey's native substructure-footprint and support mechanics.</description>
    <graphicData><graphicClass>Graphic_Single</graphicClass><texPath>Things/Building/GravFieldExtender</texPath></graphicData>
    <statBases><MaxHitPoints>240</MaxHitPoints><Mass>14</Mass><WorkToBuild>1800</WorkToBuild></statBases>
    <fillPercent>0.4</fillPercent><passability>PassThroughOnly</passability><pathCost>14</pathCost>
    <designationCategory>WNG</designationCategory>
    <constructionSkillPrerequisite>6</constructionSkillPrerequisite>
    <resourcesFractionWhenDeconstructed>0.5</resourcesFractionWhenDeconstructed>
    <researchPrerequisites><li>WNG_WraithGravships</li></researchPrerequisites>
    <costList><WNG_WraithBioSludge>18</WNG_WraithBioSludge><Plasteel>55</Plasteel><ComponentIndustrial>2</ComponentIndustrial></costList>
    <terrainAffordanceNeeded>Substructure</terrainAffordanceNeeded>
    <placeWorkers><li>PlaceWorker_InRangeOfGravEngine</li></placeWorkers>
    <comps>
      <li Class="CompProperties_SubstructureFootprint"><radius>16.9</radius></li>
      <li Class="CompProperties_GravshipFacility">
        <statOffsets><SubstructureSupport>250</SubstructureSupport></statOffsets>
        <requiresLOS>false</requiresLOS><maxSimultaneous>6</maxSimultaneous><maxDistance>18.9</maxDistance><onlyRequiresLooseConnection>true</onlyRequiresLooseConnection>
      </li>
      <li Class="WraithNaniteGravtech.CompProperties_WNGGravshipPartTheme"><theme>Wraith</theme></li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="GravshipComponentBase">
    <defName>WNG_WraithTransportJammer</defName>
    <label>Wraith transport jammer</label>
    <description>A Wraith signal-distortion organ that fulfills Odyssey's gravship signal-jammer role. Unlike the rejected shield reskin, transporter and sensor interference is consistent with Wraith technology.</description>
    <graphicData><graphicClass>Graphic_Multi</graphicClass><texPath>Things/Building/SignalJammer/SignalJammer</texPath><drawSize>(2,2)</drawSize></graphicData>
    <statBases><MaxHitPoints>360</MaxHitPoints><Flammability>0.1</Flammability><Mass>65</Mass><WorkToBuild>8000</WorkToBuild></statBases>
    <size>(2,2)</size><fillPercent>0.6</fillPercent><passability>PassThroughOnly</passability><pathCost>20</pathCost>
    <designationCategory>WNG</designationCategory>
    <constructionSkillPrerequisite>8</constructionSkillPrerequisite>
    <researchPrerequisites><li>WNG_WraithGravships</li></researchPrerequisites>
    <costList><WNG_WraithBioSludge>30</WNG_WraithBioSludge><Plasteel>120</Plasteel><ComponentSpacer>3</ComponentSpacer></costList>
    <terrainAffordanceNeeded>Substructure</terrainAffordanceNeeded>
    <comps>
      <li Class="CompProperties_GravshipFacility"><requiresLOS>false</requiresLOS><componentTypeDef>SignalJammer</componentTypeDef><maxSimultaneous>1</maxSimultaneous><maxDistance>500</maxDistance></li>
      <li Class="WraithNaniteGravtech.CompProperties_WNGGravshipPartTheme"><theme>Wraith</theme></li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="GravshipComponentBase">
    <defName>WNG_WraithPropulsionCoordinator</defName>
    <label>Wraith propulsion coordinator</label>
    <description>A living coordination organ that synchronizes gravitic lift and Wraith drive pulses, reducing propellant expenditure without introducing a synthetic pilot subpersona.</description>
    <graphicData><graphicClass>Graphic_Multi</graphicClass><texPath>Things/Building/FuelOptimizer/FuelOptimizer</texPath><drawSize>(2,2)</drawSize></graphicData>
    <statBases><MaxHitPoints>190</MaxHitPoints><Flammability>0.1</Flammability><Mass>38</Mass><WorkToBuild>6500</WorkToBuild></statBases>
    <size>(2,2)</size><fillPercent>0.4</fillPercent><passability>PassThroughOnly</passability><pathCost>20</pathCost>
    <designationCategory>WNG</designationCategory>
    <constructionSkillPrerequisite>7</constructionSkillPrerequisite>
    <researchPrerequisites><li>WNG_WraithGravships</li></researchPrerequisites>
    <costList><WNG_WraithBioSludge>24</WNG_WraithBioSludge><Plasteel>90</Plasteel><ComponentSpacer>3</ComponentSpacer></costList>
    <terrainAffordanceNeeded>Substructure</terrainAffordanceNeeded>
    <comps>
      <li Class="CompProperties_GravshipFacility"><fuelSavingsPercent>0.2</fuelSavingsPercent><requiresLOS>false</requiresLOS><maxSimultaneous>2</maxSimultaneous><maxDistance>500</maxDistance></li>
      <li Class="WraithNaniteGravtech.CompProperties_WNGGravshipPartTheme"><theme>Wraith</theme></li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="GravshipComponentBase">
    <defName>WNG_WraithHullRegenerator</defName>
    <label>Wraith hull regeneration node</label>
    <description>A living repair node that restores damaged Wraith hull tissue on the same connected gravship. It is the Wraith defensive analogue to Odyssey's gravship shield generator: gradual biological regeneration rather than an energy shield.</description>
    <tickerType>Normal</tickerType>
    <graphicData><graphicClass>Graphic_Single</graphicClass><texPath>Things/Building/GravcorePowerCell</texPath><drawSize>(2,2)</drawSize></graphicData>
    <statBases><MaxHitPoints>260</MaxHitPoints><Flammability>0.1</Flammability><Mass>50</Mass><WorkToBuild>9000</WorkToBuild></statBases>
    <size>(2,2)</size><fillPercent>0.5</fillPercent><passability>PassThroughOnly</passability><pathCost>20</pathCost>
    <designationCategory>WNG</designationCategory>
    <constructionSkillPrerequisite>8</constructionSkillPrerequisite>
    <researchPrerequisites><li>WNG_WraithGravships</li></researchPrerequisites>
    <costList><WNG_WraithBioSludge>45</WNG_WraithBioSludge><Plasteel>100</Plasteel><ComponentSpacer>4</ComponentSpacer></costList>
    <terrainAffordanceNeeded>Substructure</terrainAffordanceNeeded>
    <comps>
      <li Class="CompProperties_GravshipFacility"><requiresLOS>false</requiresLOS><maxSimultaneous>2</maxSimultaneous><maxDistance>500</maxDistance></li>
      <li Class="WraithNaniteGravtech.CompProperties_WraithHullRegenerator"><pulseIntervalTicks>600</pulseIntervalTicks><hitPointsPerPulse>3</hitPointsPerPulse><maxHullCellsPerPulse>8</maxHullCellsPerPulse></li>
      <li Class="WraithNaniteGravtech.CompProperties_WNGGravshipPartTheme"><theme>Wraith</theme></li>
    </comps>
  </ThingDef>
</Defs>
