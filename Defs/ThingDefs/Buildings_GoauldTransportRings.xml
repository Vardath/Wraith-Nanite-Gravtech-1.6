<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    Fresh Goa'uld transport-ring endpoint. Native CompTransporter owns the load assignment and exact
    ThingOwner cargo state. WNG only supplies powered ring-to-ring destination selection/transfer.
    Graphic is a temporary vanilla mechanics placeholder pending the production ring animation/art.
  -->
  <ThingDef ParentName="BuildingBase">
    <defName>WNG_GoauldTransportRings</defName>
    <label>Goa'uld transport rings</label>
    <description>A Goa'uld matter-transport platform derived from Ancient ring technology. Load people, animals, mechs or cargo using the normal transporter controls, then activate the rings and choose another powered ring platform on this map or another currently loaded map. No Stargate dialing is required.</description>
    <thingClass>Building</thingClass>
    <tickerType>Normal</tickerType>
    <size>(3,3)</size>
    <rotatable>false</rotatable>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <texPath>Things/Building/Misc/OrbitalTradeBeacon</texPath>
      <drawSize>(3,3)</drawSize>
      <color>(0.72,0.58,0.27)</color>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>8</pathCost>
    <fillPercent>0.15</fillPercent>
    <selectable>true</selectable>
    <neverMultiSelect>true</neverMultiSelect>
    <canOverlapZones>false</canOverlapZones>
    <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
    <statBases>
      <MaxHitPoints>600</MaxHitPoints>
      <WorkToBuild>8000</WorkToBuild>
      <Mass>65</Mass>
      <Flammability>0</Flammability>
      <Beauty>2</Beauty>
    </statBases>
    <costList>
      <Steel>100</Steel>
      <Plasteel>120</Plasteel>
      <Gold>40</Gold>
      <ComponentIndustrial>6</ComponentIndustrial>
      <ComponentSpacer>2</ComponentSpacer>
    </costList>
    <designationCategory>WNG</designationCategory>
    <researchPrerequisites><li>WNG_GoauldRingTransport</li></researchPrerequisites>
    <constructionSkillPrerequisite>8</constructionSkillPrerequisite>
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0,0,-2)</interactionCellOffset>
    <building>
      <isInert>true</isInert>
      <destroySound>BuildingDestroyed_Metal_Big</destroySound>
    </building>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>450</basePowerConsumption>
      </li>
      <li Class="CompProperties_Flickable" />
      <li Class="CompProperties_Breakdownable" />
      <li Class="CompProperties_Transporter">
        <massCapacity>2000</massCapacity>
        <max1PerGroup>true</max1PerGroup>
        <canChangeAssignedThingsAfterStarting>true</canChangeAssignedThingsAfterStarting>
        <pawnLoadedSound>Shuttle_PawnLoaded</pawnLoadedSound>
        <pawnExitSound>Shuttle_PawnExit</pawnExitSound>
        <showMassInInspectString>true</showMassInInspectString>
      </li>
      <li Class="WraithNaniteGravtech.CompProperties_GoauldTransportRings">
        <cooldownTicks>300</cooldownTicks>
        <arrivalRadius>4</arrivalRadius>
        <requirePower>true</requirePower>
      </li>
    </comps>
    <inspectorTabs><li>ITab_ContentsTransporter</li></inspectorTabs>
    <modExtensions>
      <li Class="WraithNaniteGravtech.WNGGoauldArchitectExtension" />
    </modExtensions>
    <uiOrder>2460</uiOrder>
  </ThingDef>
</Defs>
