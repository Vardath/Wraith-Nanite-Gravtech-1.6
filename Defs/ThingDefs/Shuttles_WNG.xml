<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Complete player-shuttle pattern: native Building_PassengerShuttle + CompShuttle +
       CompLaunchable + CompTransporter + CompRefuelable. WNG only layers Stargate-specific
       mission behavior on top; vanilla/Odyssey loading, boarding and launch stay authoritative. -->

  <ThingDef ParentName="BuildingBase">
    <defName>WNG_WraithDart</defName>
    <label>Wraith Dart</label>
    <description>A Wraith culling fighter reconstructed as a fully operable colony shuttle. Its culling beam and Stargate mission logic are WNG additions, while ordinary boarding, loading and launch use RimWorld's native shuttle systems.</description>
    <thingClass>Building_PassengerShuttle</thingClass>
    <preventDroppingThingsOn>true</preventDroppingThingsOn>
    <size>(3,5)</size>
    <rotatable>true</rotatable>
    <graphicData><texPath>Things/Building/Misc/Shuttle</texPath><graphicClass>Graphic_Single</graphicClass><drawSize>(3,5)</drawSize></graphicData>
    <defaultPlacingRot>North</defaultPlacingRot>
    <pathCost>50</pathCost><drawOffscreen>true</drawOffscreen><fillPercent>0.35</fillPercent><passability>PassThroughOnly</passability>
    <stealable>false</stealable><altitudeLayer>Building</altitudeLayer><receivesSignals>true</receivesSignals><neverMultiSelect>true</neverMultiSelect>
    <statBases><MaxHitPoints>1500</MaxHitPoints><WorkToBuild>18000</WorkToBuild><Mass>150</Mass><Flammability>0.25</Flammability><Comfort>0.65</Comfort></statBases>
    <hasInteractionCell>true</hasInteractionCell><interactionCellOffset>(0,0,-3)</interactionCellOffset><selectable>true</selectable>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded><soundImpactDefault>BulletImpact_Metal</soundImpactDefault><preventSkyfallersLandingOn>true</preventSkyfallersLandingOn><drawerType>RealtimeOnly</drawerType><repairEffect>ConstructMetal</repairEffect>
    <building><claimable>false</claimable><destroySound>BuildingDestroyed_Metal_Big</destroySound><isInert>true</isInert></building>
    <designationCategory>WNG</designationCategory>
    <researchPrerequisites><li>WNG_WraithShuttles</li></researchPrerequisites>
    <constructionSkillPrerequisite>8</constructionSkillPrerequisite>
    <costList><Steel>180</Steel><Plasteel>220</Plasteel><ComponentIndustrial>12</ComponentIndustrial><ComponentSpacer>4</ComponentSpacer></costList>
    <comps>
      <li Class="CompProperties_Shuttle"><shipDef>WNG_WraithDartShip</shipDef></li>
      <li Class="CompProperties_Launchable"><fuelPerTile>2.2</fuelPerTile><minFuelCost>45</minFuelCost><skyfallerLeaving>WNG_WraithDartLeaving</skyfallerLeaving><worldObjectDef>WNG_WraithDartWorld</worldObjectDef><cooldownTicks>2500</cooldownTicks><fixedLaunchDistanceMax>120</fixedLaunchDistanceMax><cooldownEndedMessage>{0} is ready to launch again.</cooldownEndedMessage></li>
      <li Class="CompProperties_Transporter"><massCapacity>350</massCapacity><max1PerGroup>true</max1PerGroup><canChangeAssignedThingsAfterStarting>true</canChangeAssignedThingsAfterStarting><pawnLoadedSound>Shuttle_PawnLoaded</pawnLoadedSound><pawnExitSound>Shuttle_PawnExit</pawnExitSound><showMassInInspectString>true</showMassInInspectString></li>
      <li Class="CompProperties_Refuelable"><fuelCapacity>650</fuelCapacity><targetFuelLevelConfigurable>true</targetFuelLevelConfigurable><initialConfigurableTargetFuelLevel>650</initialConfigurableTargetFuelLevel><fuelFilter><thingDefs><li>WNG_WraithBioSludge</li></thingDefs></fuelFilter><initialFuelPercent>0.5</initialFuelPercent><consumeFuelOnlyWhenUsed>true</consumeFuelOnlyWhenUsed><autoRefuelPercent>1</autoRefuelPercent><showFuelGizmo>true</showFuelGizmo><drawOutOfFuelOverlay>false</drawOutOfFuelOverlay><canEjectFuel>true</canEjectFuel></li>
      <li Class="WraithNaniteGravtech.CompProperties_WraithDartPilot"><pilotPawnKindDefName>WNG_WraithHunter</pilotPawnKindDefName><ejectionRadius>4</ejectionRadius></li>
      <li Class="WraithNaniteGravtech.CompProperties_WraithDartCulling"><maxCaptives>3</maxCaptives><stunTicks>1200</stunTicks><releaseRadius>4</releaseRadius></li>
      <li Class="WraithNaniteGravtech.CompProperties_WraithDartRaidMission"><attackPasses>2</attackPasses><passIntervalTicks>900</passIntervalTicks><maxCapturesPerPass>2</maxCapturesPerPass><acquisitionRadius>38</acquisitionRadius><landedRaidDelayTicks>1800</landedRaidDelayTicks><stargateDecisionTimeoutTicks>1200</stargateDecisionTimeoutTicks><stargateTransitTimeoutTicks>6000</stargateTransitTimeoutTicks></li>
      <li Class="CompProperties_Hackable"><defence>400</defence><intellectualSkillPrerequisite>6</intellectualSkillPrerequisite><showProgressAfterHackCompletion>false</showProgressAfterHackCompletion><notHackedInspectString>Wraith flight and culling controls are secured.</notHackedInspectString><hackedInspectString>Wraith controls breached; shuttle transferred to colony control.</hackedInspectString><hackedMessage>{HACKER} has breached the Wraith Dart controls, released any buffered captives and transferred the surviving shuttle to colony control.</hackedMessage></li>
    </comps>
    <inspectorTabs><li>ITab_ContentsTransporter</li></inspectorTabs>
    <placeWorkers><li>PlaceWorker_NotUnderRoof</li></placeWorkers>
  </ThingDef>

  <ThingDef ParentName="BuildingBase">
    <defName>WNG_WraithStrikeCraft</defName>
    <label>Wraith scout craft</label>
    <description>A Wraith scout, shuttle and cargo vessel larger than a Dart. It fills the canon reconnaissance/personnel-movement role rather than duplicating the Dart fighter.</description>
    <thingClass>Building_PassengerShuttle</thingClass><preventDroppingThingsOn>true</preventDroppingThingsOn><size>(4,5)</size><rotatable>true</rotatable>
    <graphicData><texPath>Things/Building/Misc/Shuttle</texPath><graphicClass>Graphic_Single</graphicClass><drawSize>(4,5)</drawSize></graphicData>
    <defaultPlacingRot>North</defaultPlacingRot><pathCost>50</pathCost><drawOffscreen>true</drawOffscreen><fillPercent>0.45</fillPercent><passability>PassThroughOnly</passability><stealable>false</stealable><altitudeLayer>Building</altitudeLayer><receivesSignals>true</receivesSignals><neverMultiSelect>true</neverMultiSelect>
    <statBases><MaxHitPoints>2200</MaxHitPoints><WorkToBuild>24000</WorkToBuild><Mass>260</Mass><Flammability>0.22</Flammability><Comfort>0.7</Comfort></statBases>
    <hasInteractionCell>true</hasInteractionCell><interactionCellOffset>(0,0,-3)</interactionCellOffset><selectable>true</selectable><terrainAffordanceNeeded>Light</terrainAffordanceNeeded><soundImpactDefault>BulletImpact_Metal</soundImpactDefault><preventSkyfallersLandingOn>true</preventSkyfallersLandingOn><drawerType>RealtimeOnly</drawerType><repairEffect>ConstructMetal</repairEffect>
    <building><claimable>false</claimable><destroySound>BuildingDestroyed_Metal_Big</destroySound><isInert>true</isInert></building>
    <designationCategory>WNG</designationCategory><researchPrerequisites><li>WNG_WraithShuttles</li></researchPrerequisites><constructionSkillPrerequisite>8</constructionSkillPrerequisite>
    <costList><Steel>320</Steel><Plasteel>360</Plasteel><ComponentIndustrial>18</ComponentIndustrial><ComponentSpacer>6</ComponentSpacer></costList>
    <comps>
      <li Class="CompProperties_Shuttle"><shipDef>WNG_WraithScoutShip</shipDef></li>
      <li Class="CompProperties_Launchable"><fuelPerTile>3</fuelPerTile><minFuelCost>55</minFuelCost><skyfallerLeaving>WNG_WraithScoutLeaving</skyfallerLeaving><worldObjectDef>WNG_WraithScoutWorld</worldObjectDef><cooldownTicks>3000</cooldownTicks><fixedLaunchDistanceMax>120</fixedLaunchDistanceMax><cooldownEndedMessage>{0} is ready to launch again.</cooldownEndedMessage></li>
      <li Class="CompProperties_Transporter"><massCapacity>800</massCapacity><max1PerGroup>true</max1PerGroup><canChangeAssignedThingsAfterStarting>true</canChangeAssignedThingsAfterStarting><pawnLoadedSound>Shuttle_PawnLoaded</pawnLoadedSound><pawnExitSound>Shuttle_PawnExit</pawnExitSound><showMassInInspectString>true</showMassInInspectString></li>
      <li Class="CompProperties_Refuelable"><fuelCapacity>1000</fuelCapacity><targetFuelLevelConfigurable>true</targetFuelLevelConfigurable><initialConfigurableTargetFuelLevel>1000</initialConfigurableTargetFuelLevel><fuelFilter><thingDefs><li>WNG_WraithBioSludge</li></thingDefs></fuelFilter><initialFuelPercent>0.5</initialFuelPercent><consumeFuelOnlyWhenUsed>true</consumeFuelOnlyWhenUsed><autoRefuelPercent>1</autoRefuelPercent><showFuelGizmo>true</showFuelGizmo><drawOutOfFuelOverlay>false</drawOutOfFuelOverlay><canEjectFuel>true</canEjectFuel></li>
    </comps><inspectorTabs><li>ITab_ContentsTransporter</li></inspectorTabs><placeWorkers><li>PlaceWorker_NotUnderRoof</li></placeWorkers>
  </ThingDef>

  <ThingDef ParentName="BuildingBase">
    <defName>WNG_WraithCruiser</defName>
    <label>Wraith cruiser transport</label>
    <description>A RimWorld-scale Wraith assault and personnel transport, heavier than the scout craft but still represented as a boardable shuttle rather than a full strategic hive ship.</description>
    <thingClass>Building_PassengerShuttle</thingClass><preventDroppingThingsOn>true</preventDroppingThingsOn><size>(6,5)</size><rotatable>true</rotatable>
    <graphicData><texPath>Things/Building/Misc/Shuttle</texPath><graphicClass>Graphic_Single</graphicClass><drawSize>(6,5)</drawSize></graphicData>
    <defaultPlacingRot>North</defaultPlacingRot><pathCost>50</pathCost><drawOffscreen>true</drawOffscreen><fillPercent>0.55</fillPercent><passability>PassThroughOnly</passability><stealable>false</stealable><altitudeLayer>Building</altitudeLayer><receivesSignals>true</receivesSignals><neverMultiSelect>true</neverMultiSelect>
    <statBases><MaxHitPoints>3400</MaxHitPoints><WorkToBuild>32000</WorkToBuild><Mass>480</Mass><Flammability>0.18</Flammability><Comfort>0.72</Comfort></statBases>
    <hasInteractionCell>true</hasInteractionCell><interactionCellOffset>(0,0,-3)</interactionCellOffset><selectable>true</selectable><terrainAffordanceNeeded>Light</terrainAffordanceNeeded><soundImpactDefault>BulletImpact_Metal</soundImpactDefault><preventSkyfallersLandingOn>true</preventSkyfallersLandingOn><drawerType>RealtimeOnly</drawerType><repairEffect>ConstructMetal</repairEffect>
    <building><claimable>false</claimable><destroySound>BuildingDestroyed_Metal_Big</destroySound><isInert>true</isInert></building>
    <designationCategory>WNG</designationCategory><researchPrerequisites><li>WNG_WraithShuttles</li></researchPrerequisites><constructionSkillPrerequisite>10</constructionSkillPrerequisite>
    <costList><Steel>500</Steel><Plasteel>620</Plasteel><ComponentIndustrial>26</ComponentIndustrial><ComponentSpacer>10</ComponentSpacer></costList>
    <comps>
      <li Class="CompProperties_Shuttle"><shipDef>WNG_WraithCruiserShip</shipDef></li>
      <li Class="CompProperties_Launchable"><fuelPerTile>4.2</fuelPerTile><minFuelCost>75</minFuelCost><skyfallerLeaving>WNG_WraithCruiserLeaving</skyfallerLeaving><worldObjectDef>WNG_WraithCruiserWorld</worldObjectDef><cooldownTicks>4000</cooldownTicks><fixedLaunchDistanceMax>120</fixedLaunchDistanceMax><cooldownEndedMessage>{0} is ready to launch again.</cooldownEndedMessage></li>
      <li Class="CompProperties_Transporter"><massCapacity>1600</massCapacity><max1PerGroup>true</max1PerGroup><canChangeAssignedThingsAfterStarting>true</canChangeAssignedThingsAfterStarting><pawnLoadedSound>Shuttle_PawnLoaded</pawnLoadedSound><pawnExitSound>Shuttle_PawnExit</pawnExitSound><showMassInInspectString>true</showMassInInspectString></li>
      <li Class="CompProperties_Refuelable"><fuelCapacity>1800</fuelCapacity><targetFuelLevelConfigurable>true</targetFuelLevelConfigurable><initialConfigurableTargetFuelLevel>1800</initialConfigurableTargetFuelLevel><fuelFilter><thingDefs><li>WNG_WraithBioSludge</li></thingDefs></fuelFilter><initialFuelPercent>0.5</initialFuelPercent><consumeFuelOnlyWhenUsed>true</consumeFuelOnlyWhenUsed><autoRefuelPercent>1</autoRefuelPercent><showFuelGizmo>true</showFuelGizmo><drawOutOfFuelOverlay>false</drawOutOfFuelOverlay><canEjectFuel>true</canEjectFuel></li>
    </comps><inspectorTabs><li>ITab_ContentsTransporter</li></inspectorTabs><placeWorkers><li>PlaceWorker_NotUnderRoof</li></placeWorkers>
  </ThingDef>

  <ThingDef ParentName="BuildingBase">
    <defName>WNG_PuddleJumper</defName>
    <label>Puddle Jumper</label>
    <description>An Ancient/Lantean gate-capable shuttle. WNG adds Ancient drone and Stargate mission behavior while native RimWorld/Odyssey systems own ordinary boarding, loading and launch.</description>
    <thingClass>Building_PassengerShuttle</thingClass><preventDroppingThingsOn>true</preventDroppingThingsOn><size>(4,5)</size><rotatable>true</rotatable>
    <graphicData><texPath>Things/Building/Misc/Shuttle</texPath><graphicClass>Graphic_Single</graphicClass><drawSize>(4,5)</drawSize></graphicData>
    <defaultPlacingRot>North</defaultPlacingRot><pathCost>50</pathCost><drawOffscreen>true</drawOffscreen><fillPercent>0.45</fillPercent><passability>PassThroughOnly</passability><stealable>false</stealable><altitudeLayer>Building</altitudeLayer><receivesSignals>true</receivesSignals><neverMultiSelect>true</neverMultiSelect>
    <statBases><MaxHitPoints>2000</MaxHitPoints><WorkToBuild>28000</WorkToBuild><Mass>220</Mass><Flammability>0.12</Flammability><Comfort>0.8</Comfort></statBases>
    <hasInteractionCell>true</hasInteractionCell><interactionCellOffset>(0,0,-3)</interactionCellOffset><selectable>true</selectable><terrainAffordanceNeeded>Light</terrainAffordanceNeeded><soundImpactDefault>BulletImpact_Metal</soundImpactDefault><preventSkyfallersLandingOn>true</preventSkyfallersLandingOn><drawerType>RealtimeOnly</drawerType><repairEffect>ConstructMetal</repairEffect>
    <building><claimable>false</claimable><destroySound>BuildingDestroyed_Metal_Big</destroySound><isInert>true</isInert></building>
    <designationCategory>WNG</designationCategory><researchPrerequisites><li>WNG_AncientShuttles</li></researchPrerequisites><constructionSkillPrerequisite>10</constructionSkillPrerequisite>
    <costList><Steel>260</Steel><Plasteel>500</Plasteel><Gold>80</Gold><ComponentIndustrial>20</ComponentIndustrial><ComponentSpacer>8</ComponentSpacer></costList>
    <comps>
      <li Class="CompProperties_Shuttle"><shipDef>WNG_PuddleJumperShip</shipDef></li>
      <li Class="CompProperties_Launchable"><fuelPerTile>2.4</fuelPerTile><minFuelCost>45</minFuelCost><skyfallerLeaving>WNG_PuddleJumperLeaving</skyfallerLeaving><worldObjectDef>WNG_PuddleJumperWorld</worldObjectDef><cooldownTicks>2500</cooldownTicks><fixedLaunchDistanceMax>120</fixedLaunchDistanceMax><cooldownEndedMessage>{0} is ready to launch again.</cooldownEndedMessage></li>
      <!-- Chemfuel is a temporary native-mechanics placeholder until the Ancient power/fuel abstraction is deliberately designed. -->
      <li Class="CompProperties_Transporter"><massCapacity>700</massCapacity><max1PerGroup>true</max1PerGroup><canChangeAssignedThingsAfterStarting>true</canChangeAssignedThingsAfterStarting><pawnLoadedSound>Shuttle_PawnLoaded</pawnLoadedSound><pawnExitSound>Shuttle_PawnExit</pawnExitSound><showMassInInspectString>true</showMassInInspectString></li>
      <li Class="CompProperties_Refuelable"><fuelCapacity>800</fuelCapacity><targetFuelLevelConfigurable>true</targetFuelLevelConfigurable><initialConfigurableTargetFuelLevel>800</initialConfigurableTargetFuelLevel><fuelFilter><thingDefs><li>Chemfuel</li></thingDefs></fuelFilter><initialFuelPercent>0.5</initialFuelPercent><consumeFuelOnlyWhenUsed>true</consumeFuelOnlyWhenUsed><autoRefuelPercent>1</autoRefuelPercent><showFuelGizmo>true</showFuelGizmo><drawOutOfFuelOverlay>false</drawOutOfFuelOverlay><canEjectFuel>true</canEjectFuel></li>
      <li Class="WraithNaniteGravtech.CompProperties_PuddleJumperRaidMission"><attackPasses>2</attackPasses><passIntervalTicks>900</passIntervalTicks><dronesPerPass>3</dronesPerPass><acquisitionRadius>45</acquisitionRadius><landedRaidDelayTicks>1800</landedRaidDelayTicks><droneProjectile>WNG_AncientDroneProjectile</droneProjectile></li>
    </comps><inspectorTabs><li>ITab_ContentsTransporter</li></inspectorTabs><placeWorkers><li>PlaceWorker_NotUnderRoof</li></placeWorkers>
  </ThingDef>

  <ThingDef ParentName="BuildingBase" MayRequire="idolord.ONAC">
    <defName>WNG_AlkeshTransport</defName>
    <label>Al'kesh transport</label>
    <description>A Goa'uld Al'kesh-derived bomber and troop transport integrated with ONAC technology. Native RimWorld/Odyssey shuttle systems own boarding, loading and launch; WNG adds the Stargate-themed combat role.</description>
    <thingClass>Building_PassengerShuttle</thingClass><preventDroppingThingsOn>true</preventDroppingThingsOn><size>(5,6)</size><rotatable>true</rotatable>
    <graphicData><texPath>Things/Building/Misc/Shuttle</texPath><graphicClass>Graphic_Single</graphicClass><drawSize>(5,6)</drawSize></graphicData>
    <defaultPlacingRot>North</defaultPlacingRot><pathCost>50</pathCost><drawOffscreen>true</drawOffscreen><fillPercent>0.55</fillPercent><passability>PassThroughOnly</passability><stealable>false</stealable><altitudeLayer>Building</altitudeLayer><receivesSignals>true</receivesSignals><neverMultiSelect>true</neverMultiSelect>
    <statBases><MaxHitPoints>3000</MaxHitPoints><WorkToBuild>30000</WorkToBuild><Mass>420</Mass><Flammability>0.16</Flammability><Comfort>0.75</Comfort></statBases>
    <hasInteractionCell>true</hasInteractionCell><interactionCellOffset>(0,0,-4)</interactionCellOffset><selectable>true</selectable><terrainAffordanceNeeded>Light</terrainAffordanceNeeded><soundImpactDefault>BulletImpact_Metal</soundImpactDefault><preventSkyfallersLandingOn>true</preventSkyfallersLandingOn><drawerType>RealtimeOnly</drawerType><repairEffect>ConstructMetal</repairEffect>
    <building><claimable>false</claimable><destroySound>BuildingDestroyed_Metal_Big</destroySound><isInert>true</isInert></building>
    <designationCategory>ONAC_Architect</designationCategory><researchPrerequisites><li>WNG_GoauldShuttles</li></researchPrerequisites><constructionSkillPrerequisite>9</constructionSkillPrerequisite>
    <costList><Steel>600</Steel><Plasteel>300</Plasteel><Gold>120</Gold><ComponentIndustrial>20</ComponentIndustrial><ComponentSpacer>8</ComponentSpacer><ONAC_Naquadah>80</ONAC_Naquadah></costList>
    <comps>
      <li Class="CompProperties_Shuttle"><shipDef>WNG_AlkeshShip</shipDef></li>
      <li Class="CompProperties_Launchable"><fuelPerTile>3.6</fuelPerTile><minFuelCost>60</minFuelCost><skyfallerLeaving>WNG_AlkeshLeaving</skyfallerLeaving><worldObjectDef>WNG_AlkeshWorld</worldObjectDef><cooldownTicks>3200</cooldownTicks><fixedLaunchDistanceMax>120</fixedLaunchDistanceMax><cooldownEndedMessage>{0} is ready to launch again.</cooldownEndedMessage></li>
      <li Class="CompProperties_Transporter"><massCapacity>1800</massCapacity><max1PerGroup>true</max1PerGroup><canChangeAssignedThingsAfterStarting>true</canChangeAssignedThingsAfterStarting><pawnLoadedSound>Shuttle_PawnLoaded</pawnLoadedSound><pawnExitSound>Shuttle_PawnExit</pawnExitSound><showMassInInspectString>true</showMassInInspectString></li>
      <li Class="CompProperties_Refuelable"><fuelCapacity>1800</fuelCapacity><targetFuelLevelConfigurable>true</targetFuelLevelConfigurable><initialConfigurableTargetFuelLevel>1800</initialConfigurableTargetFuelLevel><fuelFilter><thingDefs><li>ONAC_LiquidNaquadria</li></thingDefs></fuelFilter><initialFuelPercent>0.5</initialFuelPercent><consumeFuelOnlyWhenUsed>true</consumeFuelOnlyWhenUsed><autoRefuelPercent>1</autoRefuelPercent><showFuelGizmo>true</showFuelGizmo><drawOutOfFuelOverlay>false</drawOutOfFuelOverlay><canEjectFuel>true</canEjectFuel></li>
    </comps><inspectorTabs><li>ITab_ContentsTransporter</li></inspectorTabs><placeWorkers><li>PlaceWorker_NotUnderRoof</li></placeWorkers>
  </ThingDef>
</Defs>
