<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="ApparelBase">
    <defName>WNG_WraithHunterCoat</defName><label>wraith hunter coat</label>
    <thingCategories Inherit="False"><li>ApparelMisc</li></thingCategories>
    <description>A long flexible coat grown from layered Wraith membrane, providing modest protection without the bulk of a full carapace.</description><techLevel>Spacer</techLevel>
    <graphicData><texPath>Things/Pawn/Humanlike/Apparel/Wraith/WNG_HunterCoat</texPath><graphicClass>Graphic_Single</graphicClass></graphicData>
    <statBases><MaxHitPoints>180</MaxHitPoints><WorkToMake>14000</WorkToMake><Mass>3.5</Mass><EquipDelay>2</EquipDelay><ArmorRating_Sharp>0.55</ArmorRating_Sharp><ArmorRating_Blunt>0.25</ArmorRating_Blunt><ArmorRating_Heat>0.4</ArmorRating_Heat></statBases>
    <costList><WNG_Biomass>24</WNG_Biomass></costList>
    <apparel><bodyPartGroups><li>Torso</li><li>Neck</li><li>Shoulders</li><li>Arms</li><li>Legs</li></bodyPartGroups><layers><li>Shell</li></layers><wornGraphicPath>Things/Pawn/Humanlike/Apparel/Wraith/WNG_HunterCoat</wornGraphicPath><tags><li>WraithClothing</li></tags></apparel>
    <recipeMaker><researchPrerequisite>WNG_BiologicalCultivation</researchPrerequisite><workSkill>Crafting</workSkill><skillRequirements><Crafting>4</Crafting></skillRequirements><recipeUsers Inherit="False"><li>WNG_LivingForge</li></recipeUsers></recipeMaker>
  
    <comps>
      <li Class="WraithNaniteGravtech.CompProperties_WraithLivingEquipmentMaturation" />
    </comps>
  </ThingDef>

