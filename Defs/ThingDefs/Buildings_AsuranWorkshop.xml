<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Temporary vanilla graphic for mechanics validation only. Final release requires dedicated Asuran/Ancient-derived art. -->
  <ThingDef ParentName="BenchBase">
    <defName>WNG_AsuranWorkshop</defName>
    <label>Asuran nanite workshop</label>
    <description>A programmable Asuran fabrication matrix assembled from coordinated nanites. It is the production bench for WNG Asuran/Precursor nanite-engineered craftables. Normally it is assembled directly by a nanite humanoid using Nanite Reserve; the WNG bypass option can additionally expose it for ordinary Architect construction.</description>
    <thingClass>Building_WorkTable</thingClass>
    <graphicData>
      <texPath>Things/Building/Production/FabricationBench</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(3.5,1.5)</drawSize>
    </graphicData>
    <size>(3,1)</size>
    <fillPercent>0.5</fillPercent>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <surfaceType>Item</surfaceType>
    <!-- Deliberately no designationCategory here. WNG settings add/remove the direct Architect designator at runtime. -->
    <uiOrder>2400</uiOrder>
    <costList>
      <Plasteel>100</Plasteel>
      <ComponentSpacer>2</ComponentSpacer>
    </costList>
    <statBases>
      <WorkToBuild>5000</WorkToBuild>
      <MaxHitPoints>300</MaxHitPoints>
      <Flammability>0.02</Flammability>
      <Cleanliness>1</Cleanliness>
    </statBases>
    <constructionSkillPrerequisite>8</constructionSkillPrerequisite>
    <researchPrerequisites><li>WNG_AsuranFabrication</li></researchPrerequisites>
    <recipes>
      <li>WNG_SynthesizeNaniteSludge</li>
    </recipes>
    <inspectorTabs><li>ITab_Bills</li></inspectorTabs>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <shortCircuitInRain>true</shortCircuitInRain>
        <basePowerConsumption>300</basePowerConsumption>
      </li>
      <li Class="CompProperties_Flickable" />
      <li Class="CompProperties_Breakdownable" />
    </comps>
    <building><spawnedConceptLearnOpportunity>BillsTab</spawnedConceptLearnOpportunity></building>
  </ThingDef>
</Defs>
