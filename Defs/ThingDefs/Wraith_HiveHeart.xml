<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="BuildingBase">
    <defName>WNG_WraithHiveHeart</defName>
    <label>wraith hive heart</label>
    <description>The central population anchor of a mature Wraith Hive. A generated hostile Hive can bind its exact active founders, exact ordinary hibernators and finite exact feeding stock to this Heart. The recorded founding Wraith population is the demographic ceiling until a later bounded Growth Chamber layer explicitly replaces losses.</description>
    <thingClass>Building</thingClass>
    <tickerType>Normal</tickerType>
    <size>(3,3)</size>
    <altitudeLayer>Building</altitudeLayer>
    <fillPercent>0.65</fillPercent>
    <useHitPoints>true</useHitPoints>
    <passability>Impassable</passability>
    <graphicData>
      <texPath>Things/Building/Production/TableMachining</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(4,4)</drawSize>
    </graphicData>
    <statBases>
      <MaxHitPoints>900</MaxHitPoints>
      <Flammability>0.1</Flammability>
      <WorkToBuild>6500</WorkToBuild>
    </statBases>
    <comps>
      <li Class="WraithNaniteGravtech.CompProperties_MatureWraithHivePopulation">
        <dormantWakeRadius>18</dormantWakeRadius>
        <activeLossesBeforeDormantWake>2</activeLossesBeforeDormantWake>
      </li>
    </comps>
  </ThingDef>
</Defs>
