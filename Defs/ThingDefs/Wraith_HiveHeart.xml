<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    Fresh WNG Hive Heart. Historical WNG XML/code/art/audio is not reused.
    The Core machining-table graphic is a temporary presentation placeholder only.
    Construction cost is a fresh rebuild balance choice pending live playtesting.
  -->
  <ThingDef ParentName="BuildingBase">
    <defName>WNG_HiveHeart</defName>
    <label>wraith hive heart</label>
    <description>The central maintenance organ of a mature Wraith enclave. It can spend cultured biomass to repair nearby existing Wraith organic structures, but cannot create or resurrect them. Mature NPC Hives can additionally bind an exact founding population to this Heart; ordinary and player-built Hearts remain demographically inert unless explicitly initialized by a Hive generator.</description>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>Things/Building/Production/TableMachining</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(4,4)</drawSize>
    </graphicData>
    <size>(3,3)</size>
    <tickerType>Normal</tickerType>
    <altitudeLayer>Building</altitudeLayer>
    <fillPercent>0.65</fillPercent>
    <useHitPoints>true</useHitPoints>
    <passability>Impassable</passability>
    <designationCategory>Production</designationCategory>
    <uiOrder>2585</uiOrder>
    <costList>
      <Steel>80</Steel>
      <ComponentIndustrial>4</ComponentIndustrial>
      <WNG_Biomass>140</WNG_Biomass>
    </costList>
    <statBases>
      <WorkToBuild>6500</WorkToBuild>
      <MaxHitPoints>900</MaxHitPoints>
      <Flammability>0.1</Flammability>
    </statBases>
    <constructionSkillPrerequisite>8</constructionSkillPrerequisite>
    <comps>
      <li Class="WraithNaniteGravtech.CompProperties_WraithHiveHeart">
        <pulseTicks>600</pulseTicks>
        <repairRadius>24</repairRadius>
        <maxRepairTargets>4</maxRepairTargets>
        <repairHitPoints>7</repairHitPoints>
        <biomassCostPerPulse>1</biomassCostPerPulse>
      </li>
      <li Class="WraithNaniteGravtech.CompProperties_MatureWraithHivePopulation">
        <replacementRetryTicks>30000</replacementRetryTicks>
      </li>
    </comps>
    <researchPrerequisites>
      <li>WNG_HiveArchitecture</li>
    </researchPrerequisites>
  </ThingDef>
</Defs>
