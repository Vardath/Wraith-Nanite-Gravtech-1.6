<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    Physical Wraith gravship door using RimWorld 1.6's native Building_Door vacuum contract.
    The closed living bulkhead is airtight; Building_Door permits vacuum exchange only while open.
    This remains living Wraith technology, carried by the native power net through cultivated
    bioelectric conduits. Native autodoor graphics are temporary mechanics-validation art only.
  -->
  <ThingDef ParentName="DoorBase">
    <defName>WNG_WraithLivingDoor</defName>
    <label>Wraith living bulkhead</label>
    <description>A contractile living bulkhead grown into Wraith gravship tissue. Closed, its interlocked membrane seals atmosphere against vacuum; when it opens, RimWorld's native door and vacuum systems exchange atmosphere through the passage normally. Bioelectric power accelerates the living aperture while the physical door remains operable if power is lost.</description>
    <thingClass>Building_Door</thingClass>
    <graphicData>
      <texPath>Things/Building/Door/Autodoor_Mover</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <color>(0.38,0.18,0.28)</color>
    </graphicData>
    <uiIconPath>Things/Building/Door/Autodoor_MenuIcon</uiIconPath>
    <useBlueprintGraphicAsGhost>true</useBlueprintGraphicAsGhost>
    <statBases>
      <MaxHitPoints>400</MaxHitPoints>
      <WorkToBuild>2800</WorkToBuild>
      <Flammability>0.15</Flammability>
      <DoorOpenSpeed>1.25</DoorOpenSpeed>
    </statBases>
    <stuffCategories Inherit="False" />
    <costList>
      <WNG_WraithBioSludge>12</WNG_WraithBioSludge>
      <Steel>35</Steel>
      <Plasteel>15</Plasteel>
    </costList>
    <useStuffTerrainAffordance>false</useStuffTerrainAffordance>
    <terrainAffordanceNeeded>Substructure</terrainAffordanceNeeded>
    <designationCategory>WNG</designationCategory>
    <researchPrerequisites><li>WNG_WraithGravships</li></researchPrerequisites>
    <constructionSkillPrerequisite>6</constructionSkillPrerequisite>
    <building>
      <isAirtight>true</isAirtight>
      <isSupportDoor>true</isSupportDoor>
    </building>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>35</basePowerConsumption>
      </li>
      <li Class="CompProperties_Flickable" />
      <li Class="WraithNaniteGravtech.CompProperties_WNGGravshipPartTheme"><theme>Wraith</theme></li>
    </comps>
    <uiOrder>2406</uiOrder>
  </ThingDef>
</Defs>
