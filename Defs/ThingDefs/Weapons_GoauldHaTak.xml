<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    Ha'tak shipboard weapon family. Stargate Ha'taks use heavy directed-energy weapons against
    other vessels and planetary targets. The same physical battery provides ordinary on-map
    gravship combat and, while mounted on a real powered Goa'uld Odyssey gravship in Orbit, a
    separate cross-map orbital-bombardment command backed by Royalty's native Bombardment Thing.
    Final Goa'uld production art/audio remains a later presentation pass.
  -->
  <ThingDef ParentName="BuildingBase" MayRequire="idolord.ONAC">
    <defName>WNG_GoauldHeavyPlasmaBattery</defName>
    <label>Ha'tak heavy plasma battery</label>
    <description>A shipboard Goa'uld energy-weapon battery scaled for RimWorld gravship combat. On a surface or local combat map it acts as a powered heavy plasma turret. When the same battery is powered on connected Goa'uld Ha'tak substructure on Odyssey's Orbit layer, it can designate a separate generated surface map for a true cross-map orbital bombardment using RimWorld's native orbital-strike machinery.</description>
    <thingClass>Building_TurretGun</thingClass>
    <tickerType>Normal</tickerType>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <texPath>Things/Building/Security/TurretAutocannon_Base</texPath>
      <drawSize>(2,2)</drawSize>
      <color>(0.68,0.48,0.20)</color>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <thingCategories><li>BuildingsSecurity</li></thingCategories>
    <size>(2,2)</size>
    <rotatable>true</rotatable>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <fillPercent>0.4</fillPercent>
    <terrainAffordanceNeeded>Substructure</terrainAffordanceNeeded>
    <designationCategory>ONAC_Architect</designationCategory>
    <researchPrerequisites><li>WNG_GoauldGravships</li></researchPrerequisites>
    <constructionSkillPrerequisite>8</constructionSkillPrerequisite>
    <statBases>
      <MaxHitPoints>520</MaxHitPoints>
      <Flammability>0</Flammability>
      <WorkToBuild>12000</WorkToBuild>
      <Mass>115</Mass>
      <Beauty>1</Beauty>
      <ShootingAccuracyTurret>0.96</ShootingAccuracyTurret>
    </statBases>
    <costList>
      <ONAC_Naquadah>55</ONAC_Naquadah>
      <Plasteel>160</Plasteel>
      <Gold>30</Gold>
      <ComponentIndustrial>8</ComponentIndustrial>
      <ComponentSpacer>3</ComponentSpacer>
    </costList>
    <comps>
      <li Class="CompProperties_Forbiddable" />
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>1500</basePowerConsumption>
      </li>
      <li Class="CompProperties_Flickable" />
      <li Class="RimWorld.CompProperties_Breakdownable" />
      <li Class="WraithNaniteGravtech.CompProperties_WNGGravshipPartTheme"><theme>Goauld</theme></li>
      <li Class="WraithNaniteGravtech.CompProperties_GoauldHatakOrbitalBombardment">
        <maxWorldRangeTiles>12</maxWorldRangeTiles>
        <cooldownTicks>60000</cooldownTicks>
        <impactAreaRadius>14</impactAreaRadius>
        <explosionRadiusRange>(4.5,6.5)</explosionRadiusRange>
        <bombIntervalTicks>18</bombIntervalTicks>
        <warmupTicks>90</warmupTicks>
        <explosionCount>18</explosionCount>
        <randomFireRadius>18</randomFireRadius>
      </li>
    </comps>
    <building>
      <turretGunDef>WNG_Gun_GoauldHeavyPlasmaCannon</turretGunDef>
      <turretBurstWarmupTime>1.2</turretBurstWarmupTime>
      <turretBurstCooldownTime>3.8</turretBurstCooldownTime>
      <turretTopGraphicPath>Things/Building/Security/TurretAutocannon_Base</turretTopGraphicPath>
      <turretTopDrawSize>2.2</turretTopDrawSize>
    </building>
  </ThingDef>

  <ThingDef ParentName="BaseGun" MayRequire="idolord.ONAC">
    <defName>WNG_Gun_GoauldHeavyPlasmaCannon</defName>
    <label>Ha'tak heavy plasma cannon</label>
    <description>The firing assembly of a Ha'tak heavy plasma battery.</description>
    <graphicData>
      <texPath>Things/Item/Equipment/WeaponRanged/ChargeRifle</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <color>(0.85,0.55,0.15)</color>
    </graphicData>
    <statBases>
      <MarketValue>900</MarketValue>
      <Mass>45</Mass>
      <AccuracyTouch>0.35</AccuracyTouch>
      <AccuracyShort>0.72</AccuracyShort>
      <AccuracyMedium>0.86</AccuracyMedium>
      <AccuracyLong>0.80</AccuracyLong>
      <RangedWeapon_Cooldown>3.8</RangedWeapon_Cooldown>
    </statBases>
    <weaponTags><li>TurretGun</li><li>WNG_GoauldShipWeapon</li></weaponTags>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <defaultProjectile>WNG_Projectile_GoauldHeavyPlasma</defaultProjectile>
        <warmupTime>0</warmupTime>
        <range>45.9</range>
        <minRange>6</minRange>
        <burstShotCount>3</burstShotCount>
        <ticksBetweenBurstShots>16</ticksBetweenBurstShots>
        <soundCast>ChargeLance_Fire</soundCast>
        <muzzleFlashScale>12</muzzleFlashScale>
      </li>
    </verbs>
  </ThingDef>

  <ThingDef ParentName="BaseBullet" MayRequire="idolord.ONAC">
    <defName>WNG_Projectile_GoauldHeavyPlasma</defName>
    <label>Ha'tak heavy plasma pulse</label>
    <thingClass>Projectile_Explosive</thingClass>
    <graphicData>
      <texPath>Things/Projectile/Charge_Small</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>TransparentPostLight</shaderType>
      <color>(1,0.62,0.12)</color>
      <drawSize>(0.65,0.65)</drawSize>
    </graphicData>
    <projectile>
      <damageDef>Bomb</damageDef>
      <damageAmountBase>38</damageAmountBase>
      <armorPenetrationBase>0.55</armorPenetrationBase>
      <speed>85</speed>
      <explosionRadius>1.6</explosionRadius>
      <explosionChanceToStartFire>0.12</explosionChanceToStartFire>
      <explosionDamageFalloff>true</explosionDamageFalloff>
    </projectile>
  </ThingDef>
</Defs>
