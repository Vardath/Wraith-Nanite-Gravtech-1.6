<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="ResourceBase">
    <defName>WNG_ReplicatorMatter</defName>
    <label>replicator blocks</label>
    <description>Loose blocks recovered from a destroyed Replicator body. A sufficiently large uncontained pile remains inert for one full day, then gains an increasing chance to reform hostile Replicators. Powered Replicator containment resets and suppresses that danger clock. Recovered blocks can be analyzed at a research bench to establish the colony's first practical understanding of Replicator technology.</description>
    <graphicData><texPath>Things/Item/Resource/Replicator/WNG_ReplicatorMatter</texPath><graphicClass>Graphic_Single</graphicClass></graphicData>
    <stackLimit>250</stackLimit><alwaysHaulable>true</alwaysHaulable><thingCategories><li>ResourcesRaw</li></thingCategories><tickerType>Rare</tickerType>
    <comps>
      <li Class="WraithNaniteGravtech.CompProperties_ReplicatorMatterReassembly">
        <factionDefName>WNG_ReplicatorSwarm</factionDefName><pawnKindDefName>WNG_ReplicatorDrone</pawnKindDefName>
        <minimumStack>10</minimumStack><consumePerPawn>10</consumePerPawn><dormantTicks>60000</dormantTicks><retryTicks>2500</retryTicks><chancePerCheck>0.05</chancePerCheck><chanceGrowthPerDay>0.10</chanceGrowthPerDay><maxChancePerCheck>0.85</maxChancePerCheck><maxPawnsPerWake>2</maxPawnsPerWake><maxHostileReplicatorsPerMap>120</maxHostileReplicatorsPerMap>
      </li>
      <li Class="CompProperties_CompAnalyzableUnlockResearch">
        <analysisID>160912001</analysisID>
        <requiresMechanitor>false</requiresMechanitor>
        <analysisDurationHours>1.5</analysisDurationHours>
        <destroyedOnAnalyzed>false</destroyedOnAnalyzed>
        <completedLetterLabel>Replicator blocks analyzed</completedLetterLabel>
        <completedLetter>Analysis of the recovered Replicator blocks has revealed enough of their modular control and reassembly logic to begin {RESEARCH}.</completedLetter>
        <completedLetterDef>PositiveEvent</completedLetterDef>
        <activateTexPath>UI/Icons/Study</activateTexPath>
        <activateLabelString>Analyze replicator blocks...</activateLabelString>
        <activateDescString>Analyze these recovered Replicator blocks at a research bench to unlock the first Replicator technology study.</activateDescString>
        <jobString>Analyzing replicator blocks.</jobString>
        <guiLabelString>Choose a colonist to analyze the replicator blocks.</guiLabelString>
        <inspectString>Can be analyzed at a research bench to unlock Replicator study.</inspectString>
        <targetingParameters>
          <canTargetLocations>false</canTargetLocations>
          <canTargetPawns>true</canTargetPawns>
          <canTargetBuildings>false</canTargetBuildings>
          <canTargetItems>false</canTargetItems>
          <canTargetAnimals>false</canTargetAnimals>
          <canTargetHumans>true</canTargetHumans>
          <canTargetMechs>false</canTargetMechs>
          <canTargetSubhumans>false</canTargetSubhumans>
          <canTargetEntities>false</canTargetEntities>
          <onlyTargetColonists>true</onlyTargetColonists>
        </targetingParameters>
      </li>
    </comps>
    <statBases><MarketValue>3</MarketValue><Mass>0.08</Mass><Flammability>0</Flammability></statBases>
  </ThingDef>

  <ThingDef ParentName="ResourceBase">
    <defName>WNG_ReplicatorCoreFragment</defName><label>replicator core fragment</label>
    <description>A partially intact Replicator control lattice suitable for later research, containment and reconstruction systems.</description>
    <graphicData><texPath>Things/Item/Resource/Replicator/WNG_ReplicatorCoreFragment</texPath><graphicClass>Graphic_Single</graphicClass></graphicData>
    <stackLimit>25</stackLimit><statBases><MarketValue>90</MarketValue><Mass>0.35</Mass><Flammability>0</Flammability></statBases>
  </ThingDef>

  <ThingDef ParentName="BuildingBase">
    <defName>WNG_ReplicatorContainmentProjector</defName>
    <label>replicator containment projector</label>
    <description>A powered suppression projector for captured Replicator bodies and dangerous Replicator blocks. While powered, uncontrolled Replicators inside its field cannot assimilate or recombine and loose blocks cannot self-assemble.</description>
    <graphicData><texPath>Things/Building/Misc/OrbitalTradeBeacon</texPath><graphicClass>Graphic_Single</graphicClass><drawSize>(1.2,1.2)</drawSize></graphicData>
    <size>(1,1)</size>
    <passability>PassThroughOnly</passability>
    <fillPercent>0.25</fillPercent>
    <pathCost>10</pathCost>
    <designationCategory>WNG</designationCategory>
    <researchPrerequisites><li>WNG_NaniteContainment</li></researchPrerequisites>
    <constructionSkillPrerequisite>6</constructionSkillPrerequisite>
    <costList><Steel>120</Steel><ComponentIndustrial>4</ComponentIndustrial><WNG_ReplicatorCoreFragment>1</WNG_ReplicatorCoreFragment></costList>
    <statBases><WorkToBuild>5500</WorkToBuild><MaxHitPoints>220</MaxHitPoints><Flammability>0.2</Flammability><Beauty>-1</Beauty></statBases>
    <comps>
      <li Class="CompProperties_Power"><basePowerConsumption>900</basePowerConsumption></li>
      <li Class="WraithNaniteGravtech.CompProperties_ReplicatorContainmentProjector"><radius>8.5</radius></li>
    </comps>
  </ThingDef>
</Defs>