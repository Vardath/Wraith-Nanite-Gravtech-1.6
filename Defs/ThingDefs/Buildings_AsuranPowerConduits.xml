<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Asuran themed presentation on RimWorld's native power-transmitter network. -->
  <ThingDef ParentName="PowerConduit">
    <defName>WNG_AsuranPowerConduit</defName>
    <label>Asuran power conduit</label>
    <description>An Ancient-derived conduction lattice reconstructed by Asuran nanites. Functionally it remains a native RimWorld power conduit, joining the ordinary electrical grid instead of creating a separate nanite electricity system.</description>
    <graphicData>
      <texPath>Things/Building/Linked/PowerConduit_Atlas</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <linkType>Transmitter</linkType>
      <linkFlags><li>PowerConduit</li></linkFlags>
      <color>(0.28,0.58,0.78)</color>
      <damageData><rect>(0,0.35,1,0.3)</rect></damageData>
    </graphicData>
    <costList><WNG_NaniteSludge>1</WNG_NaniteSludge><Plasteel>1</Plasteel></costList>
    <comps>
      <li Class="WraithNaniteGravtech.CompProperties_WNGGravshipPartTheme"><theme>Asuran</theme></li>
    </comps>
    <terrainAffordanceNeeded>Substructure</terrainAffordanceNeeded>
    <designationCategory>WNG</designationCategory>
    <uiOrder>2460</uiOrder>
    <researchPrerequisites><li>WNG_AsuranGravships</li></researchPrerequisites>
    <replaceTags><li>Conduit</li></replaceTags>
  </ThingDef>

  <ThingDef ParentName="PowerConduit">
    <defName>WNG_AsuranHiddenPowerConduit</defName>
    <label>hidden Asuran power conduit</label>
    <description>A concealed Ancient-derived electrical lattice integrated beneath Asuran gravship surfaces. It remains a native RimWorld power transmitter while hiding its map graphic in normal view.</description>
    <graphicData>
      <texPath>Things/Building/Linked/PowerConduit_Atlas</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <linkType>Transmitter</linkType>
      <linkFlags><li>PowerConduit</li></linkFlags>
      <color>(0,0,0,0)</color>
      <shaderType>Transparent</shaderType>
    </graphicData>
    <uiIconPath>Things/Building/Linked/HiddenConduit_MenuIcon</uiIconPath>
    <statBases><MaxHitPoints>140</MaxHitPoints><WorkToBuild>280</WorkToBuild><Flammability>0</Flammability><Beauty>0</Beauty></statBases>
    <costList><WNG_NaniteSludge>2</WNG_NaniteSludge><Plasteel>1</Plasteel></costList>
    <comps>
      <li Class="WraithNaniteGravtech.CompProperties_WNGGravshipPartTheme"><theme>Asuran</theme></li>
    </comps>
    <building>
      <isPowerConduit>true</isPowerConduit>
      <ai_chillDestination>false</ai_chillDestination>
      <isInert>true</isInert>
      <isEdifice>false</isEdifice>
      <canLandGravshipOn>true</canLandGravshipOn>
      <canConstructInCorner>true</canConstructInCorner>
      <ai_neverTrashThis>true</ai_neverTrashThis>
      <isTargetable>false</isTargetable>
      <expandHomeArea>false</expandHomeArea>
      <canBeDamagedByAttacks>false</canBeDamagedByAttacks>
      <blueprintGraphicData><texPath>Things/Building/Linked/PowerConduit_Blueprint_Atlas</texPath></blueprintGraphicData>
    </building>
    <terrainAffordanceNeeded>Substructure</terrainAffordanceNeeded>
    <designationCategory>WNG</designationCategory>
    <uiOrder>2461</uiOrder>
    <constructEffect>ConstructDirt</constructEffect>
    <researchPrerequisites><li>WNG_AsuranGravships</li></researchPrerequisites>
    <replaceTags><li>Conduit</li></replaceTags>
  </ThingDef>
</Defs>
