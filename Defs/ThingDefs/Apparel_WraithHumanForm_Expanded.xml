    <apparel><bodyPartGroups><li>Torso</li><li>Neck</li><li>Shoulders</li><li>Arms</li><li>Legs</li></bodyPartGroups><layers><li>Shell</li></layers><wornGraphicPath>Things/Pawn/Humanlike/Apparel/Precursor/WNG_HumanFormCombatArmor</wornGraphicPath><tags><li>WNG_HumanFormArmor</li><li>WNG_PrecursorArmor</li></tags><defaultOutfitTags><li>Soldier</li><li>Spacefarer</li></defaultOutfitTags></apparel>
    <recipeMaker><researchPrerequisite>WNG_PrecursorFabrication</researchPrerequisite><workSkill>Crafting</workSkill><skillRequirements><Crafting>8</Crafting></skillRequirements><recipeUsers Inherit="False"><li>WNG_PrecursorFabricator</li></recipeUsers></recipeMaker>
