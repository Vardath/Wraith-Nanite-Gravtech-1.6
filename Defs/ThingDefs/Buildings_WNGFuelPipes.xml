    <thingClass>Building</thingClass><category>Building</category><noRightClickDraftAttack>true</noRightClickDraftAttack>
    <graphicData>
      <texPath>Things/Building/Linked/PowerConduit_Atlas</texPath><graphicClass>Graphic_Single</graphicClass><linkType>Basic</linkType><linkFlags><li>Custom2</li></linkFlags>
      <color>(0.28,0.58,0.78)</color><damageData><rect>(0,0.35,1,0.3)</rect></damageData>
    </graphicData>
    <uiIconPath>Things/Building/Linked/PowerConduit_MenuIcon</uiIconPath><uiIconScale>0.7</uiIconScale>
    <building>
      <isInert>true</isInert><isEdifice>false</isEdifice><ai_chillDestination>false</ai_chillDestination><canLandGravshipOn>true</canLandGravshipOn><canConstructInCorner>true</canConstructInCorner>
      <blueprintGraphicData><texPath>Things/Building/Linked/PowerConduit_Blueprint_Atlas</texPath></blueprintGraphicData>
    </building>
    <drawerType>MapMeshOnly</drawerType><altitudeLayer>Conduits</altitudeLayer><passability>Standable</passability>
    <leaveResourcesWhenKilled>false</leaveResourcesWhenKilled><resourcesFractionWhenDeconstructed>0</resourcesFractionWhenDeconstructed>
    <statBases><MaxHitPoints>100</MaxHitPoints><WorkToBuild>50</WorkToBuild><Flammability>0</Flammability><Beauty>0</Beauty></statBases>
    <costList><WNG_NaniteSludge>1</WNG_NaniteSludge><Plasteel>1</Plasteel></costList>
    <comps><li Class="WraithNaniteGravtech.CompProperties_WNGFuelPipe"><family>Asuran</family></li></comps>
    <placeWorkers><li>WraithNaniteGravtech.PlaceWorker_WNGFuelPipe</li></placeWorkers>
    <rotatable>false</rotatable><selectable>true</selectable><neverMultiSelect>true</neverMultiSelect><terrainAffordanceNeeded>Substructure</terrainAffordanceNeeded>
    <designationCategory>WNG</designationCategory><uiOrder>2450</uiOrder><constructEffect>ConstructMetal</constructEffect><clearBuildingArea>false</clearBuildingArea>
    <researchPrerequisites><li>WNG_AsuranGravships</li></researchPrerequisites><replaceTags><li>WNG_AsuranFuelPipe</li></replaceTags>
  </ThingDef>

  <ThingDef ParentName="BuildingBase">
    <defName>WNG_AsuranHiddenNaniteSludgePipe</defName>
    <label>hidden Asuran nanite-sludge pipe</label>
