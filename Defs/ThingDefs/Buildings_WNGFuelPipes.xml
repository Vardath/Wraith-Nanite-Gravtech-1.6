<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    WNG fuel pipes are their own physical network, not electrical conduits. They use RimWorld's
    generic linked-atlas drawing with separate custom link flags for Wraith and Asuran families.
    The visible graphics currently reuse the vanilla conduit atlas as mechanics placeholder art.
  -->

  <ThingDef ParentName="BuildingBase">
    <defName>WNG_WraithBioSludgePipe</defName>
    <label>Wraith bio-sludge pipe</label>
    <description>An exposed living conduit carrying Wraith bio sludge between a gravship reservoir and its living grav engine. A Wraith fuel tank contributes to Odyssey's native fuel total only while a continuous same-family pipe path reaches the engine.</description>
    <thingClass>Building</thingClass>
    <category>Building</category>
    <noRightClickDraftAttack>true</noRightClickDraftAttack>
    <graphicData>
      <texPath>Things/Building/Linked/PowerConduit_Atlas</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <linkType>Basic</linkType>
      <linkFlags><li>Custom1</li></linkFlags>
      <color>(0.38,0.18,0.28)</color>
      <damageData><rect>(0,0.35,1,0.3)</rect></damageData>
    </graphicData>
    <uiIconPath>Things/Building/Linked/PowerConduit_MenuIcon</uiIconPath>
    <uiIconScale>0.7</uiIconScale>
    <building>
      <isInert>true</isInert>
      <isEdifice>false</isEdifice>
      <ai_chillDestination>false</ai_chillDestination>
      <canLandGravshipOn>true</canLandGravshipOn>
      <canConstructInCorner>true</canConstructInCorner>
      <blueprintGraphicData><texPath>Things/Building/Linked/PowerConduit_Blueprint_Atlas</texPath></blueprintGraphicData>
    </building>
    <drawerType>MapMeshOnly</drawerType>
    <altitudeLayer>Conduits</altitudeLayer>
    <passability>Standable</passability>
    <leaveResourcesWhenKilled>false</leaveResourcesWhenKilled>
    <resourcesFractionWhenDeconstructed>0</resourcesFractionWhenDeconstructed>
    <statBases><MaxHitPoints>85</MaxHitPoints><WorkToBuild>50</WorkToBuild><Flammability>0.15</Flammability><Beauty>-1</Beauty></statBases>
    <costList><WNG_WraithBioSludge>1</WNG_WraithBioSludge><Steel>1</Steel></costList>
    <comps><li Class="WraithNaniteGravtech.CompProperties_WNGFuelPipe"><family>Wraith</family></li></comps>
    <placeWorkers><li>WraithNaniteGravtech.PlaceWorker_WNGFuelPipe</li></placeWorkers>
    <rotatable>false</rotatable><selectable>true</selectable><neverMultiSelect>true</neverMultiSelect>
    <terrainAffordanceNeeded>Substructure</terrainAffordanceNeeded>
    <designationCategory>WNG</designationCategory><uiOrder>2440</uiOrder><constructEffect>ConstructMetal</constructEffect><clearBuildingArea>false</clearBuildingArea>
    <researchPrerequisites><li>WNG_WraithGravships</li></researchPrerequisites>
    <replaceTags><li>WNG_WraithFuelPipe</li></replaceTags>
  </ThingDef>

  <ThingDef ParentName="BuildingBase">
    <defName>WNG_WraithHiddenBioSludgePipe</defName>
    <label>hidden Wraith bio-sludge pipe</label>
    <description>A concealed living bio-sludge conduit with the same Wraith fuel-network function as an exposed pipe. It is hidden in normal map view and may replace exposed Wraith fuel piping without changing the network family.</description>
    <thingClass>Building</thingClass><category>Building</category><noRightClickDraftAttack>true</noRightClickDraftAttack>
    <graphicData>
      <texPath>Things/Building/Linked/PowerConduit_Atlas</texPath><graphicClass>Graphic_Single</graphicClass><linkType>Basic</linkType><linkFlags><li>Custom1</li></linkFlags>
      <color>(0,0,0,0)</color><shaderType>Transparent</shaderType>
    </graphicData>
    <uiIconPath>Things/Building/Linked/HiddenConduit_MenuIcon</uiIconPath><uiIconScale>0.7</uiIconScale>
    <building>
      <isInert>true</isInert><isEdifice>false</isEdifice><ai_chillDestination>false</ai_chillDestination><canLandGravshipOn>true</canLandGravshipOn><canConstructInCorner>true</canConstructInCorner>
      <ai_neverTrashThis>true</ai_neverTrashThis><isTargetable>false</isTargetable><expandHomeArea>false</expandHomeArea><canBeDamagedByAttacks>false</canBeDamagedByAttacks>
      <blueprintGraphicData><texPath>Things/Building/Linked/PowerConduit_Blueprint_Atlas</texPath></blueprintGraphicData>
    </building>
    <drawerType>MapMeshOnly</drawerType><altitudeLayer>Conduits</altitudeLayer><passability>Standable</passability>
    <leaveResourcesWhenKilled>false</leaveResourcesWhenKilled><resourcesFractionWhenDeconstructed>0</resourcesFractionWhenDeconstructed>
    <statBases><MaxHitPoints>120</MaxHitPoints><WorkToBuild>300</WorkToBuild><Flammability>0</Flammability><Beauty>0</Beauty></statBases>
    <costList><WNG_WraithBioSludge>2</WNG_WraithBioSludge><Steel>1</Steel></costList>
    <comps><li Class="WraithNaniteGravtech.CompProperties_WNGFuelPipe"><family>Wraith</family></li></comps>
    <placeWorkers><li>WraithNaniteGravtech.PlaceWorker_WNGFuelPipe</li></placeWorkers>
    <rotatable>false</rotatable><selectable>true</selectable><neverMultiSelect>true</neverMultiSelect><terrainAffordanceNeeded>Substructure</terrainAffordanceNeeded>
    <designationCategory>WNG</designationCategory><uiOrder>2441</uiOrder><constructEffect>ConstructDirt</constructEffect><clearBuildingArea>false</clearBuildingArea>
    <researchPrerequisites><li>WNG_WraithGravships</li></researchPrerequisites><replaceTags><li>WNG_WraithFuelPipe</li></replaceTags>
  </ThingDef>

  <ThingDef ParentName="BuildingBase">
