    <rotatable>false</rotatable>
    <statBases>
      <MarketValue>420</MarketValue>
      <Mass>0.05</Mass>
      <MaxHitPoints>45</MaxHitPoints>
    </statBases>
    <techLevel>Spacer</techLevel>
    <recipeMaker>
      <researchPrerequisite>WNG_HybridStabilisation</researchPrerequisite>
      <recipeUsers><li>DrugLab</li></recipeUsers>
