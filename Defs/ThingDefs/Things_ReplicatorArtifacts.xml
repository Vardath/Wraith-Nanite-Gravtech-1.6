      <texPath>Things/Item/Artifact/Replicator/WNG_DormantChildsToy</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(0.85,0.85)</drawSize>
    </graphicData>
    <thingCategories><li>Manufactured</li></thingCategories>
    <stackLimit>1</stackLimit>
    <alwaysHaulable>true</alwaysHaulable>
    <tradeability>All</tradeability>
    <statBases>
      <MarketValue>950</MarketValue>
      <Mass>0.65</Mass>
      <Flammability>0</Flammability>
      <DeteriorationRate>0</DeteriorationRate>
    </statBases>
    <comps>
      <li Class="WraithNaniteGravtech.CompProperties_DormantChildsToy">
        <pawnKindDef>WNG_ReplicatorDrone</pawnKindDef>
      </li>
    </comps>
  </ThingDef>
</Defs>
