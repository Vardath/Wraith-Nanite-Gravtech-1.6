<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="BuildingBase">
    <defName>WNG_WraithAtmosphericOrgan</defName>
    <label>Wraith atmospheric organ</label>
    <description>A living Wraith ship component that uses Odyssey's native oxygen-pusher behavior to restore atmosphere inside enclosed rooms in vacuum.</description>
    <tickerType>Rare</tickerType>
    <rotatable>true</rotatable>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories><li>BuildingsMisc</li></thingCategories>
    <uiIconPath>Things/Building/OxygenPump/OxygenPump_MenuIcon</uiIconPath>
    <graphicData>
      <texPath>Things/Building/OxygenPump/OxygenPump</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawOffsetNorth>(0,0,0.9)</drawOffsetNorth>
      <drawOffsetSouth>(0,0,-0.9)</drawOffsetSouth>
      <drawOffsetWest>(-0.9,0,0)</drawOffsetWest>
      <drawOffsetEast>(0.9,0,0)</drawOffsetEast>
      <damageData><enabled>false</enabled></damageData>
      <color>(0.38,0.18,0.28)</color>
    </graphicData>
    <altitudeLayer>BuildingOnTop</altitudeLayer>
    <designationCategory>WNG</designationCategory>
    <statBases>
      <MarketValue>220</MarketValue>
      <MaxHitPoints>120</MaxHitPoints>
      <WorkToBuild>2400</WorkToBuild>
      <Mass>8</Mass>
      <Flammability>0.15</Flammability>
    </statBases>
    <passability>Standable</passability>
    <terrainAffordanceNeeded IsNull="True" />
    <pathCost>0</pathCost>
    <overrideMinifiedRot>North</overrideMinifiedRot>
    <minifiedDrawOffset>(0,0,0.2)</minifiedDrawOffset>
    <building>
      <isEdifice>false</isEdifice>
      <isAttachment>true</isAttachment>
      <expandHomeArea>false</expandHomeArea>
    </building>
    <costList>
      <WNG_WraithBioSludge>10</WNG_WraithBioSludge>
      <Steel>30</Steel>
      <Plasteel>20</Plasteel>
    </costList>
    <placeWorkers><li>Placeworker_AttachedToWall</li></placeWorkers>
    <comps>
      <li Class="CompProperties_Power"><compClass>CompPowerTrader</compClass><basePowerConsumption>130</basePowerConsumption></li>
      <li Class="CompProperties_LowPowerUnlessVacuum"><lowPowerConsumptionFactor>0.1</lowPowerConsumptionFactor></li>
      <li Class="CompProperties_Flickable" />
      <li Class="CompProperties_OxygenPusher"><requiresPower>true</requiresPower><airPerSecondPerHundredCells>0.01</airPerSecondPerHundredCells></li>
      <li Class="CompProperties_AmbientSound"><sound>OxygenPump_Ambient</sound><disabledOnUnpowered>true</disabledOnUnpowered></li>
      <li Class="WraithNaniteGravtech.CompProperties_WNGGravshipPartTheme"><theme>Wraith</theme></li>
    </comps>
    <researchPrerequisites><li>WNG_WraithGravships</li></researchPrerequisites>
    <constructionSkillPrerequisite>6</constructionSkillPrerequisite>
    <uiOrder>2415</uiOrder>
  </ThingDef>
</Defs>
