<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="BuildingBase">
    <defName>WNG_WallEMPContainmentPulser</defName>
    <label>wall EMP containment pulser</label>
    <description>A compact powered EMP emitter intended for Replicator-block storage rooms. When powered inside an enclosed room, it suppresses that entire room: loose Replicator blocks cannot reform and uncontrolled Replicators cannot assimilate or recombine there. If power or enclosure is lost, stored blocks begin a fresh one-day dormancy before reformation risk can return.</description>
    <graphicData>
      <texPath>Things/Building/Misc/OrbitalTradeBeacon</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(0.65,0.65)</drawSize>
    </graphicData>
    <size>(1,1)</size>
    <passability>PassThroughOnly</passability>
    <fillPercent>0.08</fillPercent>
    <pathCost>0</pathCost>
    <designationCategory>Misc</designationCategory>
    <researchPrerequisites><li>WNG_NaniteContainment</li></researchPrerequisites>
    <constructionSkillPrerequisite>5</constructionSkillPrerequisite>
    <costList>
      <Steel>45</Steel>
      <ComponentIndustrial>2</ComponentIndustrial>
    </costList>
    <statBases>
      <WorkToBuild>2200</WorkToBuild>
      <MaxHitPoints>100</MaxHitPoints>
      <Flammability>0.25</Flammability>
    </statBases>
    <comps>
      <li Class="CompProperties_Power">
        <basePowerConsumption>450</basePowerConsumption>
      </li>
      <li Class="WraithNaniteGravtech.CompProperties_ReplicatorContainmentProjector">
        <radius>0</radius>
        <roomWide>true</roomWide>
        <requireEnclosedRoom>true</requireEnclosedRoom>
      </li>
    </comps>
  </ThingDef>
</Defs>
