<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    Fresh Ha'tak gravship core family. ONAC owns the Goa'uld resource/research economy when present;
    these Defs therefore remain ONAC-gated until Vardath defines a standalone Goa'uld ship economy.
    Graphics are mechanics-validation placeholders pending the professional Ha'tak art pass.
  -->

  <ThingDef ParentName="BuildingBase" MayRequire="idolord.ONAC">
    <defName>WNG_GoauldGravEngineSeed</defName>
    <label>Ha'tak grav engine</label>
    <description>A Goa'uld mothership drive core built around naquadah power and gravitic control technology. On completion it becomes Odyssey's exact native grav engine while retaining a Goa'uld technology identity, preserving native gravship discovery, launch and travel behavior.</description>
    <tickerType>Normal</tickerType>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <texPath>Things/Building/GravEngine/GravEngine</texPath>
      <drawSize>(3,3)</drawSize>
      <color>(0.68,0.48,0.20)</color>
    </graphicData>
    <statBases>
      <MaxHitPoints>700</MaxHitPoints>
      <WorkToBuild>18000</WorkToBuild>
      <Flammability>0</Flammability>
      <Mass>34</Mass>
    </statBases>
    <size>(3,3)</size>
    <fillPercent>0.6</fillPercent>
    <passability>PassThroughOnly</passability>
    <pathCost>20</pathCost>
    <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
    <designationCategory>ONAC_Architect</designationCategory>
    <researchPrerequisites><li>WNG_GoauldGravships</li></researchPrerequisites>
    <constructionSkillPrerequisite>9</constructionSkillPrerequisite>
    <costList>
      <ONAC_Naquadah>120</ONAC_Naquadah>
      <Plasteel>220</Plasteel>
      <Gold>60</Gold>
      <ComponentSpacer>10</ComponentSpacer>
    </costList>
    <placeWorkers><li>WraithNaniteGravtech.PlaceWorker_WNGSingleGravEngine</li></placeWorkers>
    <comps>
      <li Class="WraithNaniteGravtech.CompProperties_WNGGravEngineSeed">
        <theme>Goauld</theme>
        <engineName>Ha'tak grav engine</engineName>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="BuildingBase" MayRequire="idolord.ONAC">
    <defName>WNG_GoauldHullSeed</defName>
    <label>Ha'tak hull</label>
    <description>A reinforced Goa'uld mothership hull section. On completion it resolves into Odyssey's exact native gravship hull so airtight-room behavior and native angled/cut-corner geometry remain functional while WNG records its Goa'uld architecture.</description>
    <tickerType>Normal</tickerType>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <texPath>Things/Building/Linked/GravshipHull/GravshipHull_Atlas</texPath>
      <color>(0.62,0.43,0.18)</color>
    </graphicData>
    <statBases>
      <MaxHitPoints>380</MaxHitPoints>
      <WorkToBuild>600</WorkToBuild>
      <Flammability>0</Flammability>
    </statBases>
    <fillPercent>1</fillPercent>
    <passability>Impassable</passability>
    <holdsRoof>true</holdsRoof>
    <blockLight>true</blockLight>
    <terrainAffordanceNeeded>Substructure</terrainAffordanceNeeded>
    <designationCategory>ONAC_Architect</designationCategory>
    <researchPrerequisites><li>WNG_GoauldGravships</li></researchPrerequisites>
    <costList>
      <ONAC_Naquadah>2</ONAC_Naquadah>
      <Plasteel>5</Plasteel>
    </costList>
    <comps>
      <li Class="WraithNaniteGravtech.CompProperties_WNGGravHullSeed"><theme>Goauld</theme></li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="GravshipComponentBase" MayRequire="idolord.ONAC">
    <defName>WNG_GoauldPeltac</defName>
    <label>Ha'tak pel'tac</label>
    <description>The command and flight-control station of a Goa'uld mothership. It represents the pel'tac bridge and uses Odyssey's native pilot-console workflow for gravship launch, destination selection and operation.</description>
    <graphicData>
      <graphicClass>Graphic_Multi</graphicClass>
      <texPath>Things/Building/PilotConsole/PilotConsole</texPath>
      <drawSize>(3.7,2.6)</drawSize>
      <color>(0.72,0.52,0.22)</color>
    </graphicData>
    <tickerType>Normal</tickerType>
    <statBases>
      <MaxHitPoints>280</MaxHitPoints>
      <Mass>48</Mass>
      <Flammability>0</Flammability>
      <Beauty>3</Beauty>
      <WorkToBuild>3800</WorkToBuild>
    </statBases>
    <size>(3,2)</size>
    <rotatable>true</rotatable>
    <fillPercent>0.4</fillPercent>
    <passability>PassThroughOnly</passability>
    <pathCost>14</pathCost>
    <canOverlapZones>false</canOverlapZones>
    <costList>
      <ONAC_Naquadah>18</ONAC_Naquadah>
      <Plasteel>90</Plasteel>
      <Gold>25</Gold>
      <ComponentIndustrial>5</ComponentIndustrial>
    </costList>
    <resourcesFractionWhenDeconstructed>0.5</resourcesFractionWhenDeconstructed>
    <constructionSkillPrerequisite>7</constructionSkillPrerequisite>
    <designationCategory>ONAC_Architect</designationCategory>
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <researchPrerequisites><li>WNG_GoauldGravships</li></researchPrerequisites>
    <terrainAffordanceNeeded>Substructure</terrainAffordanceNeeded>
    <comps>
      <li Class="CompProperties_GravshipFacility">
        <compClass>CompPilotConsole</compClass>
        <componentTypeDef>Controls</componentTypeDef>
        <requiresLOS>false</requiresLOS>
        <showMaxSimultaneous>false</showMaxSimultaneous>
        <maxSimultaneous>1</maxSimultaneous>
        <maxDistance>200</maxDistance>
      </li>
      <li Class="RimWorld.CompProperties_Breakdownable" />
      <li Class="WraithNaniteGravtech.CompProperties_WNGGravshipPartTheme"><theme>Goauld</theme></li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="FuelTankBase" MayRequire="idolord.ONAC">
    <defName>WNG_GoauldNaquadriaTank</defName>
    <label>Ha'tak liquid-Naquadria reservoir</label>
    <description>A compact Goa'uld mothership propellant reservoir holding ONAC liquid Naquadria. It feeds Odyssey's native gravship fuel system only through a continuous same-family Ha'tak fuel-pipe path to the themed engine.</description>
    <graphicData>
      <graphicClass>Graphic_Multi</graphicClass>
      <texPath>Things/Building/ChemfuelTank/ChemfuelTank</texPath>
      <drawSize>(2,2)</drawSize>
      <color>(0.72,0.52,0.22)</color>
    </graphicData>
    <statBases><MaxHitPoints>320</MaxHitPoints><Mass>28</Mass><Flammability>0</Flammability><Beauty>1</Beauty><WorkToBuild>2600</WorkToBuild></statBases>
    <size>(2,2)</size>
    <costList><ONAC_Naquadah>18</ONAC_Naquadah><Plasteel>90</Plasteel><Gold>10</Gold></costList>
    <designationCategory>ONAC_Architect</designationCategory>
    <researchPrerequisites><li>WNG_GoauldGravships</li></researchPrerequisites>
    <comps>
      <li Class="CompProperties_Refuelable">
        <fuelCapacity>250</fuelCapacity>
        <targetFuelLevelConfigurable>true</targetFuelLevelConfigurable>
        <initialConfigurableTargetFuelLevel>250</initialConfigurableTargetFuelLevel>
        <fuelFilter><thingDefs><li>ONAC_LiquidNaquadria</li></thingDefs></fuelFilter>
        <fuelLabel>Liquid Naquadria</fuelLabel><fuelGizmoLabel>Liquid Naquadria</fuelGizmoLabel>
        <consumeFuelOnlyWhenUsed>true</consumeFuelOnlyWhenUsed><autoRefuelPercent>1</autoRefuelPercent>
        <showFuelGizmo>true</showFuelGizmo><drawOutOfFuelOverlay>false</drawOutOfFuelOverlay>
        <showAllowAutoRefuelToggle>true</showAllowAutoRefuelToggle><canEjectFuel>true</canEjectFuel><drawFuelGaugeInMap>false</drawFuelGaugeInMap>
      </li>
      <li Class="WraithNaniteGravtech.CompProperties_WNGGravshipPartTheme"><theme>Goauld</theme></li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="FuelTankBase" MayRequire="idolord.ONAC">
    <defName>WNG_GoauldLargeNaquadriaTank</defName>
    <label>large Ha'tak liquid-Naquadria reservoir</label>
    <description>A high-capacity Goa'uld mothership propellant reservoir using ONAC liquid Naquadria and Odyssey's native gravship fuel accounting.</description>
    <graphicData>
      <graphicClass>Graphic_Multi</graphicClass>
      <texPath>Things/Building/LargeChemfuelTank/LargeChemfuelTank</texPath>
      <drawSize>(3,3)</drawSize>
      <color>(0.72,0.52,0.22)</color>
    </graphicData>
    <statBases><MaxHitPoints>480</MaxHitPoints><Mass>66</Mass><Flammability>0</Flammability><Beauty>1</Beauty><WorkToBuild>4200</WorkToBuild></statBases>
    <size>(3,3)</size>
    <costList><ONAC_Naquadah>40</ONAC_Naquadah><Plasteel>150</Plasteel><Gold>18</Gold><ComponentIndustrial>2</ComponentIndustrial></costList>
    <designationCategory>ONAC_Architect</designationCategory>
    <researchPrerequisites><li>WNG_GoauldGravships</li></researchPrerequisites>
    <comps>
      <li Class="CompProperties_Refuelable">
        <fuelCapacity>750</fuelCapacity>
        <targetFuelLevelConfigurable>true</targetFuelLevelConfigurable>
        <initialConfigurableTargetFuelLevel>750</initialConfigurableTargetFuelLevel>
        <fuelFilter><thingDefs><li>ONAC_LiquidNaquadria</li></thingDefs></fuelFilter>
        <fuelLabel>Liquid Naquadria</fuelLabel><fuelGizmoLabel>Liquid Naquadria</fuelGizmoLabel>
        <consumeFuelOnlyWhenUsed>true</consumeFuelOnlyWhenUsed><autoRefuelPercent>1</autoRefuelPercent>
        <showFuelGizmo>true</showFuelGizmo><drawOutOfFuelOverlay>false</drawOutOfFuelOverlay>
        <showAllowAutoRefuelToggle>true</showAllowAutoRefuelToggle><canEjectFuel>true</canEjectFuel><drawFuelGaugeInMap>false</drawFuelGaugeInMap>
      </li>
      <li Class="WraithNaniteGravtech.CompProperties_WNGGravshipPartTheme"><theme>Goauld</theme></li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="ThrusterBase" MayRequire="idolord.ONAC">
    <defName>WNG_GoauldSmallSublightDrive</defName>
    <label>Ha'tak sublight drive</label>
    <description>A compact Goa'uld sublight propulsion unit adapted to Odyssey's native gravship thruster mechanics. It contributes direction-sensitive thrust and gravship range while retaining Ha'tak technology-family isolation.</description>
    <graphicData><graphicClass>Graphic_Multi</graphicClass><texPath>Things/Building/SmallThruster/SmallThruster</texPath><drawSize>(1.1,2.2)</drawSize><color>(0.72,0.52,0.22)</color></graphicData>
    <statBases><MaxHitPoints>390</MaxHitPoints><Flammability>0</Flammability><Beauty>1</Beauty><WorkToBuild>9000</WorkToBuild><Mass>18</Mass></statBases>
    <size>(1,2)</size><constructionSkillPrerequisite>7</constructionSkillPrerequisite>
    <costList><ONAC_Naquadah>28</ONAC_Naquadah><Plasteel>105</Plasteel><ComponentIndustrial>4</ComponentIndustrial></costList>
    <researchPrerequisites><li>WNG_GoauldGravships</li></researchPrerequisites><designationCategory>ONAC_Architect</designationCategory>
    <comps>
      <li Class="CompProperties_GravshipThruster">
        <statOffsets><GravshipRange>11</GravshipRange></statOffsets><componentTypeDef>Thruster</componentTypeDef>
        <exclusionAreaSize>(1,0,5)</exclusionAreaSize><exclusionAreaOffset>(0,0,-5)</exclusionAreaOffset><directionInfluence>22</directionInfluence>
        <flameSize>4</flameSize><flameOffsetsPerDirection><li>(0,0,0.5)</li><li>(0,0,0.5)</li><li>(0,0,0.5)</li><li>(0,0,0.5)</li></flameOffsetsPerDirection>
        <flameShaderType>MoteGlow</flameShaderType><flameShaderParameters><_MainTex>/Things/Mote/SmallThruster_Burn</_MainTex></flameShaderParameters>
        <requiresLOS>false</requiresLOS><maxSimultaneous>4</maxSimultaneous><maxDistance>500</maxDistance>
        <exhaustSettings>
          <exhaustFleckDef>GravshipThrusterExhaust</exhaustFleckDef><emissionsPerSecond>40</emissionsPerSecond><spawnRadiusRange>0~0.5</spawnRadiusRange>
          <velocity>(0,0,-20)</velocity><velocityRotationRange>-10~10</velocityRotationRange><velocityMultiplierRange>0.8~1.2</velocityMultiplierRange>
          <rotationOverTimeRange>-180~180</rotationOverTimeRange><scaleRange>1.5~3</scaleRange>
        </exhaustSettings>
      </li>
      <li Class="WraithNaniteGravtech.CompProperties_WNGGravshipPartTheme"><theme>Goauld</theme></li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="ThrusterBase" MayRequire="idolord.ONAC">
    <defName>WNG_GoauldLargeSublightDrive</defName>
    <label>large Ha'tak sublight drive</label>
    <description>A high-output Goa'uld mothership sublight engine using Odyssey's native direction, exclusion-zone and range behavior.</description>
    <graphicData><graphicClass>Graphic_Multi</graphicClass><texPath>Things/Building/LateralThruster/LateralThruster</texPath><drawSize>(2.2,2.2)</drawSize><color>(0.72,0.52,0.22)</color></graphicData>
    <statBases><MaxHitPoints>700</MaxHitPoints><Flammability>0</Flammability><Beauty>1</Beauty><WorkToBuild>14000</WorkToBuild><Mass>30</Mass></statBases>
    <size>(2,2)</size><constructionSkillPrerequisite>8</constructionSkillPrerequisite>
    <costList><ONAC_Naquadah>52</ONAC_Naquadah><Plasteel>170</Plasteel><ComponentIndustrial>6</ComponentIndustrial></costList>
    <researchPrerequisites><li>WNG_GoauldGravships</li></researchPrerequisites><designationCategory>ONAC_Architect</designationCategory>
    <comps>
      <li Class="CompProperties_GravshipThruster">
        <statOffsets><GravshipRange>17</GravshipRange></statOffsets><componentTypeDef>Thruster</componentTypeDef>
        <exclusionAreaSize>(2,0,7)</exclusionAreaSize><exclusionAreaOffset>(0,0,-7)</exclusionAreaOffset><directionInfluence>32</directionInfluence>
        <flameSize>4</flameSize><flameOffsetsPerDirection><li>(0,0,1)</li><li>(0,0,0.5)</li><li>(0,0,0.5)</li><li>(0,0,0.5)</li></flameOffsetsPerDirection>
        <flameShaderType>MoteGlow</flameShaderType><flameShaderParameters><_MainTex>/Things/Mote/LargeThruster_Burn</_MainTex></flameShaderParameters>
        <requiresLOS>false</requiresLOS><maxSimultaneous>6</maxSimultaneous><maxDistance>500</maxDistance>
        <exhaustSettings>
          <exhaustFleckDef>GravshipThrusterExhaust</exhaustFleckDef><emissionsPerSecond>40</emissionsPerSecond><spawnRadiusRange>0~0.5</spawnRadiusRange>
          <velocity>(0,0,-20)</velocity><velocityRotationRange>-10~10</velocityRotationRange><velocityMultiplierRange>0.8~1.2</velocityMultiplierRange>
          <rotationOverTimeRange>-180~180</rotationOverTimeRange><scaleRange>3~5</scaleRange>
        </exhaustSettings>
      </li>
      <li Class="WraithNaniteGravtech.CompProperties_WNGGravshipPartTheme"><theme>Goauld</theme></li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="GravshipComponentBase" MayRequire="idolord.ONAC">
    <defName>WNG_GoauldFieldProjector</defName>
    <label>Ha'tak gravitic field projector</label>
    <description>A Goa'uld gravitic projector that expands the substructure area and supported mass of a Ha'tak using Odyssey's native gravship footprint mechanics.</description>
    <graphicData><graphicClass>Graphic_Single</graphicClass><texPath>Things/Building/GravFieldExtender</texPath><color>(0.72,0.52,0.22)</color></graphicData>
    <statBases><MaxHitPoints>320</MaxHitPoints><Mass>14</Mass><Flammability>0</Flammability><WorkToBuild>2100</WorkToBuild></statBases>
    <fillPercent>0.4</fillPercent><passability>PassThroughOnly</passability><pathCost>14</pathCost>
    <designationCategory>ONAC_Architect</designationCategory><constructionSkillPrerequisite>7</constructionSkillPrerequisite><resourcesFractionWhenDeconstructed>0.5</resourcesFractionWhenDeconstructed>
    <researchPrerequisites><li>WNG_GoauldGravships</li></researchPrerequisites>
    <costList><ONAC_Naquadah>20</ONAC_Naquadah><Plasteel>70</Plasteel><ComponentIndustrial>2</ComponentIndustrial></costList>
    <terrainAffordanceNeeded>Substructure</terrainAffordanceNeeded><placeWorkers><li>PlaceWorker_InRangeOfGravEngine</li></placeWorkers>
    <comps>
      <li Class="CompProperties_SubstructureFootprint"><radius>16.9</radius></li>
      <li Class="CompProperties_GravshipFacility"><statOffsets><SubstructureSupport>300</SubstructureSupport></statOffsets><requiresLOS>false</requiresLOS><maxSimultaneous>6</maxSimultaneous><maxDistance>18.9</maxDistance><onlyRequiresLooseConnection>true</onlyRequiresLooseConnection></li>
      <li Class="WraithNaniteGravtech.CompProperties_WNGGravshipPartTheme"><theme>Goauld</theme></li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="GravshipComponentBase" MayRequire="idolord.ONAC">
    <defName>WNG_GoauldShieldGenerator</defName>
    <label>Ha'tak shield generator</label>
    <description>A powerful Goa'uld mothership energy-shield generator using Odyssey's native gravship projectile-interceptor behavior. It is a true powered defensive shield, matching the Ha'tak's canonical reliance on strong energy shields rather than living-hull regeneration.</description>
    <graphicData><graphicClass>Graphic_Single</graphicClass><texPath>Things/Building/GravshipShieldGenerator/GravshipShieldGenerator</texPath><drawSize>(3,3)</drawSize><color>(0.72,0.52,0.22)</color></graphicData>
    <drawerType>MapMeshAndRealTime</drawerType><drawOffscreen>true</drawOffscreen><tickerType>Normal</tickerType>
    <statBases><MaxHitPoints>420</MaxHitPoints><Flammability>0</Flammability><Mass>110</Mass><WorkToBuild>14000</WorkToBuild></statBases>
    <size>(3,3)</size><fillPercent>0.6</fillPercent><passability>PassThroughOnly</passability><pathCost>20</pathCost><canOverlapZones>false</canOverlapZones>
    <terrainAffordanceNeeded>Substructure</terrainAffordanceNeeded><specialDisplayRadius>29.9</specialDisplayRadius>
    <designationCategory>ONAC_Architect</designationCategory><constructionSkillPrerequisite>9</constructionSkillPrerequisite><researchPrerequisites><li>WNG_GoauldGravships</li></researchPrerequisites>
    <costList><ONAC_Naquadah>65</ONAC_Naquadah><Plasteel>180</Plasteel><Gold>40</Gold><ComponentSpacer>7</ComponentSpacer></costList>
    <comps>
      <li Class="CompProperties_GravshipFacility"><requiresLOS>false</requiresLOS><maxSimultaneous>2</maxSimultaneous><maxDistance>500</maxDistance></li>
      <li Class="CompProperties_Flickable" />
      <li Class="CompProperties_Power"><compClass>CompPowerTrader</compClass><basePowerConsumption>650</basePowerConsumption></li>
      <li Class="CompProperties_Interactable">
        <compClass>CompInteractable_GravshipShieldGenerator</compClass><ticksToActivate>120</ticksToActivate><jobString>activate</jobString>
        <activateTexPath>UI/Commands/ActivateGravshipShield</activateTexPath><soundActivate>GravshipShieldGenerator_Activate</soundActivate><requiresPower>false</requiresPower>
        <targetingParameters><canTargetBuildings>false</canTargetBuildings><canTargetAnimals>false</canTargetAnimals><canTargetMechs>false</canTargetMechs><onlyTargetControlledPawns>true</onlyTargetControlledPawns></targetingParameters>
      </li>
      <li Class="CompProperties_ProjectileInterceptor">
        <compClass>CompGravshipShieldGenerator</compClass><radius>29.9</radius><interceptGroundProjectiles>true</interceptGroundProjectiles><interceptAirProjectiles>true</interceptAirProjectiles>
        <color>(0.95,0.72,0.20)</color><reactivateEffect>BulletShieldGenerator_Reactivate</reactivateEffect><activeSound>BulletShield_Ambience</activeSound>
        <hitPoints>1450</hitPoints><hitPointsRestoreInstantlyAfterCharge>false</hitPointsRestoreInstantlyAfterCharge><startWithMaxHitPoints>false</startWithMaxHitPoints>
        <chargeDurationTicks>10000</chargeDurationTicks><minIdleAlpha>0.2</minIdleAlpha><drawWithNoSelection>true</drawWithNoSelection>
        <disarmedByEmpForTicks>1500</disarmedByEmpForTicks><gizmoTipKey>GravshipShieldTip</gizmoTipKey><alwaysShowHitpointsGizmo>true</alwaysShowHitpointsGizmo>
        <rechargeHitPointsIntervalTicks>75</rechargeHitPointsIntervalTicks><activated>true</activated><activeDuration>6000</activeDuration>
      </li>
      <li Class="WraithNaniteGravtech.CompProperties_WNGGravshipPartTheme"><theme>Goauld</theme></li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="BuildingBase" MayRequire="idolord.ONAC">
    <defName>WNG_GoauldPowerCore</defName>
    <label>Ha'tak naquadah power core</label>
    <description>A compact naquadah-based mothership power core adapted to RimWorld's native gravship power-plant behavior. It produces ordinary electrical power only while standing on gravship substructure, allowing Ha'tak shields, transport rings and other ship systems to remain on the native power net.</description>
    <graphicData><graphicClass>Graphic_Single</graphicClass><texPath>Things/Building/GravcorePowerCell</texPath><drawSize>(2,2)</drawSize><color>(0.72,0.52,0.22)</color></graphicData>
    <tickerType>Normal</tickerType><size>(2,2)</size><fillPercent>0.5</fillPercent><passability>PassThroughOnly</passability><pathCost>20</pathCost>
    <terrainAffordanceNeeded>Substructure</terrainAffordanceNeeded><designationCategory>ONAC_Architect</designationCategory><constructionSkillPrerequisite>8</constructionSkillPrerequisite>
    <researchPrerequisites><li>WNG_GoauldGravships</li></researchPrerequisites>
    <statBases><MaxHitPoints>360</MaxHitPoints><Flammability>0</Flammability><Mass>50</Mass><WorkToBuild>10000</WorkToBuild></statBases>
    <costList><ONAC_Naquadah>48</ONAC_Naquadah><Plasteel>120</Plasteel><Gold>25</Gold><ComponentSpacer>4</ComponentSpacer></costList>
    <comps>
      <li Class="CompProperties_Power"><compClass>CompPowerPlantGravcore</compClass><basePowerConsumption>-2800</basePowerConsumption></li>
      <li Class="WraithNaniteGravtech.CompProperties_WNGGravshipPartTheme"><theme>Goauld</theme></li>
    </comps>
  </ThingDef>
</Defs>