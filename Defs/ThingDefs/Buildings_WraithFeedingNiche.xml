<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="BedBase">
    <defName>WNG_WraithFeedingNiche</defName>
    <label>wraith feeding niche</label>
    <description>A living restraint niche used by a mature Wraith Hive to hold an exact biological captive as local feeding stock. Keeper- or Queen-supervised ration feeding can sustain nearby Wraith without invoking strategic faction hunger.</description>
    <thingClass>Building_Bed</thingClass>
    <tickerType>Normal</tickerType>
    <size>(1,2)</size>
    <graphicData>
      <texPath>Things/Building/Furniture/Bed</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(1,2)</drawSize>
    </graphicData>
    <statBases>
      <MaxHitPoints>260</MaxHitPoints>
      <Flammability>0.15</Flammability>
      <Beauty>-4</Beauty>
      <WorkToBuild>1800</WorkToBuild>
    </statBases>
    <comps>
      <li Class="WraithNaniteGravtech.CompProperties_WraithFeedingNiche">
        <intervalTicks>120000</intervalTicks>
        <prisonerAgeYears>2</prisonerAgeYears>
        <lifeForcePerRecipient>0.12</lifeForcePerRecipient>
        <recipientLimit>3</recipientLimit>
        <lifeForceCutoff>0.85</lifeForceCutoff>
        <requireKeeperOrQueen>true</requireKeeperOrQueen>
      </li>
    </comps>
  </ThingDef>
</Defs>
