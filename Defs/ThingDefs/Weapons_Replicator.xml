<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    Fresh WNGR2 implementation of the Replicator Artillery body's integrated ranged system.
    The weapon is not a player-craftable item: CompReplicatorSpecialistBody installs it directly
    on the Artillery pawn. The existing Replicator artillery graphic is reused only under the
    explicit Replicator-graphics exception, at negligible equipment draw size so the integrated
    array does not render as a second body sprite. No firing sound is assigned until new WNGR2
    audio is authored from scratch.
  -->
  <ThingDef ParentName="BaseWeapon">
    <defName>WNG_ReplicatorArtilleryCaster</defName>
    <label>integrated replicator pulse array</label>
    <description>A long-range pulse emitter distributed through a Replicator Artillery body's frame. It exists as internal combat equipment and is used only when the swarm's bounded self-defense or retaliation logic assigns a combat target.</description>
    <techLevel>Spacer</techLevel>
    <graphicData>
      <texPath>Things/Pawn/Replicator/WNG_ReplicatorArtillery</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>0.01</drawSize>
    </graphicData>
    <equipmentType>Primary</equipmentType>
    <statBases>
      <MarketValue>0</MarketValue>
      <Mass>0</Mass>
      <RangedWeapon_Cooldown>4.2</RangedWeapon_Cooldown>
    </statBases>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>WNG_ReplicatorArtilleryPulse</defaultProjectile>
        <warmupTime>2.6</warmupTime>
        <range>42</range>
        <minRange>8</minRange>
        <burstShotCount>1</burstShotCount>
      </li>
    </verbs>
  </ThingDef>

  <ThingDef ParentName="BaseBullet">
    <defName>WNG_ReplicatorArtilleryPulse</defName>
    <label>replicator artillery pulse</label>
    <projectile>
      <damageDef>Burn</damageDef>
      <damageAmountBase>24</damageAmountBase>
      <armorPenetrationBase>0.28</armorPenetrationBase>
      <speed>58</speed>
    </projectile>
  </ThingDef>
</Defs>
