<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="BuildingBase" MayRequire="idolord.ONAC">
    <defName>WNG_GoauldNaquadriaPipe</defName><label>Ha'tak liquid-Naquadria conduit</label>
    <description>An exposed Goa'uld mothership conduit carrying ONAC liquid Naquadria between a Ha'tak reservoir and its grav engine. A tank contributes to Odyssey's native fuel total only while a continuous Goa'uld pipe path reaches the themed engine.</description>
    <thingClass>Building</thingClass><category>Building</category><noRightClickDraftAttack>true</noRightClickDraftAttack>
    <graphicData><texPath>Things/Building/Linked/PowerConduit_Atlas</texPath><graphicClass>Graphic_Single</graphicClass><linkType>Basic</linkType><linkFlags><li>Custom3</li></linkFlags><color>(0.72,0.52,0.22)</color><damageData><rect>(0,0.35,1,0.3)</rect></damageData></graphicData>
    <uiIconPath>Things/Building/Linked/PowerConduit_MenuIcon</uiIconPath><uiIconScale>0.7</uiIconScale>
    <building><isInert>true</isInert><isEdifice>false</isEdifice><ai_chillDestination>false</ai_chillDestination><canLandGravshipOn>true</canLandGravshipOn><canConstructInCorner>true</canConstructInCorner><blueprintGraphicData><texPath>Things/Building/Linked/PowerConduit_Blueprint_Atlas</texPath></blueprintGraphicData></building>
    <drawerType>MapMeshOnly</drawerType><altitudeLayer>Conduits</altitudeLayer><passability>Standable</passability><leaveResourcesWhenKilled>false</leaveResourcesWhenKilled><resourcesFractionWhenDeconstructed>0</resourcesFractionWhenDeconstructed>
    <statBases><MaxHitPoints>110</MaxHitPoints><WorkToBuild>55</WorkToBuild><Flammability>0</Flammability><Beauty>0</Beauty></statBases>
    <costList><ONAC_Naquadah>1</ONAC_Naquadah><Steel>1</Steel></costList>
    <comps><li Class="WraithNaniteGravtech.CompProperties_WNGFuelPipe"><family>Goauld</family></li></comps>
    <placeWorkers><li>WraithNaniteGravtech.PlaceWorker_WNGFuelPipe</li></placeWorkers>
    <rotatable>false</rotatable><selectable>true</selectable><neverMultiSelect>true</neverMultiSelect><terrainAffordanceNeeded>Substructure</terrainAffordanceNeeded>
    <designationCategory>ONAC_Architect</designationCategory><uiOrder>2470</uiOrder><constructEffect>ConstructMetal</constructEffect><clearBuildingArea>false</clearBuildingArea>
    <researchPrerequisites><li>WNG_GoauldGravships</li></researchPrerequisites><replaceTags><li>WNG_GoauldFuelPipe</li></replaceTags>
  </ThingDef>
  <ThingDef ParentName="BuildingBase" MayRequire="idolord.ONAC">
    <defName>WNG_GoauldHiddenNaquadriaPipe</defName><label>hidden Ha'tak liquid-Naquadria conduit</label>
