    <thingClass>Building</thingClass><category>Building</category><noRightClickDraftAttack>true</noRightClickDraftAttack>
    <graphicData><texPath>Things/Building/Linked/PowerConduit_Atlas</texPath><graphicClass>Graphic_Single</graphicClass><linkType>Basic</linkType><linkFlags><li>Custom3</li></linkFlags><color>(0,0,0,0)</color><shaderType>Transparent</shaderType></graphicData>
    <uiIconPath>Things/Building/Linked/HiddenConduit_MenuIcon</uiIconPath><uiIconScale>0.7</uiIconScale>
    <building><isInert>true</isInert><isEdifice>false</isEdifice><ai_chillDestination>false</ai_chillDestination><canLandGravshipOn>true</canLandGravshipOn><canConstructInCorner>true</canConstructInCorner><ai_neverTrashThis>true</ai_neverTrashThis><isTargetable>false</isTargetable><expandHomeArea>false</expandHomeArea><canBeDamagedByAttacks>false</canBeDamagedByAttacks><blueprintGraphicData><texPath>Things/Building/Linked/PowerConduit_Blueprint_Atlas</texPath></blueprintGraphicData></building>
    <drawerType>MapMeshOnly</drawerType><altitudeLayer>Conduits</altitudeLayer><passability>Standable</passability><leaveResourcesWhenKilled>false</leaveResourcesWhenKilled><resourcesFractionWhenDeconstructed>0</resourcesFractionWhenDeconstructed>
    <statBases><MaxHitPoints>150</MaxHitPoints><WorkToBuild>300</WorkToBuild><Flammability>0</Flammability><Beauty>0</Beauty></statBases>
    <costList><ONAC_Naquadah>2</ONAC_Naquadah><Steel>1</Steel></costList>
    <comps><li Class="WraithNaniteGravtech.CompProperties_WNGFuelPipe"><family>Goauld</family></li></comps>
    <placeWorkers><li>WraithNaniteGravtech.PlaceWorker_WNGFuelPipe</li></placeWorkers>
    <rotatable>false</rotatable><selectable>true</selectable><neverMultiSelect>true</neverMultiSelect><terrainAffordanceNeeded>Substructure</terrainAffordanceNeeded>
    <designationCategory>ONAC_Architect</designationCategory><uiOrder>2471</uiOrder><constructEffect>ConstructDirt</constructEffect><clearBuildingArea>false</clearBuildingArea>
    <researchPrerequisites><li>WNG_GoauldGravships</li></researchPrerequisites><replaceTags><li>WNG_GoauldFuelPipe</li></replaceTags>
  </ThingDef>
</Defs>