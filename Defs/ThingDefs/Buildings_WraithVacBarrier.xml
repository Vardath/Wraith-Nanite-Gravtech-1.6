<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Wraith living vacuum membrane using RimWorld 1.6 Odyssey's native Building_VacBarrier contract. -->
  <ThingDef ParentName="DoorBase">
    <defName>WNG_WraithVacuumMembrane</defName>
    <label>Wraith vacuum membrane</label>
    <description>A cultivated Wraith pressure membrane stretched across a ship passage. While bioelectric power is supplied it allows pawns to pass freely while sealing atmosphere against vacuum; if power fails, the membrane relaxes and atmosphere can pass through normally.</description>
    <thingClass>Building_VacBarrier</thingClass>
    <statBases>
      <WorkToBuild>2400</WorkToBuild>
      <MaxHitPoints>180</MaxHitPoints>
      <Flammability>0.15</Flammability>
    </statBases>
    <rotatable>false</rotatable>
    <graphicData>
      <texPath>Things/Building/VacBarrier/VacBarrier_Barrier</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(1.5,1.5)</drawSize>
      <shaderType>TransparentPostLight</shaderType>
      <damageData><enabled>false</enabled></damageData>
      <color>(0.38,0.18,0.28)</color>
    </graphicData>
    <uiIconPath>Things/Building/VacBarrier/VacBarrier_MenuIcon_south</uiIconPath>
    <costList>
      <WNG_WraithBioSludge>10</WNG_WraithBioSludge>
      <Steel>20</Steel>
      <Plasteel>20</Plasteel>
    </costList>
    <stuffCategories Inherit="False" />
    <useStuffTerrainAffordance>false</useStuffTerrainAffordance>
    <terrainAffordanceNeeded>Substructure</terrainAffordanceNeeded>
    <useBlueprintGraphicAsGhost>true</useBlueprintGraphicAsGhost>
    <designationCategory>WNG</designationCategory>
    <building>
      <isAirtight>true</isAirtight>
      <isSupportDoor>true</isSupportDoor>
      <doorTopGraphic>
        <texPath>Things/Building/VacBarrier/VacBarrier_Top</texPath>
        <graphicClass>Graphic_Multi</graphicClass>
        <drawSize>(1.5,1.5)</drawSize>
      </doorTopGraphic>
      <blueprintClass>Blueprint_Door</blueprintClass>
      <blueprintGraphicData>
        <texPath>Things/Building/VacBarrier/VacBarrier_MenuIcon</texPath>
        <graphicClass>Graphic_Multi</graphicClass>
        <shaderType>EdgeDetect</shaderType>
        <drawSize>(1.5,1.5)</drawSize>
      </blueprintGraphicData>
    </building>
    <researchPrerequisites><li>WNG_WraithGravships</li></researchPrerequisites>
    <constructionSkillPrerequisite>6</constructionSkillPrerequisite>
    <comps>
      <li Class="CompProperties_Flickable" />
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>40</basePowerConsumption>
      </li>
      <li Class="WraithNaniteGravtech.CompProperties_WNGGravshipPartTheme"><theme>Wraith</theme></li>
    </comps>
    <uiOrder>2410</uiOrder>
  </ThingDef>
</Defs>
