<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    Fresh Asuran/Ancient-derived gravship family. These Defs intentionally use Odyssey's native
    gravship classes/comps. Graphics are temporary vanilla mechanics-validation art only; final
    Asuran geometric/Ancient-derived art remains a separate unfinished presentation pass.
  -->

  <ThingDef ParentName="BuildingBase">
    <defName>WNG_AsuranGravEngineSeed</defName>
    <label>Asuran grav engine</label>
    <description>A programmable nanite gravitic matrix reconstructed from Ancient-derived technology. On completion it becomes Odyssey's real grav engine while retaining an Asuran technology identity, so native gravship discovery, launch and travel behavior remain intact.</description>
    <tickerType>Normal</tickerType>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <texPath>Things/Building/GravEngine/GravEngine</texPath>
      <drawSize>(3,3)</drawSize>
    </graphicData>
    <statBases>
      <MaxHitPoints>600</MaxHitPoints>
      <WorkToBuild>16000</WorkToBuild>
      <Flammability>0</Flammability>
      <Mass>28</Mass>
    </statBases>
    <size>(3,3)</size>
    <fillPercent>0.6</fillPercent>
    <passability>PassThroughOnly</passability>
    <pathCost>20</pathCost>
    <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
    <designationCategory>WNG</designationCategory>
    <researchPrerequisites><li>WNG_AsuranGravships</li></researchPrerequisites>
    <constructionSkillPrerequisite>9</constructionSkillPrerequisite>
    <costList>
      <WNG_NaniteSludge>100</WNG_NaniteSludge>
      <Plasteel>180</Plasteel>
      <ComponentSpacer>8</ComponentSpacer>
    </costList>
    <placeWorkers><li>WraithNaniteGravtech.PlaceWorker_WNGSingleGravEngine</li></placeWorkers>
    <comps>
      <li Class="WraithNaniteGravtech.CompProperties_WNGGravEngineSeed">
        <theme>Asuran</theme>
        <engineName>Asuran grav engine</engineName>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="BuildingBase">
    <defName>WNG_AsuranHullSeed</defName>
    <label>Asuran gravship hull</label>
    <description>An Ancient-derived hull section reconstructed by Asuran nanites. On completion it resolves into the exact native Odyssey gravship hull so airtight room behavior and angled hull corners remain genuinely functional while WNG records its Asuran architecture.</description>
    <tickerType>Normal</tickerType>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <texPath>Things/Building/Linked/GravshipHull/GravshipHull_Atlas</texPath>
    </graphicData>
    <statBases>
      <MaxHitPoints>320</MaxHitPoints>
      <WorkToBuild>500</WorkToBuild>
      <Flammability>0</Flammability>
    </statBases>
    <fillPercent>1</fillPercent>
    <passability>Impassable</passability>
    <holdsRoof>true</holdsRoof>
    <blockLight>true</blockLight>
    <terrainAffordanceNeeded>Substructure</terrainAffordanceNeeded>
    <designationCategory>WNG</designationCategory>
    <researchPrerequisites><li>WNG_AsuranGravships</li></researchPrerequisites>
    <costList>
      <WNG_NaniteSludge>2</WNG_NaniteSludge>
      <Plasteel>4</Plasteel>
    </costList>
    <comps>
      <li Class="WraithNaniteGravtech.CompProperties_WNGGravHullSeed"><theme>Asuran</theme></li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="GravshipComponentBase">
    <defName>WNG_AsuranControlInterface</defName>
    <label>Asuran gravship control interface</label>
    <description>A precise Ancient-derived flight-control surface reconstructed by Asuran nanites. It uses Odyssey's native pilot-console workflow for launch, destination selection and gravship operation.</description>
    <graphicData>
      <graphicClass>Graphic_Multi</graphicClass>
      <texPath>Things/Building/PilotConsole/PilotConsole</texPath>
      <drawSize>(3.7,2.6)</drawSize>
    </graphicData>
    <tickerType>Normal</tickerType>
    <statBases>
      <MaxHitPoints>220</MaxHitPoints>
      <Mass>40</Mass>
      <Flammability>0</Flammability>
      <Beauty>4</Beauty>
      <WorkToBuild>3200</WorkToBuild>
    </statBases>
    <size>(3,2)</size>
    <rotatable>true</rotatable>
    <fillPercent>0.4</fillPercent>
    <passability>PassThroughOnly</passability>
    <pathCost>14</pathCost>
    <canOverlapZones>false</canOverlapZones>
    <costList>
      <WNG_NaniteSludge>18</WNG_NaniteSludge>
      <Plasteel>80</Plasteel>
      <ComponentIndustrial>4</ComponentIndustrial>
    </costList>
    <resourcesFractionWhenDeconstructed>0.5</resourcesFractionWhenDeconstructed>
    <constructionSkillPrerequisite>7</constructionSkillPrerequisite>
    <designationCategory>WNG</designationCategory>
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <researchPrerequisites><li>WNG_AsuranGravships</li></researchPrerequisites>
    <terrainAffordanceNeeded>Substructure</terrainAffordanceNeeded>
    <comps>
      <li Class="CompProperties_GravshipFacility">
        <compClass>CompPilotConsole</compClass>
        <componentTypeDef>Controls</componentTypeDef>
        <requiresLOS>false</requiresLOS>
        <showMaxSimultaneous>false</showMaxSimultaneous>
        <maxSimultaneous>1</maxSimultaneous>
        <maxDistance>200</maxDistance>
      </li>
      <li Class="RimWorld.CompProperties_Breakdownable" />
      <li Class="WraithNaniteGravtech.CompProperties_WNGGravshipPartTheme"><theme>Asuran</theme></li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="FuelTankBase">
    <defName>WNG_AsuranNaniteSludgeTank</defName>
    <label>Asuran nanite-sludge reservoir</label>
    <description>A compact Asuran propellant reservoir holding nanite sludge for Odyssey's native gravship fuel calculations.</description>
    <graphicData>
      <graphicClass>Graphic_Multi</graphicClass>
      <texPath>Things/Building/ChemfuelTank/ChemfuelTank</texPath>
      <drawSize>(2,2)</drawSize>
    </graphicData>
    <statBases>
      <MaxHitPoints>280</MaxHitPoints><Mass>24</Mass><Flammability>0</Flammability><Beauty>1</Beauty><WorkToBuild>2200</WorkToBuild>
    </statBases>
    <size>(2,2)</size>
    <costList><WNG_NaniteSludge>14</WNG_NaniteSludge><Plasteel>80</Plasteel></costList>
    <designationCategory>WNG</designationCategory>
    <researchPrerequisites><li>WNG_AsuranGravships</li></researchPrerequisites>
    <comps>
      <li Class="CompProperties_Refuelable">
        <fuelCapacity>250</fuelCapacity>
        <targetFuelLevelConfigurable>true</targetFuelLevelConfigurable>
        <initialConfigurableTargetFuelLevel>250</initialConfigurableTargetFuelLevel>
        <fuelFilter><thingDefs><li>WNG_NaniteSludge</li></thingDefs></fuelFilter>
        <fuelLabel>Nanite sludge</fuelLabel><fuelGizmoLabel>Nanite sludge</fuelGizmoLabel>
        <consumeFuelOnlyWhenUsed>true</consumeFuelOnlyWhenUsed><autoRefuelPercent>1</autoRefuelPercent>
        <showFuelGizmo>true</showFuelGizmo><drawOutOfFuelOverlay>false</drawOutOfFuelOverlay>
        <showAllowAutoRefuelToggle>true</showAllowAutoRefuelToggle><canEjectFuel>true</canEjectFuel><drawFuelGaugeInMap>false</drawFuelGaugeInMap>
      </li>
      <li Class="WraithNaniteGravtech.CompProperties_WNGGravshipPartTheme"><theme>Asuran</theme></li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="FuelTankBase">
    <defName>WNG_AsuranLargeNaniteSludgeTank</defName>
    <label>large Asuran nanite-sludge reservoir</label>
    <description>A high-capacity Asuran nanite-sludge reservoir integrated into a gravship's native Odyssey fuel system.</description>
    <graphicData>
      <graphicClass>Graphic_Multi</graphicClass>
      <texPath>Things/Building/LargeChemfuelTank/LargeChemfuelTank</texPath>
      <drawSize>(3,3)</drawSize>
    </graphicData>
    <statBases>
      <MaxHitPoints>420</MaxHitPoints><Mass>58</Mass><Flammability>0</Flammability><Beauty>1</Beauty><WorkToBuild>3500</WorkToBuild>
    </statBases>
    <size>(3,3)</size>
    <costList><WNG_NaniteSludge>32</WNG_NaniteSludge><Plasteel>135</Plasteel><ComponentIndustrial>2</ComponentIndustrial></costList>
    <designationCategory>WNG</designationCategory>
    <researchPrerequisites><li>WNG_AsuranGravships</li></researchPrerequisites>
    <comps>
      <li Class="CompProperties_Refuelable">
        <fuelCapacity>750</fuelCapacity>
        <targetFuelLevelConfigurable>true</targetFuelLevelConfigurable>
        <initialConfigurableTargetFuelLevel>750</initialConfigurableTargetFuelLevel>
        <fuelFilter><thingDefs><li>WNG_NaniteSludge</li></thingDefs></fuelFilter>
        <fuelLabel>Nanite sludge</fuelLabel><fuelGizmoLabel>Nanite sludge</fuelGizmoLabel>
        <consumeFuelOnlyWhenUsed>true</consumeFuelOnlyWhenUsed><autoRefuelPercent>1</autoRefuelPercent>
        <showFuelGizmo>true</showFuelGizmo><drawOutOfFuelOverlay>false</drawOutOfFuelOverlay>
        <showAllowAutoRefuelToggle>true</showAllowAutoRefuelToggle><canEjectFuel>true</canEjectFuel><drawFuelGaugeInMap>false</drawFuelGaugeInMap>
      </li>
      <li Class="WraithNaniteGravtech.CompProperties_WNGGravshipPartTheme"><theme>Asuran</theme></li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="ThrusterBase">
    <defName>WNG_AsuranSmallThruster</defName>
    <label>Asuran vector thruster</label>
    <description>A compact Ancient-derived vector drive reconstructed through Asuran nanites. It contributes thrust and range through Odyssey's native gravship propulsion component.</description>
    <graphicData><graphicClass>Graphic_Multi</graphicClass><texPath>Things/Building/SmallThruster/SmallThruster</texPath><drawSize>(1.1,2.2)</drawSize></graphicData>
    <statBases><MaxHitPoints>340</MaxHitPoints><Flammability>0</Flammability><Beauty>1</Beauty><WorkToBuild>8500</WorkToBuild><Mass>16</Mass></statBases>
    <size>(1,2)</size><constructionSkillPrerequisite>7</constructionSkillPrerequisite>
    <costList><WNG_NaniteSludge>24</WNG_NaniteSludge><Plasteel>95</Plasteel><ComponentIndustrial>4</ComponentIndustrial></costList>
    <researchPrerequisites><li>WNG_AsuranGravships</li></researchPrerequisites><designationCategory>WNG</designationCategory>
    <comps>
      <li Class="CompProperties_GravshipThruster">
        <statOffsets><GravshipRange>11</GravshipRange></statOffsets><componentTypeDef>Thruster</componentTypeDef>
        <exclusionAreaSize>(1,0,5)</exclusionAreaSize><exclusionAreaOffset>(0,0,-5)</exclusionAreaOffset><directionInfluence>22</directionInfluence>
        <flameSize>4</flameSize><flameOffsetsPerDirection><li>(0,0,0.5)</li><li>(0,0,0.5)</li><li>(0,0,0.5)</li><li>(0,0,0.5)</li></flameOffsetsPerDirection>
        <flameShaderType>MoteGlow</flameShaderType><flameShaderParameters><_MainTex>/Things/Mote/SmallThruster_Burn</_MainTex></flameShaderParameters>
        <requiresLOS>false</requiresLOS><maxSimultaneous>4</maxSimultaneous><maxDistance>500</maxDistance>
        <exhaustSettings>
          <exhaustFleckDef>GravshipThrusterExhaust</exhaustFleckDef><emissionsPerSecond>40</emissionsPerSecond><spawnRadiusRange>0~0.5</spawnRadiusRange>
          <velocity>(0,0,-20)</velocity><velocityRotationRange>-10~10</velocityRotationRange><velocityMultiplierRange>0.8~1.2</velocityMultiplierRange>
          <rotationOverTimeRange>-180~180</rotationOverTimeRange><scaleRange>1.5~3</scaleRange>
        </exhaustSettings>
      </li>
      <li Class="WraithNaniteGravtech.CompProperties_WNGGravshipPartTheme"><theme>Asuran</theme></li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="ThrusterBase">
    <defName>WNG_AsuranLargeThruster</defName>
    <label>large Asuran vector drive</label>
    <description>A high-output Ancient-derived gravitic vector drive using Odyssey's native thruster exclusion, rotation and range behavior.</description>
    <graphicData><graphicClass>Graphic_Multi</graphicClass><texPath>Things/Building/LateralThruster/LateralThruster</texPath><drawSize>(2.2,2.2)</drawSize></graphicData>
    <statBases><MaxHitPoints>620</MaxHitPoints><Flammability>0</Flammability><Beauty>1</Beauty><WorkToBuild>13000</WorkToBuild><Mass>26</Mass></statBases>
    <size>(2,2)</size><constructionSkillPrerequisite>8</constructionSkillPrerequisite>
    <costList><WNG_NaniteSludge>45</WNG_NaniteSludge><Plasteel>155</Plasteel><ComponentIndustrial>6</ComponentIndustrial></costList>
    <researchPrerequisites><li>WNG_AsuranGravships</li></researchPrerequisites><designationCategory>WNG</designationCategory>
    <comps>
      <li Class="CompProperties_GravshipThruster">
        <statOffsets><GravshipRange>17</GravshipRange></statOffsets><componentTypeDef>Thruster</componentTypeDef>
        <exclusionAreaSize>(2,0,7)</exclusionAreaSize><exclusionAreaOffset>(0,0,-7)</exclusionAreaOffset><directionInfluence>32</directionInfluence>
        <flameSize>4</flameSize><flameOffsetsPerDirection><li>(0,0,1)</li><li>(0,0,0.5)</li><li>(0,0,0.5)</li><li>(0,0,0.5)</li></flameOffsetsPerDirection>
        <flameShaderType>MoteGlow</flameShaderType><flameShaderParameters><_MainTex>/Things/Mote/LargeThruster_Burn</_MainTex></flameShaderParameters>
        <requiresLOS>false</requiresLOS><maxSimultaneous>6</maxSimultaneous><maxDistance>500</maxDistance>
        <exhaustSettings>
          <exhaustFleckDef>GravshipThrusterExhaust</exhaustFleckDef><emissionsPerSecond>40</emissionsPerSecond><spawnRadiusRange>0~0.5</spawnRadiusRange>
          <velocity>(0,0,-20)</velocity><velocityRotationRange>-10~10</velocityRotationRange><velocityMultiplierRange>0.8~1.2</velocityMultiplierRange>
          <rotationOverTimeRange>-180~180</rotationOverTimeRange><scaleRange>3~5</scaleRange>
        </exhaustSettings>
      </li>
      <li Class="WraithNaniteGravtech.CompProperties_WNGGravshipPartTheme"><theme>Asuran</theme></li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="GravshipComponentBase">
    <defName>WNG_AsuranFieldExtender</defName>
    <label>Asuran grav-field extender</label>
    <description>An Ancient-derived field projector that expands the substructure area and mass supported by an Asuran grav engine using Odyssey's native footprint mechanics.</description>
    <graphicData><graphicClass>Graphic_Single</graphicClass><texPath>Things/Building/GravFieldExtender</texPath></graphicData>
    <statBases><MaxHitPoints>280</MaxHitPoints><Mass>12</Mass><Flammability>0</Flammability><WorkToBuild>1800</WorkToBuild></statBases>
    <fillPercent>0.4</fillPercent><passability>PassThroughOnly</passability><pathCost>14</pathCost>
    <designationCategory>WNG</designationCategory><constructionSkillPrerequisite>7</constructionSkillPrerequisite><resourcesFractionWhenDeconstructed>0.5</resourcesFractionWhenDeconstructed>
    <researchPrerequisites><li>WNG_AsuranGravships</li></researchPrerequisites>
    <costList><WNG_NaniteSludge>18</WNG_NaniteSludge><Plasteel>60</Plasteel><ComponentIndustrial>2</ComponentIndustrial></costList>
    <terrainAffordanceNeeded>Substructure</terrainAffordanceNeeded><placeWorkers><li>PlaceWorker_InRangeOfGravEngine</li></placeWorkers>
    <comps>
      <li Class="CompProperties_SubstructureFootprint"><radius>16.9</radius></li>
      <li Class="CompProperties_GravshipFacility"><statOffsets><SubstructureSupport>275</SubstructureSupport></statOffsets><requiresLOS>false</requiresLOS><maxSimultaneous>6</maxSimultaneous><maxDistance>18.9</maxDistance><onlyRequiresLooseConnection>true</onlyRequiresLooseConnection></li>
      <li Class="WraithNaniteGravtech.CompProperties_WNGGravshipPartTheme"><theme>Asuran</theme></li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="GravshipComponentBase">
    <defName>WNG_AsuranSignalJammer</defName>
    <label>Asuran signal jammer</label>
    <description>An advanced Ancient-derived interference array that fulfills Odyssey's native signal-jammer role for an Asuran gravship.</description>
    <graphicData><graphicClass>Graphic_Multi</graphicClass><texPath>Things/Building/SignalJammer/SignalJammer</texPath><drawSize>(2,2)</drawSize></graphicData>
    <statBases><MaxHitPoints>390</MaxHitPoints><Flammability>0</Flammability><Mass>58</Mass><WorkToBuild>7800</WorkToBuild></statBases>
    <size>(2,2)</size><fillPercent>0.6</fillPercent><passability>PassThroughOnly</passability><pathCost>20</pathCost>
    <designationCategory>WNG</designationCategory><constructionSkillPrerequisite>8</constructionSkillPrerequisite><researchPrerequisites><li>WNG_AsuranGravships</li></researchPrerequisites>
    <costList><WNG_NaniteSludge>28</WNG_NaniteSludge><Plasteel>115</Plasteel><ComponentSpacer>3</ComponentSpacer></costList><terrainAffordanceNeeded>Substructure</terrainAffordanceNeeded>
    <comps>
      <li Class="CompProperties_GravshipFacility"><requiresLOS>false</requiresLOS><componentTypeDef>SignalJammer</componentTypeDef><maxSimultaneous>1</maxSimultaneous><maxDistance>500</maxDistance></li>
      <li Class="WraithNaniteGravtech.CompProperties_WNGGravshipPartTheme"><theme>Asuran</theme></li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="GravshipComponentBase">
    <defName>WNG_AsuranFuelOptimizer</defName>
    <label>Asuran propulsion optimizer</label>
    <description>A nanite-regulated Ancient-derived field coordinator that reduces nanite-sludge expenditure during Odyssey gravship flight.</description>
    <graphicData><graphicClass>Graphic_Multi</graphicClass><texPath>Things/Building/FuelOptimizer/FuelOptimizer</texPath><drawSize>(2,2)</drawSize></graphicData>
    <statBases><MaxHitPoints>220</MaxHitPoints><Flammability>0</Flammability><Mass>34</Mass><WorkToBuild>6200</WorkToBuild></statBases>
    <size>(2,2)</size><fillPercent>0.4</fillPercent><passability>PassThroughOnly</passability><pathCost>20</pathCost>
    <designationCategory>WNG</designationCategory><constructionSkillPrerequisite>8</constructionSkillPrerequisite><researchPrerequisites><li>WNG_AsuranGravships</li></researchPrerequisites>
    <costList><WNG_NaniteSludge>24</WNG_NaniteSludge><Plasteel>90</Plasteel><ComponentSpacer>3</ComponentSpacer></costList><terrainAffordanceNeeded>Substructure</terrainAffordanceNeeded>
    <comps>
      <li Class="CompProperties_GravshipFacility"><fuelSavingsPercent>0.2</fuelSavingsPercent><requiresLOS>false</requiresLOS><maxSimultaneous>2</maxSimultaneous><maxDistance>500</maxDistance></li>
      <li Class="WraithNaniteGravtech.CompProperties_WNGGravshipPartTheme"><theme>Asuran</theme></li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="GravshipComponentBase">
    <defName>WNG_AsuranShieldEmitter</defName>
    <label>Asuran shield emitter</label>
    <description>An Ancient-derived defensive field emitter reconstructed by Asuran nanites. Unlike Wraith living-hull regeneration, this is a true powered gravship energy shield using Odyssey's native projectile-interceptor behavior.</description>
    <graphicData><graphicClass>Graphic_Single</graphicClass><texPath>Things/Building/GravshipShieldGenerator/GravshipShieldGenerator</texPath><drawSize>(3,3)</drawSize></graphicData>
    <drawerType>MapMeshAndRealTime</drawerType><drawOffscreen>true</drawOffscreen><tickerType>Normal</tickerType>
    <statBases><MaxHitPoints>350</MaxHitPoints><Flammability>0</Flammability><Mass>95</Mass><WorkToBuild>12000</WorkToBuild></statBases>
    <size>(3,3)</size><fillPercent>0.6</fillPercent><passability>PassThroughOnly</passability><pathCost>20</pathCost><canOverlapZones>false</canOverlapZones>
    <terrainAffordanceNeeded>Substructure</terrainAffordanceNeeded><specialDisplayRadius>27.9</specialDisplayRadius>
    <designationCategory>WNG</designationCategory><constructionSkillPrerequisite>9</constructionSkillPrerequisite><researchPrerequisites><li>WNG_AsuranGravships</li></researchPrerequisites>
    <costList><WNG_NaniteSludge>55</WNG_NaniteSludge><Plasteel>160</Plasteel><ComponentSpacer>6</ComponentSpacer></costList>
    <comps>
      <li Class="CompProperties_GravshipFacility"><requiresLOS>false</requiresLOS><maxSimultaneous>2</maxSimultaneous><maxDistance>500</maxDistance></li>
      <li Class="CompProperties_Flickable" />
      <li Class="CompProperties_Power"><compClass>CompPowerTrader</compClass><basePowerConsumption>500</basePowerConsumption></li>
      <li Class="CompProperties_Interactable">
        <compClass>CompInteractable_GravshipShieldGenerator</compClass><ticksToActivate>120</ticksToActivate><jobString>activate</jobString>
        <activateTexPath>UI/Commands/ActivateGravshipShield</activateTexPath><soundActivate>GravshipShieldGenerator_Activate</soundActivate><requiresPower>false</requiresPower>
        <targetingParameters><canTargetBuildings>false</canTargetBuildings><canTargetAnimals>false</canTargetAnimals><canTargetMechs>false</canTargetMechs><onlyTargetControlledPawns>true</onlyTargetControlledPawns></targetingParameters>
      </li>
      <li Class="CompProperties_ProjectileInterceptor">
        <compClass>CompGravshipShieldGenerator</compClass><radius>27.9</radius><interceptGroundProjectiles>true</interceptGroundProjectiles><interceptAirProjectiles>true</interceptAirProjectiles>
        <color>(0.25,0.55,0.95)</color><reactivateEffect>BulletShieldGenerator_Reactivate</reactivateEffect><activeSound>BulletShield_Ambience</activeSound>
        <hitPoints>1200</hitPoints><hitPointsRestoreInstantlyAfterCharge>false</hitPointsRestoreInstantlyAfterCharge><startWithMaxHitPoints>false</startWithMaxHitPoints>
        <chargeDurationTicks>10000</chargeDurationTicks><minIdleAlpha>0.2</minIdleAlpha><drawWithNoSelection>true</drawWithNoSelection>
        <disarmedByEmpForTicks>1500</disarmedByEmpForTicks><gizmoTipKey>GravshipShieldTip</gizmoTipKey><alwaysShowHitpointsGizmo>true</alwaysShowHitpointsGizmo>
        <rechargeHitPointsIntervalTicks>75</rechargeHitPointsIntervalTicks><activated>true</activated><activeDuration>6000</activeDuration>
      </li>
      <li Class="WraithNaniteGravtech.CompProperties_WNGGravshipPartTheme"><theme>Asuran</theme></li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="BuildingBase">
    <defName>WNG_AsuranPowerCell</defName>
    <label>Asuran gravitic power cell</label>
    <description>An Ancient-derived gravitic power cell reconstructed through Asuran nanites. It produces electrical power only while standing on gravship substructure, using Odyssey's native gravcore power-plant behavior rather than a custom power system.</description>
    <graphicData><graphicClass>Graphic_Single</graphicClass><texPath>Things/Building/GravcorePowerCell</texPath><drawSize>(2,2)</drawSize></graphicData>
    <tickerType>Normal</tickerType><size>(2,2)</size><fillPercent>0.5</fillPercent><passability>PassThroughOnly</passability><pathCost>20</pathCost>
    <terrainAffordanceNeeded>Substructure</terrainAffordanceNeeded><designationCategory>WNG</designationCategory><constructionSkillPrerequisite>8</constructionSkillPrerequisite>
    <researchPrerequisites><li>WNG_AsuranGravships</li></researchPrerequisites>
    <statBases><MaxHitPoints>320</MaxHitPoints><Flammability>0</Flammability><Mass>45</Mass><WorkToBuild>9000</WorkToBuild></statBases>
    <costList><WNG_NaniteSludge>40</WNG_NaniteSludge><Plasteel>110</Plasteel><ComponentSpacer>4</ComponentSpacer></costList>
    <comps>
      <li Class="CompProperties_Power"><compClass>CompPowerPlantGravcore</compClass><basePowerConsumption>-2500</basePowerConsumption></li>
      <li Class="WraithNaniteGravtech.CompProperties_WNGGravshipPartTheme"><theme>Asuran</theme></li>
    </comps>
  </ThingDef>
</Defs>
