  <ThingDef ParentName="TableGatherSpotBase"><defName>WNG_WraithFeastTable</defName><label>wraith feast table (2x2)</label><description>A broad living dining surface supported by branching organic ribs.</description><graphicData><texPath>Things/Building/Furniture/Wraith/WNG_FeastTable2x2</texPath><graphicClass>Graphic_Multi</graphicClass><drawSize>(4,4)</drawSize></graphicData><size>(2,2)</size><rotatable>false</rotatable><statBases><MaxHitPoints>280</MaxHitPoints><WorkToBuild>1300</WorkToBuild><Mass>20</Mass><Flammability>0.35</Flammability><Beauty>7</Beauty></statBases><costList><WNG_Biomass>42</WNG_Biomass></costList><leaveResourcesWhenKilled>false</leaveResourcesWhenKilled><uiOrder>2341</uiOrder></ThingDef>
  <ThingDef ParentName="TableBase"><defName>WNG_WraithBedsideNode</defName><label>wraith bedside node</label><description>A small symbiotic organ-table that settles beside a rest cradle and emits soothing warmth and low-frequency vibration.</description><surfaceType>Item</surfaceType><graphicData><texPath>Things/Building/Furniture/Wraith/WNG_BedsideNode</texPath><graphicClass>Graphic_Multi</graphicClass></graphicData><statBases><MaxHitPoints>120</MaxHitPoints><WorkToBuild>500</WorkToBuild><Mass>5</Mass><Flammability>0.35</Flammability><Beauty>3</Beauty></statBases><costList><WNG_Biomass>12</WNG_Biomass></costList><placeWorkers><li>PlaceWorker_ShowFacilitiesConnections</li></placeWorkers><comps><li Class="CompProperties_Facility"><statOffsets><Comfort>0.05</Comfort></statOffsets><maxSimultaneous>1</maxSimultaneous><mustBePlacedAdjacentCardinalToBedHead>true</mustBePlacedAdjacentCardinalToBedHead></li></comps><staticSunShadowHeight>0</staticSunShadowHeight><castEdgeShadows>false</castEdgeShadows><leaveResourcesWhenKilled>false</leaveResourcesWhenKilled><uiOrder>2120</uiOrder></ThingDef>
