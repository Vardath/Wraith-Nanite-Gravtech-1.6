<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Original living/organic furniture family. Mostly XML-only by design. -->

  <ThingDef ParentName="BedWithQualityBase">
    <defName>WNG_WraithRestCradle</defName><label>wraith rest cradle</label><description>A grown sleeping cradle of warm fibrous tissue. It subtly shifts to support the sleeper and seals minor wounds while they rest.</description>
    <graphicData><texPath>Things/Building/Furniture/Wraith/WNG_RestCradle</texPath><graphicClass>Graphic_Multi</graphicClass><drawSize>(2,2)</drawSize></graphicData><size>(1,2)</size>
    <statBases><MaxHitPoints>220</MaxHitPoints><WorkToBuild>1200</WorkToBuild><Mass>22</Mass><Flammability>0.35</Flammability><BedRestEffectiveness>1.05</BedRestEffectiveness><Comfort>0.82</Comfort><ImmunityGainSpeedFactor>1.08</ImmunityGainSpeedFactor><Beauty>4</Beauty></statBases>
    <costList><WNG_Biomass>35</WNG_Biomass></costList><building><bed_showSleeperBody>false</bed_showSleeperBody><bed_healPerDay>7</bed_healPerDay><destroySound>BuildingDestroyed_Soft_Small</destroySound></building><leaveResourcesWhenKilled>false</leaveResourcesWhenKilled><uiOrder>2110</uiOrder>
  </ThingDef>

  <ThingDef ParentName="BedWithQualityBase">
    <defName>WNG_WraithHibernationPod</defName><label>wraith hibernation pod</label><description>A sealed living chamber used to sustain Wraith through long dormant cycles. Its vascular lining suppresses life-force consumption and continuously maintains the sleeper's hibernating state. A Keeper or Queen can periodically tend an occupied pod with cultured biomass, replacing a small portion of the sleeper's remaining life-force loss without making Keeper presence mandatory for hibernation.</description>
    <graphicData><texPath>Things/Building/Furniture/Wraith/WNG_HibernationPod</texPath><graphicClass>Graphic_Multi</graphicClass><drawSize>(2.2,2.8)</drawSize></graphicData><size>(1,2)</size>
    <statBases><MaxHitPoints>420</MaxHitPoints><WorkToBuild>2600</WorkToBuild><Mass>46</Mass><Flammability>0.25</Flammability><BedRestEffectiveness>1.15</BedRestEffectiveness><Comfort>0.88</Comfort><ImmunityGainSpeedFactor>1.12</ImmunityGainSpeedFactor><Beauty>6</Beauty></statBases>
    <costList><WNG_Biomass>70</WNG_Biomass></costList><building><bed_showSleeperBody>false</bed_showSleeperBody><bed_healPerDay>10</bed_healPerDay><destroySound>BuildingDestroyed_Soft_Medium</destroySound></building>
    <researchPrerequisites><li>WNG_FeedingEcology</li></researchPrerequisites>
    <comps><li Class="WraithNaniteGravtech.CompProperties_WraithHibernationPod"><checkIntervalTicks>250</checkIntervalTicks><keeperTendIntervalTicks>60000</keeperTendIntervalTicks><keeperBiomassCost>1</keeperBiomassCost><keeperLifeForceRestore>0.02</keeperLifeForceRestore></li></comps><leaveResourcesWhenKilled>false</leaveResourcesWhenKilled><uiOrder>2112</uiOrder>
  </ThingDef>

  <ThingDef ParentName="BedWithQualityBase"><defName>WNG_WraithRestNestDouble</defName><label>wraith double rest nest</label><description>A broad living rest nest grown for two sleepers. Its flexible support tissue conforms independently around each occupant.</description><graphicData><texPath>Things/Building/Furniture/Wraith/WNG_RestNestDouble</texPath><graphicClass>Graphic_Multi</graphicClass><drawSize>(2.05,2.05)</drawSize></graphicData><size>(2,2)</size><statBases><MaxHitPoints>340</MaxHitPoints><WorkToBuild>2200</WorkToBuild><Mass>38</Mass><Flammability>0.35</Flammability><BedRestEffectiveness>1.05</BedRestEffectiveness><Comfort>0.84</Comfort><ImmunityGainSpeedFactor>1.08</ImmunityGainSpeedFactor><Beauty>7</Beauty></statBases><costList><WNG_Biomass>65</WNG_Biomass></costList><building><bed_showSleeperBody>false</bed_showSleeperBody><bed_healPerDay>7</bed_healPerDay><destroySound>BuildingDestroyed_Soft_Medium</destroySound></building><leaveResourcesWhenKilled>false</leaveResourcesWhenKilled><uiOrder>2111</uiOrder></ThingDef>

  <ThingDef ParentName="FurnitureWithQualityBase"><defName>WNG_WraithGrowthSeat</defName><label>wraith growth seat</label><description>A grown chair whose flexible ribs and soft membrane reshape themselves around the sitter.</description><replaceTags><li>Chair</li></replaceTags><graphicData><texPath>Things/Building/Furniture/Wraith/WNG_GrowthSeat</texPath><graphicClass>Graphic_Multi</graphicClass><drawSize>(1,1)</drawSize></graphicData><altitudeLayer>Building</altitudeLayer><statBases><MaxHitPoints>150</MaxHitPoints><WorkToBuild>700</WorkToBuild><Mass>6</Mass><Flammability>0.35</Flammability><Beauty>5</Beauty><Comfort>0.72</Comfort></statBases><socialPropernessMatters>true</socialPropernessMatters><costList><WNG_Biomass>18</WNG_Biomass></costList><pathCost>30</pathCost><fillPercent>0.35</fillPercent><defaultPlacingRot>South</defaultPlacingRot><uiOrder>2440</uiOrder><building><isSittable>true</isSittable><destroySound>BuildingDestroyed_Soft_Small</destroySound></building></ThingDef>
  <ThingDef ParentName="FurnitureWithQualityBase"><defName>WNG_WraithLounge</defName><label>wraith living lounge</label><description>A two-person organic couch grown from layered membrane, cartilage and springy support fibres.</description><replaceTags><li>Chair</li></replaceTags><graphicData><texPath>Things/Building/Furniture/Wraith/WNG_LivingLounge</texPath><graphicClass>Graphic_Multi</graphicClass><drawSize>(3,3)</drawSize></graphicData><size>(2,1)</size><altitudeLayer>Building</altitudeLayer><statBases><MaxHitPoints>260</MaxHitPoints><WorkToBuild>1600</WorkToBuild><Mass>28</Mass><Flammability>0.35</Flammability><Beauty>8</Beauty><Comfort>0.86</Comfort></statBases><socialPropernessMatters>true</socialPropernessMatters><costList><WNG_Biomass>42</WNG_Biomass></costList><pathCost>30</pathCost><fillPercent>0.40</fillPercent><defaultPlacingRot>South</defaultPlacingRot><uiOrder>2441</uiOrder><building><isSittable>true</isSittable><multiSittable>true</multiSittable><destroySound>BuildingDestroyed_Soft_Medium</destroySound></building></ThingDef>
