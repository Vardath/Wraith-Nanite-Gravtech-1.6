<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    Asuran/Ancient-derived orbital support built directly on RimWorld 1.6 Odyssey contracts.
    Current graphics use the native Odyssey textures as mechanics-validation placeholders; final
    Asuran presentation remains an explicit art pass.
  -->

  <ThingDef ParentName="DoorBase">
    <defName>WNG_AsuranVacBarrier</defName>
    <label>Asuran vacuum barrier</label>
    <description>An Ancient-derived pressure field reconstructed by Asuran nanites. When powered it prevents atmosphere from escaping through the threshold while allowing pawns to pass freely. It is not a security door and does nothing to stop intruders.</description>
    <thingClass>Building_VacBarrier</thingClass>
    <statBases>
      <WorkToBuild>2200</WorkToBuild>
      <MaxHitPoints>140</MaxHitPoints>
      <Flammability>0</Flammability>
    </statBases>
    <rotatable>false</rotatable>
    <graphicData>
      <texPath>Things/Building/VacBarrier/VacBarrier_Barrier</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(1.5,1.5)</drawSize>
      <shaderType>TransparentPostLight</shaderType>
      <damageData><enabled>false</enabled></damageData>
      <color>(80,170,255)</color>
    </graphicData>
    <uiIconPath>Things/Building/VacBarrier/VacBarrier_MenuIcon_south</uiIconPath>
    <costList>
      <WNG_NaniteSludge>8</WNG_NaniteSludge>
      <Plasteel>35</Plasteel>
      <ComponentIndustrial>2</ComponentIndustrial>
    </costList>
    <stuffCategories Inherit="False" />
    <useStuffTerrainAffordance>false</useStuffTerrainAffordance>
    <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
    <useBlueprintGraphicAsGhost>true</useBlueprintGraphicAsGhost>
    <designationCategory>WNG</designationCategory>
    <building>
      <isAirtight>true</isAirtight>
      <isSupportDoor>true</isSupportDoor>
      <doorTopGraphic>
        <texPath>Things/Building/VacBarrier/VacBarrier_Top</texPath>
        <graphicClass>Graphic_Multi</graphicClass>
        <drawSize>(1.5,1.5)</drawSize>
      </doorTopGraphic>
      <blueprintClass>Blueprint_Door</blueprintClass>
      <blueprintGraphicData>
        <texPath>Things/Building/VacBarrier/VacBarrier_MenuIcon</texPath>
        <graphicClass>Graphic_Multi</graphicClass>
        <shaderType>EdgeDetect</shaderType>
        <drawSize>(1.5,1.5)</drawSize>
      </blueprintGraphicData>
    </building>
    <researchPrerequisites><li>WNG_AsuranGravships</li></researchPrerequisites>
    <constructionSkillPrerequisite>7</constructionSkillPrerequisite>
    <comps>
      <li Class="CompProperties_Flickable" />
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>50</basePowerConsumption>
      </li>
      <li Class="CompProperties_Breakdownable" />
      <li Class="WraithNaniteGravtech.CompProperties_WNGGravshipPartTheme"><theme>Asuran</theme></li>
    </comps>
    <uiOrder>2410</uiOrder>
  </ThingDef>

  <ThingDef ParentName="BuildingBase">
    <defName>WNG_AsuranOxygenPump</defName>
    <label>Asuran oxygen pump</label>
    <description>A wall-mounted Ancient-derived atmospheric unit reconstructed by Asuran nanites. It uses Odyssey's native oxygen-pusher behavior to repressurize enclosed rooms in vacuum.</description>
    <tickerType>Rare</tickerType>
    <rotatable>true</rotatable>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories><li>BuildingsMisc</li></thingCategories>
    <uiIconPath>Things/Building/OxygenPump/OxygenPump_MenuIcon</uiIconPath>
    <graphicData>
      <texPath>Things/Building/OxygenPump/OxygenPump</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawOffsetNorth>(0,0,0.9)</drawOffsetNorth>
      <drawOffsetSouth>(0,0,-0.9)</drawOffsetSouth>
      <drawOffsetWest>(-0.9,0,0)</drawOffsetWest>
      <drawOffsetEast>(0.9,0,0)</drawOffsetEast>
      <damageData><enabled>false</enabled></damageData>
      <color>(0.55,0.8,1)</color>
    </graphicData>
    <altitudeLayer>BuildingOnTop</altitudeLayer>
    <designationCategory>WNG</designationCategory>
    <statBases>
      <MarketValue>260</MarketValue>
      <MaxHitPoints>100</MaxHitPoints>
      <WorkToBuild>2200</WorkToBuild>
      <Mass>7</Mass>
    </statBases>
    <passability>Standable</passability>
    <terrainAffordanceNeeded IsNull="True" />
    <pathCost>0</pathCost>
    <overrideMinifiedRot>North</overrideMinifiedRot>
    <minifiedDrawOffset>(0,0,0.2)</minifiedDrawOffset>
    <building>
      <isEdifice>false</isEdifice>
      <isAttachment>true</isAttachment>
      <expandHomeArea>false</expandHomeArea>
    </building>
    <costList>
      <WNG_NaniteSludge>8</WNG_NaniteSludge>
      <Plasteel>45</Plasteel>
      <ComponentIndustrial>2</ComponentIndustrial>
    </costList>
    <placeWorkers><li>Placeworker_AttachedToWall</li></placeWorkers>
    <comps>
      <li Class="CompProperties_Power"><compClass>CompPowerTrader</compClass><basePowerConsumption>150</basePowerConsumption></li>
      <li Class="CompProperties_LowPowerUnlessVacuum"><lowPowerConsumptionFactor>0.1</lowPowerConsumptionFactor></li>
      <li Class="CompProperties_Flickable" />
      <li Class="CompProperties_Breakdownable" />
      <li Class="CompProperties_OxygenPusher"><requiresPower>true</requiresPower><airPerSecondPerHundredCells>0.01</airPerSecondPerHundredCells></li>
      <li Class="CompProperties_AmbientSound"><sound>OxygenPump_Ambient</sound><disabledOnUnpowered>true</disabledOnUnpowered></li>
      <li Class="WraithNaniteGravtech.CompProperties_WNGGravshipPartTheme"><theme>Asuran</theme></li>
    </comps>
    <researchPrerequisites><li>WNG_AsuranGravships</li></researchPrerequisites>
    <uiOrder>2420</uiOrder>
  </ThingDef>

  <ThingDef ParentName="BuildingBase">
    <defName>WNG_AsuranOrbitalScanner</defName>
    <label>Asuran orbital scanner</label>
    <description>An Ancient-derived long-range sensor array reconstructed by Asuran nanites. It uses Odyssey's native orbital-scanner logic to discover orbital destinations reachable by transport pods, shuttles or gravships.</description>
    <graphicData>
      <graphicClass>Graphic_Multi</graphicClass>
      <texPath>Things/Building/OrbitalScanner/OrbitalScanner</texPath>
      <drawSize>(3,3)</drawSize>
      <color>(0.65,0.85,1)</color>
    </graphicData>
    <size>(2,2)</size>
    <tickerType>Normal</tickerType>
    <castEdgeShadows>false</castEdgeShadows>
    <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
    <statBases>
      <MaxHitPoints>220</MaxHitPoints>
      <WorkToBuild>10000</WorkToBuild>
      <Flammability>0</Flammability>
      <Beauty>-2</Beauty>
    </statBases>
    <costList>
      <WNG_NaniteSludge>30</WNG_NaniteSludge>
      <Plasteel>160</Plasteel>
      <ComponentIndustrial>5</ComponentIndustrial>
      <ComponentSpacer>2</ComponentSpacer>
    </costList>
    <building><destroySound>BuildingDestroyed_Metal_Big</destroySound></building>
    <comps>
      <li Class="CompProperties_Power"><compClass>CompPowerTrader</compClass><basePowerConsumption>500</basePowerConsumption></li>
      <li Class="CompProperties_Breakdownable" />
      <li Class="CompProperties_Flickable" />
      <li><compClass>CompOrbitalScanner</compClass></li>
      <li Class="WraithNaniteGravtech.CompProperties_WNGGravshipPartTheme"><theme>Asuran</theme></li>
    </comps>
    <placeWorkers>
      <li>PlaceWorker_NotUnderRoof</li>
      <li>PlaceWorker_PreventInteractionSpotOverlap</li>
    </placeWorkers>
    <altitudeLayer>Building</altitudeLayer>
    <canBeUsedUnderRoof>false</canBeUsedUnderRoof>
    <fillPercent>0.4</fillPercent>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <designationCategory>WNG</designationCategory>
    <researchPrerequisites><li>WNG_AsuranGravships</li></researchPrerequisites>
    <constructionSkillPrerequisite>8</constructionSkillPrerequisite>
    <uiOrder>2430</uiOrder>
  </ThingDef>
</Defs>
