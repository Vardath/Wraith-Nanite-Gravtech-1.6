<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="LightMechanoid">
    <defName>WNG_ChildsToy</defName>
    <label>Child's Toy</label>
    <description>A player-owned mech gestated from controlled Replicator substrate. While properly controlled it behaves as a colony mech. If it remains uncontrolled long enough to go feral, its hidden lattice unfolds into an ordinary hostile Replicator Drone.</description>
    <statBases>
      <MarketValue>360</MarketValue>
      <MoveSpeed>3.8</MoveSpeed>
      <ArmorRating_Blunt>0.08</ArmorRating_Blunt>
      <ArmorRating_Sharp>0.12</ArmorRating_Sharp>
      <ArmorRating_Heat>0.10</ArmorRating_Heat>
      <MechEnergyLossPerHP>0.9</MechEnergyLossPerHP>
    </statBases>
    <race>
      <body>Mech_Light</body>
      <intelligence>ToolUser</intelligence>
      <mechWeightClass>Light</mechWeightClass>
      <baseBodySize>0.35</baseBodySize>
      <hasCorpse>false</hasCorpse>
      <hasMeat>false</hasMeat>
    </race>
    <tools Inherit="False">
      <li>
        <label>toy manipulators</label>
        <capacities><li>Blunt</li></capacities>
        <power>2.5</power>
        <cooldownTime>2.4</cooldownTime>
      </li>
    </tools>
    <comps>
      <li Class="WraithNaniteGravtech.CompProperties_ReplicatorState" />
      <li Class="WraithNaniteGravtech.CompProperties_ChildsToy">
        <controlCheckTicks>250</controlCheckTicks>
        <feralDelayTicks>60000</feralDelayTicks>
        <feralPawnKind>WNG_ReplicatorDrone</feralPawnKind>
        <feralFactionDef>WNG_ReplicatorSwarm</feralFactionDef>
      </li>
    </comps>
  </ThingDef>

  <PawnKindDef ParentName="LightMechanoidKind">
    <defName>WNG_ChildsToy</defName>
    <label>Child's Toy</label>
    <race>WNG_ChildsToy</race>
    <defaultFactionDef>PlayerColony</defaultFactionDef>
    <combatPower>8</combatPower>
    <weaponTags Inherit="False" />
    <lifeStages>
      <li>
        <bodyGraphicData>
          <texPath>Things/Pawn/Replicator/WNG_ReplicatorDrone</texPath>
          <shaderType>Cutout</shaderType>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>0.65</drawSize>
        </bodyGraphicData>
      </li>
    </lifeStages>
  </PawnKindDef>
</Defs>
