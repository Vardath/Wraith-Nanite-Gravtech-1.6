<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    Fresh WNG Feeding Niche. Historical WNG XML/art/audio is not reused.
    The Core single-bed graphic is a temporary presentation placeholder only.
  -->
  <ThingDef ParentName="BedBase">
    <defName>WNG_FeedingNiche</defName>
    <label>wraith feeding niche</label>
    <description>A restrained biological feeding berth used by Keepers and Queens to ration vitality from a hosted prisoner into hungry allied Wraith. This is conservative hive feeding, not the faction hunger request system and not the lethal repeat-drain path.</description>
    <graphicData>
      <texPath>Things/Building/Furniture/Bed/Bed</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>(2,2)</drawSize>
    </graphicData>
    <size>(1,2)</size>
    <tickerType>Normal</tickerType>
    <uiOrder>2045</uiOrder>
    <statBases>
      <MaxHitPoints>220</MaxHitPoints>
      <WorkToBuild>1800</WorkToBuild>
      <Mass>50</Mass>
      <Comfort>0.15</Comfort>
      <BedRestEffectiveness>0.65</BedRestEffectiveness>
      <SurgerySuccessChanceFactor>0.7</SurgerySuccessChanceFactor>
      <Flammability>0.25</Flammability>
    </statBases>
    <costList>
      <Steel>40</Steel>
      <ComponentIndustrial>2</ComponentIndustrial>
      <WNG_Biomass>35</WNG_Biomass>
    </costList>
    <building>
      <bed_showSleeperBody>true</bed_showSleeperBody>
      <bed_healPerDay>1</bed_healPerDay>
    </building>
    <comps>
      <li Class="WraithNaniteGravtech.CompProperties_WraithFeedingNiche">
        <intervalTicks>120000</intervalTicks>
        <prisonerAgeYears>2</prisonerAgeYears>
        <lifeForcePerRecipient>0.12</lifeForcePerRecipient>
        <recipientLimit>3</recipientLimit>
        <biomassYield>4</biomassYield>
        <lifeForceCutoff>0.85</lifeForceCutoff>
      </li>
    </comps>
    <researchPrerequisites>
      <li>WNG_FeedingEcology</li>
    </researchPrerequisites>
  </ThingDef>
</Defs>
