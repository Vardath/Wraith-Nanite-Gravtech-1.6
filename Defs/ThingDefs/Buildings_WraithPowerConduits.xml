<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Wraith themed presentation on RimWorld's native power-transmitter network. -->
  <ThingDef ParentName="PowerConduit">
    <defName>WNG_WraithBioelectricConduit</defName>
    <label>Wraith bioelectric conduit</label>
    <description>A visible living conduction strand grown through Wraith gravship tissue. Functionally it is a native RimWorld power conduit: it joins the ordinary electrical grid and carries power without a parallel WNG electricity system.</description>
    <graphicData>
      <texPath>Things/Building/Linked/PowerConduit_Atlas</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <linkType>Transmitter</linkType>
      <linkFlags><li>PowerConduit</li></linkFlags>
      <color>(0.38,0.18,0.28)</color>
      <damageData><rect>(0,0.35,1,0.3)</rect></damageData>
    </graphicData>
    <costList><WNG_WraithBioSludge>1</WNG_WraithBioSludge><Steel>1</Steel></costList>
    <comps>
      <li Class="WraithNaniteGravtech.CompProperties_WNGGravshipPartTheme"><theme>Wraith</theme></li>
    </comps>
    <terrainAffordanceNeeded>Substructure</terrainAffordanceNeeded>
    <designationCategory>WNG</designationCategory>
    <uiOrder>2450</uiOrder>
    <researchPrerequisites><li>WNG_WraithGravships</li></researchPrerequisites>
    <replaceTags><li>Conduit</li></replaceTags>
  </ThingDef>

  <ThingDef ParentName="PowerConduit">
    <defName>WNG_WraithHiddenBioelectricConduit</defName>
    <label>hidden Wraith bioelectric conduit</label>
    <description>A concealed living electrical strand integrated beneath Wraith gravship tissue. It remains a native RimWorld power transmitter while hiding its map graphic in normal view.</description>
    <graphicData>
      <texPath>Things/Building/Linked/PowerConduit_Atlas</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <linkType>Transmitter</linkType>
      <linkFlags><li>PowerConduit</li></linkFlags>
      <color>(0,0,0,0)</color>
      <shaderType>Transparent</shaderType>
    </graphicData>
    <uiIconPath>Things/Building/Linked/HiddenConduit_MenuIcon</uiIconPath>
    <statBases><MaxHitPoints>120</MaxHitPoints><WorkToBuild>300</WorkToBuild><Flammability>0</Flammability><Beauty>0</Beauty></statBases>
    <costList><WNG_WraithBioSludge>2</WNG_WraithBioSludge><Steel>1</Steel></costList>
    <comps>
      <li Class="WraithNaniteGravtech.CompProperties_WNGGravshipPartTheme"><theme>Wraith</theme></li>
    </comps>
    <building>
      <isPowerConduit>true</isPowerConduit>
      <ai_chillDestination>false</ai_chillDestination>
      <isInert>true</isInert>
      <isEdifice>false</isEdifice>
      <canLandGravshipOn>true</canLandGravshipOn>
      <canConstructInCorner>true</canConstructInCorner>
      <ai_neverTrashThis>true</ai_neverTrashThis>
      <isTargetable>false</isTargetable>
      <expandHomeArea>false</expandHomeArea>
      <canBeDamagedByAttacks>false</canBeDamagedByAttacks>
      <blueprintGraphicData><texPath>Things/Building/Linked/PowerConduit_Blueprint_Atlas</texPath></blueprintGraphicData>
    </building>
    <terrainAffordanceNeeded>Substructure</terrainAffordanceNeeded>
    <designationCategory>WNG</designationCategory>
    <uiOrder>2451</uiOrder>
    <constructEffect>ConstructDirt</constructEffect>
    <researchPrerequisites><li>WNG_WraithGravships</li></researchPrerequisites>
    <replaceTags><li>Conduit</li></replaceTags>
  </ThingDef>
</Defs>
