<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    Real Goa'uld Death Glider fighter. Native Building_PassengerShuttle / CompShuttle /
    CompTransporter / CompLaunchable / CompRefuelable own ordinary boarding, loading, travel and
    exact crew identity. WNG adds only the canon fighter role and physical staff-cannon sortie.

    Odyssey already carries spawned shuttles that are parked on connected gravship substructure
    when the gravship launches. A Death Glider parked on Ha'tak substructure is therefore a real
    carried fighter, not a proxy stored in a decorative hangar inventory.
  -->
  <ThingDef ParentName="BuildingBase" MayRequire="idolord.ONAC">
    <defName>WNG_GoauldDeathGlider</defName>
    <label>Death Glider</label>
    <description>A Goa'uld two-seat fighter built for atmospheric and space combat. It has no independent hyperdrive, so its world range is deliberately short; Ha'taks carry Gliders to distant theatres. Native shuttle systems own boarding, loading and travel, while WNG adds a real two-person staff-cannon combat sortie.</description>
    <thingClass>Building_PassengerShuttle</thingClass>
    <preventDroppingThingsOn>true</preventDroppingThingsOn>
    <size>(5,4)</size>
    <rotatable>true</rotatable>
    <graphicData>
      <texPath>Things/Building/Misc/Shuttle</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(5,4)</drawSize>
      <color>(0.58,0.42,0.18)</color>
    </graphicData>
    <defaultPlacingRot>North</defaultPlacingRot>
    <pathCost>50</pathCost>
    <drawOffscreen>true</drawOffscreen>
    <fillPercent>0.35</fillPercent>
    <passability>PassThroughOnly</passability>
    <stealable>false</stealable>
    <altitudeLayer>Building</altitudeLayer>
    <receivesSignals>true</receivesSignals>
    <neverMultiSelect>true</neverMultiSelect>
    <statBases>
      <MaxHitPoints>1800</MaxHitPoints>
      <WorkToBuild>22000</WorkToBuild>
      <Mass>190</Mass>
      <Flammability>0.12</Flammability>
      <Comfort>0.45</Comfort>
    </statBases>
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0,0,-3)</interactionCellOffset>
    <selectable>true</selectable>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <soundImpactDefault>BulletImpact_Metal</soundImpactDefault>
    <preventSkyfallersLandingOn>true</preventSkyfallersLandingOn>
    <drawerType>RealtimeOnly</drawerType>
    <repairEffect>ConstructMetal</repairEffect>
    <building>
      <claimable>false</claimable>
      <destroySound>BuildingDestroyed_Metal_Big</destroySound>
      <isInert>true</isInert>
    </building>
    <designationCategory>ONAC_Architect</designationCategory>
    <researchPrerequisites><li>WNG_GoauldShuttles</li></researchPrerequisites>
    <constructionSkillPrerequisite>8</constructionSkillPrerequisite>
    <costList>
      <ONAC_Naquadah>55</ONAC_Naquadah>
      <Plasteel>220</Plasteel>
      <Gold>20</Gold>
      <ComponentIndustrial>12</ComponentIndustrial>
      <ComponentSpacer>3</ComponentSpacer>
    </costList>
    <comps>
      <li Class="CompProperties_Shuttle"><shipDef>WNG_GoauldDeathGliderShip</shipDef></li>
      <li Class="CompProperties_Launchable">
        <fuelPerTile>2.6</fuelPerTile>
        <minFuelCost>25</minFuelCost>
        <skyfallerLeaving>WNG_GoauldDeathGliderLeaving</skyfallerLeaving>
        <worldObjectDef>WNG_GoauldDeathGliderWorld</worldObjectDef>
        <cooldownTicks>1800</cooldownTicks>
        <fixedLaunchDistanceMax>35</fixedLaunchDistanceMax>
        <cooldownEndedMessage>{0} is ready to launch again.</cooldownEndedMessage>
      </li>
      <li Class="CompProperties_Transporter">
        <massCapacity>220</massCapacity>
        <max1PerGroup>true</max1PerGroup>
        <canChangeAssignedThingsAfterStarting>true</canChangeAssignedThingsAfterStarting>
        <pawnLoadedSound>Shuttle_PawnLoaded</pawnLoadedSound>
        <pawnExitSound>Shuttle_PawnExit</pawnExitSound>
        <showMassInInspectString>true</showMassInInspectString>
      </li>
      <li Class="CompProperties_Refuelable">
        <fuelCapacity>420</fuelCapacity>
        <targetFuelLevelConfigurable>true</targetFuelLevelConfigurable>
        <initialConfigurableTargetFuelLevel>420</initialConfigurableTargetFuelLevel>
        <fuelFilter><thingDefs><li>ONAC_LiquidNaquadria</li></thingDefs></fuelFilter>
        <initialFuelPercent>0.5</initialFuelPercent>
        <consumeFuelOnlyWhenUsed>true</consumeFuelOnlyWhenUsed>
        <autoRefuelPercent>1</autoRefuelPercent>
        <showFuelGizmo>true</showFuelGizmo>
        <drawOutOfFuelOverlay>false</drawOutOfFuelOverlay>
        <canEjectFuel>true</canEjectFuel>
      </li>
      <li Class="WraithNaniteGravtech.CompProperties_GoauldDeathGliderMission">
        <attackPasses>2</attackPasses>
        <shotsPerPass>4</shotsPerPass>
        <acquisitionRadius>45</acquisitionRadius>
        <sortieFuelCost>30</sortieFuelCost>
        <requiredCrew>2</requiredCrew>
        <projectile>WNG_Projectile_GoauldDeathGliderStaffPulse</projectile>
      </li>
    </comps>
    <inspectorTabs><li>ITab_ContentsTransporter</li></inspectorTabs>
    <placeWorkers><li>PlaceWorker_NotUnderRoof</li></placeWorkers>
  </ThingDef>
</Defs>
