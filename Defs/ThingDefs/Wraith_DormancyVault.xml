<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    Fresh generator-only Wraith Dormancy Vault. Historical WNG XML/code/art/audio is not reused.
    This structure is intentionally absent from player designation menus: it is a finite hostile-Hive
    combat reserve, not a player construction route for free Wraith pawns.
    The Core machining-table graphic is a temporary presentation placeholder only.
  -->
  <ThingDef ParentName="BuildingBase">
    <defName>WNG_DormancyVault</defName>
    <label>wraith dormancy vault</label>
    <description>A sealed reservoir containing a finite reserve of dormant Wraith defenders. Damage or a nearby intruder can wake the reserve in small waves. Once emptied, the vault never refills and its occupants are not part of the Hive's demographic population.</description>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>Things/Building/Production/TableMachining</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(3,3)</drawSize>
    </graphicData>
    <size>(2,2)</size>
    <tickerType>Normal</tickerType>
    <altitudeLayer>Building</altitudeLayer>
    <fillPercent>0.8</fillPercent>
    <useHitPoints>true</useHitPoints>
    <passability>Impassable</passability>
    <statBases>
      <WorkToBuild>5200</WorkToBuild>
      <MaxHitPoints>700</MaxHitPoints>
      <Flammability>0.08</Flammability>
    </statBases>
    <comps>
      <li Class="WraithNaniteGravtech.CompProperties_WraithDormancyVault">
        <dormantCount>4</dormantCount>
        <triggerRadius>18</triggerRadius>
        <awakenIntervalTicks>180</awakenIntervalTicks>
        <awakenPerWave>2</awakenPerWave>
      </li>
    </comps>
  </ThingDef>
</Defs>
