<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Mechanical resource foundations. Vanilla Chemfuel art is temporary prototype art only;
       final WNG release requires dedicated Wraith bio-sludge and Asuran nanite-sludge graphics. -->
  <ThingDef ParentName="ResourceBase">
    <defName>WNG_WraithBioSludge</defName>
    <label>Wraith bio sludge</label>
    <description>A dense cultivated organic slurry used by reverse-engineered Wraith propulsion and living ship systems. Its final production recipe is tied to the Wraith living-tech economy and must not be confused with Wraith Life Force.</description>
    <graphicData>
      <texPath>Things/Item/Resource/Chemfuel</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <stackLimit>150</stackLimit>
    <alwaysHaulable>true</alwaysHaulable>
    <thingCategories><li>ResourcesRaw</li></thingCategories>
    <statBases><MarketValue>7</MarketValue><Mass>0.03</Mass><Flammability>0.35</Flammability></statBases>
  </ThingDef>

  <ThingDef ParentName="ResourceBase">
    <defName>WNG_NaniteSludge</defName>
    <label>nanite sludge</label>
    <description>A suspended nanite-rich engineering medium intended for Asuran ship systems. It is a manufactured Asuran resource and is distinct from loose Replicator blocks and Replicator matter.</description>
    <graphicData>
      <texPath>Things/Item/Resource/Chemfuel</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <stackLimit>150</stackLimit>
    <alwaysHaulable>true</alwaysHaulable>
    <thingCategories><li>ResourcesRaw</li></thingCategories>
    <statBases><MarketValue>9</MarketValue><Mass>0.025</Mass><Flammability>0</Flammability></statBases>
  </ThingDef>
</Defs>
