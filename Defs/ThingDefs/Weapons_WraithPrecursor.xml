<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="BaseHumanMakeableGun">
    <defName>WNG_WraithStunStaff</defName><label>wraith stun staff</label><description>A long grown capture staff that projects a powerful short-ranged neuromuscular discharge. A biological target struck by the pulse is stunned, briefly paralyzed and anesthetized for nonlethal capture. The reinforced living shaft also gives its wielder a useful close-combat advantage when enemies get inside the firing envelope.</description><techLevel>Spacer</techLevel>
    <graphicData><texPath>Things/Item/Weapon/Wraith/WNG_WraithStunStaff</texPath><graphicClass>Graphic_Single</graphicClass><drawSize>(1.8,1.8)</drawSize></graphicData>
    <statBases><WorkToMake>15000</WorkToMake><Mass>3.4</Mass><AccuracyTouch>0.95</AccuracyTouch><AccuracyShort>0.82</AccuracyShort><AccuracyMedium>0.20</AccuracyMedium><AccuracyLong>0.05</AccuracyLong><RangedWeapon_Cooldown>2.2</RangedWeapon_Cooldown></statBases>
    <recipeMaker><researchPrerequisite>WNG_LivingWeapons</researchPrerequisite><skillRequirements><Crafting>5</Crafting></skillRequirements><recipeUsers Inherit="False"><li>WNG_GrowthChamber</li></recipeUsers></recipeMaker>
    <costList><WNG_Biomass>24</WNG_Biomass></costList>
    <weaponTags><li>WNG_WraithCaptureWeapon</li><li>WNG_WraithWeapon</li></weaponTags><tradeTags><li>WeaponRanged</li></tradeTags><weaponClasses><li>RangedLight</li></weaponClasses>
    <tools>
      <li><label>reinforced staff strike</label><capacities><li>Blunt</li></capacities><power>12</power><cooldownTime>1.55</cooldownTime><armorPenetration>0.20</armorPenetration><chanceFactor>1.25</chanceFactor></li>
    </tools>
    <verbs><li><verbClass>Verb_Shoot</verbClass><hasStandardCommand>true</hasStandardCommand><defaultProjectile>WNG_ProjectileStunStaff</defaultProjectile><warmupTime>0.35</warmupTime><range>12.9</range><soundCast>WNG_WraithStunStaff_Discharge</soundCast></li></verbs>
  </ThingDef>
  <ThingDef ParentName="BaseBullet"><defName>WNG_ProjectileStunStaff</defName><label>staff stun discharge</label><thingClass>WraithNaniteGravtech.Projectile_WraithStunStaff</thingClass><graphicData><texPath>Things/Projectile/Charge_Small</texPath><graphicClass>Graphic_Single</graphicClass></graphicData><projectile><damageDef>Stun</damageDef><damageAmountBase>45</damageAmountBase><speed>100</speed></projectile></ThingDef>

  <ThingDef ParentName="BaseHumanMakeableGun">
    <defName>WNG_WraithStunner</defName><label>living stunner</label><description>A grown weapon that launches a neuromuscular disruption pulse. It is designed to disable prey for capture rather than destroy it outright. A recovered specimen can be analyzed at a research bench to reveal the basic principles of Wraith biological technology.</description><techLevel>Spacer</techLevel>
    <graphicData><texPath>Things/Item/Weapon/Wraith/WNG_WraithStunner</texPath><graphicClass>Graphic_Single</graphicClass></graphicData>
    <statBases><WorkToMake>12000</WorkToMake><Mass>2.2</Mass><AccuracyTouch>0.72</AccuracyTouch><AccuracyShort>0.78</AccuracyShort><AccuracyMedium>0.66</AccuracyMedium><AccuracyLong>0.45</AccuracyLong><RangedWeapon_Cooldown>1.5</RangedWeapon_Cooldown></statBases>
    <recipeMaker><researchPrerequisite>WNG_LivingWeapons</researchPrerequisite><skillRequirements><Crafting>5</Crafting></skillRequirements><recipeUsers Inherit="False"><li>WNG_GrowthChamber</li></recipeUsers></recipeMaker>
    <costList><WNG_Biomass>18</WNG_Biomass></costList>
    <weaponTags><li>WNG_WraithCaptureWeapon</li><li>WNG_WraithWeapon</li></weaponTags><tradeTags><li>WeaponRanged</li></tradeTags><weaponClasses><li>RangedLight</li></weaponClasses>
    <comps>
      <li Class="CompProperties_CompAnalyzableUnlockResearch">
        <analysisID>860101</analysisID><analysisRequiredRange>1~1</analysisRequiredRange><analysisDurationHours>2</analysisDurationHours><destroyedOnAnalyzed>false</destroyedOnAnalyzed><allowRepeatAnalysis>false</allowRepeatAnalysis><canStudyInPlace>false</canStudyInPlace>
        <activateTexPath>UI/WNG/Wraith</activateTexPath><activateLabelString>Analyze Wraith living technology</activateLabelString><activateDescString>Assign a researcher to analyze this recovered living weapon at a research bench.</activateDescString><jobString>analyzing Wraith living technology</jobString>
        <completedLetterLabel>Wraith living technology analyzed</completedLetterLabel><completedLetter>Study of the recovered living stunner has exposed enough cultivated tissue logic to begin systematic biological cultivation research.</completedLetter><completedLetterDef>PositiveEvent</completedLetterDef>
      </li>
    </comps>
    <verbs><li><verbClass>Verb_Shoot</verbClass><hasStandardCommand>true</hasStandardCommand><defaultProjectile>WNG_ProjectileStunner</defaultProjectile><warmupTime>0.8</warmupTime><range>22.9</range><soundCast>WNG_WraithStunner_Fire</soundCast><soundCastTail>GunTail_Medium</soundCastTail></li></verbs>
  </ThingDef>
  <ThingDef ParentName="BaseBullet"><defName>WNG_ProjectileStunner</defName><label>stunner pulse</label><graphicData><texPath>Things/Projectile/Charge_Small</texPath><graphicClass>Graphic_Single</graphicClass></graphicData><projectile><damageDef>Stun</damageDef><damageAmountBase>10</damageAmountBase><speed>65</speed></projectile></ThingDef>

