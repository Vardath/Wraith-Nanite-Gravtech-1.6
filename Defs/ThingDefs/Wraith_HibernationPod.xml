<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="BedBase">
    <defName>WNG_WraithHibernationPod</defName>
    <label>wraith hibernation pod</label>
    <description>A living suspension berth used by Wraith Hives to maintain an exact Wraith occupant in deep metabolic hibernation. The sleeper remains the real pawn and wakes normally when the Hive releases its dormant cohort.</description>
    <thingClass>Building_Bed</thingClass>
    <tickerType>Normal</tickerType>
    <size>(1,2)</size>
    <graphicData>
      <texPath>Things/Building/Furniture/Bed</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(1,2)</drawSize>
    </graphicData>
    <statBases>
      <MaxHitPoints>300</MaxHitPoints>
      <Flammability>0.15</Flammability>
      <Beauty>-2</Beauty>
      <WorkToBuild>2000</WorkToBuild>
    </statBases>
    <comps>
      <li Class="WraithNaniteGravtech.CompProperties_WraithHibernationPod">
        <hibernationRefreshTicks>180000</hibernationRefreshTicks>
      </li>
    </comps>
  </ThingDef>
</Defs>
