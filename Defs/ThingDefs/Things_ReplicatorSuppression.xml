<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="BuildingBase">
    <defName>WNG_ReplicatorSuppressionEmitter</defName>
    <label>anti-replicator EMP suppressor</label>
    <description>A hardened pulse emitter tuned to the timing and control frequencies recovered from Replicator core fragments. While powered, it periodically disrupts a limited number of nearby hostile WNG Replicators. Block forms temporarily lose the ability to assimilate matter, recombine or contribute controller coordination; human-form Replicators receive ordinary EMP disruption that can suspend nanite reconstruction. The pulse is deliberately bounded and nonlethal, buying time rather than erasing a swarm.</description>
    <thingClass>Building</thingClass>
    <drawerType>MapMeshAndRealTime</drawerType>
    <graphicData>
      <texPath>Things/Building/Replicator/Suppression/WNG_ReplicatorSuppressionEmitter</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(2.5,2.5)</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>45</pathCost>
    <blockWind>false</blockWind>
    <fillPercent>0.45</fillPercent>
    <tickerType>Rare</tickerType>
    <size>(2,2)</size>
    <rotatable>true</rotatable>
    <statBases>
      <MaxHitPoints>520</MaxHitPoints>
      <WorkToBuild>10500</WorkToBuild>
      <Mass>42</Mass>
      <Flammability>0</Flammability>
      <Beauty>3</Beauty>
    </statBases>
    <costList>
      <Steel>160</Steel>
      <Plasteel>110</Plasteel>
      <ComponentIndustrial>6</ComponentIndustrial>
      <ComponentSpacer>2</ComponentSpacer>
      <Uranium>25</Uranium>
      <WNG_ReplicatorCoreFragment>2</WNG_ReplicatorCoreFragment>
    </costList>
    <designationCategory>WNG_Architect</designationCategory>
    <constructionSkillPrerequisite>9</constructionSkillPrerequisite>
    <researchPrerequisites><li>WNG_AdvancedNaniteSuppression</li></researchPrerequisites>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>2600</basePowerConsumption>
        <transmitsPower>true</transmitsPower>
      </li>
      <li Class="CompProperties_Breakdownable" />
      <li Class="CompProperties_Glower"><glowRadius>5.5</glowRadius><glowColor>(105,205,235,0)</glowColor></li>
      <li Class="WraithNaniteGravtech.CompProperties_ReplicatorSuppressionEmitter">
        <radius>13</radius>
        <pulseIntervalTicks>1500</pulseIntervalTicks>
        <maxTargets>6</maxTargets>
        <suppressionTicks>2100</suppressionTicks>
        <empDamage>12</empDamage>
      </li>
    </comps>
    <building><destroySound>BuildingDestroyed_Metal_Big</destroySound><paintable>false</paintable></building>
    <uiOrder>2546</uiOrder>
  </ThingDef>
</Defs>
