<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Mechanics-first Wraith capture weapon. Final staff/stunner art and audio remain a production pass. -->
  <ThingDef ParentName="BaseGun">
    <defName>WNG_WraithStunStaff</defName>
    <label>Wraith stun staff</label>
    <description>A Wraith ranged capture weapon that projects a paralysing energy discharge. It is designed to incapacitate prey for culling or capture rather than kill them; successful shots use RimWorld's native stun system and inflict no ordinary projectile health damage.</description>
    <techLevel>Ultra</techLevel>
    <graphicData>
      <texPath>Things/Item/Equipment/WeaponRanged/ChargeRifle</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <color>(0.45,0.7,1)</color>
    </graphicData>
    <statBases>
      <MarketValue>450</MarketValue>
      <Mass>4.2</Mass>
      <AccuracyTouch>0.72</AccuracyTouch>
      <AccuracyShort>0.82</AccuracyShort>
      <AccuracyMedium>0.72</AccuracyMedium>
      <AccuracyLong>0.52</AccuracyLong>
      <RangedWeapon_Cooldown>2.4</RangedWeapon_Cooldown>
    </statBases>
    <weaponTags><li>WNG_WraithStunner</li></weaponTags>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>WNG_Projectile_WraithStun</defaultProjectile>
        <warmupTime>0.9</warmupTime>
        <range>26.9</range>
        <burstShotCount>1</burstShotCount>
        <soundCast>ChargeLance_Fire</soundCast>
        <soundCastTail>GunTail_Medium</soundCastTail>
        <muzzleFlashScale>4</muzzleFlashScale>
      </li>
    </verbs>
    <tools>
      <li>
        <label>staff</label>
        <capacities><li>Blunt</li></capacities>
        <power>7</power>
        <cooldownTime>2</cooldownTime>
      </li>
    </tools>
  </ThingDef>

  <ThingDef ParentName="BaseBullet">
    <defName>WNG_Projectile_WraithStun</defName>
    <label>Wraith stun discharge</label>
    <thingClass>WraithNaniteGravtech.Projectile_WraithStunner</thingClass>
    <graphicData>
      <texPath>Things/Projectile/Charge_Small</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>TransparentPostLight</shaderType>
      <color>(0.35,0.7,1)</color>
    </graphicData>
    <projectile>
      <!-- Required projectile metadata; custom Projectile_WraithStunner never calls TakeDamage. -->
      <damageDef>Stun</damageDef>
      <damageAmountBase>0</damageAmountBase>
      <armorPenetrationBase>0</armorPenetrationBase>
      <stoppingPower>0.5</stoppingPower>
      <speed>70</speed>
    </projectile>
    <modExtensions>
      <li Class="WraithNaniteGravtech.WraithStunnerProjectileExtension">
        <stunTicks>1800</stunTicks>
      </li>
    </modExtensions>
  </ThingDef>
</Defs>
