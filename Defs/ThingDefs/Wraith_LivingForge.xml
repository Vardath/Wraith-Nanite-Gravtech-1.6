<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    Fresh WNGR2 biomass production loop. Historical WNG XML/code/art/audio is not reused.
    The Core machining-table graphic is a temporary presentation placeholder only.
  -->
  <ThingDef ParentName="BenchBase">
    <defName>WNG_LivingForge</defName>
    <label>living forge</label>
    <description>A controlled Wraith tissue-cultivation worktable that breaks down biological feedstock and regrows it into stable cultured biomass for living technology.</description>
    <thingClass>Building_WorkTable</thingClass>
    <graphicData>
      <texPath>Things/Building/Production/TableMachining</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(3.5,1.5)</drawSize>
    </graphicData>
    <size>(3,1)</size>
    <altitudeLayer>Building</altitudeLayer>
    <fillPercent>0.5</fillPercent>
    <useHitPoints>true</useHitPoints>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <surfaceType>Item</surfaceType>
    <designationCategory>Production</designationCategory>
    <uiOrder>2575</uiOrder>
    <costList>
      <Steel>120</Steel>
      <ComponentIndustrial>4</ComponentIndustrial>
    </costList>
    <statBases>
      <WorkToBuild>2800</WorkToBuild>
      <MaxHitPoints>180</MaxHitPoints>
      <Flammability>0.35</Flammability>
      <Cleanliness>-1</Cleanliness>
    </statBases>
    <constructionSkillPrerequisite>5</constructionSkillPrerequisite>
    <recipes>
      <li>WNG_CultureBiomass</li>
    </recipes>
    <inspectorTabs>
      <li>ITab_Bills</li>
    </inspectorTabs>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <shortCircuitInRain>true</shortCircuitInRain>
        <basePowerConsumption>250</basePowerConsumption>
      </li>
      <li Class="CompProperties_Flickable"/>
      <li Class="CompProperties_Breakdownable"/>
    </comps>
    <building>
      <spawnedConceptLearnOpportunity>BillsTab</spawnedConceptLearnOpportunity>
    </building>
    <researchPrerequisites>
      <li>WNG_BiologicalCultivation</li>
    </researchPrerequisites>
  </ThingDef>

  <RecipeDef>
    <defName>WNG_CultureBiomass</defName>
    <label>culture biomass</label>
    <jobString>Culturing biomass.</jobString>
    <description>Break down raw biological tissue and regrow it into stable Wraith cultured biomass.</description>
    <workAmount>900</workAmount>
    <workSkill>Crafting</workSkill>
    <skillRequirements>
      <Crafting>4</Crafting>
    </skillRequirements>
    <ingredients>
      <li>
        <filter>
          <categories>
            <li>MeatRaw</li>
          </categories>
        </filter>
        <count>20</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <categories>
        <li>MeatRaw</li>
      </categories>
    </fixedIngredientFilter>
    <products>
      <WNG_Biomass>16</WNG_Biomass>
    </products>
    <researchPrerequisite>WNG_BiologicalCultivation</researchPrerequisite>
  </RecipeDef>
</Defs>
