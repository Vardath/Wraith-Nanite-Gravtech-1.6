<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <FactionDef ParentName="FactionBase">
    <defName>WNG_ReplicatorSwarm</defName>
    <label>replicator swarm</label>
    <fixedName>The Replication Swarm</fixedName>
    <description>An autonomous machine swarm that disassembles usable matter and turns successful consumption into additional Replicators. Mature swarms can field human-form Replicators alongside small machine forms, using the former as adaptive assault and infiltration units.</description>
    <basicMemberKind>WNG_ReplicatorDrone</basicMemberKind>
    <pawnSingular>replicator</pawnSingular>
    <pawnsPlural>replicators</pawnsPlural>
    <requiredCountAtGameStart>1</requiredCountAtGameStart>
    <canMakeRandomly>false</canMakeRandomly>
    <settlementGenerationWeight>0</settlementGenerationWeight>
    <factionIconPath>World/WorldObjects/Expanding/Sites/MechCluster</factionIconPath>
    <settlementTexturePath>World/WorldObjects/DefaultSettlement</settlementTexturePath>
    <techLevel>Ultra</techLevel>
    <humanlikeFaction>false</humanlikeFaction>
    <hidden>true</hidden>
    <permanentEnemy>true</permanentEnemy>
    <hostileToFactionlessHumanlikes>true</hostileToFactionlessHumanlikes>
    <autoFlee>false</autoFlee>
    <canSiege>false</canSiege>
    <canStageAttacks>true</canStageAttacks>
    <rescueesCanJoin>false</rescueesCanJoin>
    <allowedArrivalTemperatureRange>-100~200</allowedArrivalTemperatureRange>
    <raidCommonalityFromPointsCurve><points><li>(0,0.18)</li></points></raidCommonalityFromPointsCurve>
    <maxPawnCostPerTotalPointsCurve><points><li>(0,40)</li><li>(500,180)</li><li>(1500,260)</li><li>(100000,100000)</li></points></maxPawnCostPerTotalPointsCurve>
    <pawnGroupMakers>
      <li>
        <kindDef>Combat</kindDef>
        <commonality>100</commonality>
        <options>
          <WNG_ReplicatorDrone>10</WNG_ReplicatorDrone>
          <WNG_HumanFormReplicator>2.2</WNG_HumanFormReplicator>
        </options>
      </li>
    </pawnGroupMakers>
  </FactionDef>
</Defs>
