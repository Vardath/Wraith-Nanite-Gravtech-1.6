<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <FactionDef ParentName="FactionBase">
    <defName>WNG_ReplicatorSwarm</defName>
    <label>replicator swarm</label>
    <fixedName>The Replication Swarm</fixedName>
    <description>An autonomous machine infestation that dismantles accessible matter, learns from useful technology, rebuilds itself from what it consumes and reorganizes smaller units into larger operational and specialist forms.</description>
    <basicMemberKind>WNG_ReplicatorDrone</basicMemberKind>
    <pawnSingular>replicator</pawnSingular><pawnsPlural>replicators</pawnsPlural>
    <requiredCountAtGameStart>1</requiredCountAtGameStart>
    <canMakeRandomly>false</canMakeRandomly><settlementGenerationWeight>0</settlementGenerationWeight>
    <settlementTexturePath>World/WorldObjects/DefaultSettlement</settlementTexturePath>
    <factionIconPath>World/WorldObjects/Expanding/Sites/MechCluster</factionIconPath>
    <techLevel>Ultra</techLevel><humanlikeFaction>false</humanlikeFaction>
    <hidden>true</hidden><permanentEnemy>true</permanentEnemy><hostileToFactionlessHumanlikes>true</hostileToFactionlessHumanlikes>
    <autoFlee>false</autoFlee><canSiege>false</canSiege><canStageAttacks>true</canStageAttacks><rescueesCanJoin>false</rescueesCanJoin>
    <allowedArrivalTemperatureRange>-100~200</allowedArrivalTemperatureRange>
    <pawnGroupMakers>
      <li>
        <kindDef>Combat</kindDef><commonality>100</commonality>
        <options>
          <WNG_ReplicatorDrone>12</WNG_ReplicatorDrone>
          <WNG_ReplicatorHunter>5</WNG_ReplicatorHunter>
          <WNG_ReplicatorBulwark>1.6</WNG_ReplicatorBulwark>
          <WNG_ReplicatorController>0.55</WNG_ReplicatorController>
          <WNG_ReplicatorRepairer>0.9</WNG_ReplicatorRepairer>
          <WNG_ReplicatorBurrower>0.75</WNG_ReplicatorBurrower>
          <WNG_ReplicatorArtillery>0.35</WNG_ReplicatorArtillery>
          <WNG_ReplicatorTitan>0.22</WNG_ReplicatorTitan>
          <WNG_ReplicatorSiegeMass>0.05</WNG_ReplicatorSiegeMass>
        </options>
      </li>
    </pawnGroupMakers>
  </FactionDef>
</Defs>
