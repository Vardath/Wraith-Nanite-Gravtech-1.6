<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <FactionDef Name="WNG_WraithFactionBase" ParentName="FactionBase" Abstract="True">
    <basicMemberKind>WNG_WraithWarrior</basicMemberKind>
    <pawnSingular>wraith</pawnSingular><pawnsPlural>wraith</pawnsPlural><leaderTitle>queen</leaderTitle>
    <requiredCountAtGameStart>1</requiredCountAtGameStart><maxCountAtGameStart>1</maxCountAtGameStart><maxConfigurableAtWorldCreation>1</maxConfigurableAtWorldCreation><canMakeRandomly>true</canMakeRandomly>
    <settlementTexturePath>World/WorldObjects/DefaultSettlement</settlementTexturePath><factionIconPath>World/WorldObjects/Expanding/Town</factionIconPath>
    <factionNameMaker>NamerFactionOutlander</factionNameMaker><settlementNameMaker>NamerSettlementOutlander</settlementNameMaker>
    <techLevel>Spacer</techLevel><humanlikeFaction>true</humanlikeFaction><canSiege>true</canSiege><canStageAttacks>true</canStageAttacks><rescueesCanJoin>false</rescueesCanJoin>
    <allowedArrivalTemperatureRange>-50~55</allowedArrivalTemperatureRange>
    <xenotypeSet><xenotypeChances><WNG_Wraith>999</WNG_Wraith></xenotypeChances></xenotypeSet>
    <maxPawnCostPerTotalPointsCurve><points><li>(0,95)</li><li>(500,145)</li><li>(1400,230)</li><li>(3000,320)</li><li>(100000,10000)</li></points></maxPawnCostPerTotalPointsCurve>
  </FactionDef>

  <FactionDef ParentName="WNG_WraithFactionBase">
    <defName>WNG_WraithSableBrood</defName><label>hostile wraith brood</label><fixedName>The Sable Brood</fixedName>
    <description>An uncompromising predatory Hive lineage that regards other peoples as feeding stock and rival Wraith lineages as competitors for territory and prey.</description>
    <configurationListOrderPriority>120</configurationListOrderPriority><settlementGenerationWeight>0.36</settlementGenerationWeight><permanentEnemy>true</permanentEnemy><autoFlee>false</autoFlee>
    <raidCommonalityFromPointsCurve><points><li>(0,0.22)</li></points></raidCommonalityFromPointsCurve>
    <modExtensions><li Class="WraithNaniteGravtech.WraithFactionHungerExtension"><initialHunger>0.20</initialHunger><hungerPerDay>0.08</hungerPerDay><requestThreshold>0.65</requestThreshold><raidThreshold>0.76</raidThreshold><raidDoctrineFactor>1.35</raidDoctrineFactor><canRequestFeeding>false</canRequestFeeding></li></modExtensions>
    <pawnGroupMakers>
      <li><kindDef>Combat</kindDef><commonality>100</commonality><options><WNG_WraithHunter>8</WNG_WraithHunter><WNG_WraithWarrior>14</WNG_WraithWarrior><WNG_WraithCommander>2.5</WNG_WraithCommander><WNG_WraithKeeper>0.3</WNG_WraithKeeper><WNG_WraithQueen>0.12</WNG_WraithQueen></options></li>
      <li><kindDef>Settlement</kindDef><options><WNG_WraithHunter>5</WNG_WraithHunter><WNG_WraithWarrior>12</WNG_WraithWarrior><WNG_WraithCommander>3</WNG_WraithCommander><WNG_WraithKeeper>2</WNG_WraithKeeper><WNG_WraithQueen>0.35</WNG_WraithQueen></options></li>
    </pawnGroupMakers>
  </FactionDef>

  <FactionDef ParentName="WNG_WraithFactionBase">
    <defName>WNG_WraithCinderCourt</defName><label>militant wraith court</label><fixedName>The Cinder Court</fixedName>
    <description>A Queen-led militant Hive that raids aggressively and contests territory, but whose hostility is political rather than permanently absolute.</description>
    <configurationListOrderPriority>121</configurationListOrderPriority><settlementGenerationWeight>0.24</settlementGenerationWeight><permanentEnemy>false</permanentEnemy><autoFlee>false</autoFlee>
    <raidCommonalityFromPointsCurve><points><li>(0,0.14)</li></points></raidCommonalityFromPointsCurve>
    <modExtensions><li Class="WraithNaniteGravtech.WraithFactionHungerExtension"><initialHunger>0.18</initialHunger><hungerPerDay>0.08</hungerPerDay><requestThreshold>0.65</requestThreshold><raidThreshold>0.80</raidThreshold><feedingRelief>0.55</feedingRelief><feedingAgeYears>12</feedingAgeYears><raidDoctrineFactor>1.15</raidDoctrineFactor></li></modExtensions>
    <pawnGroupMakers>
      <li><kindDef>Combat</kindDef><commonality>100</commonality><options><WNG_WraithHunter>6</WNG_WraithHunter><WNG_WraithWarrior>16</WNG_WraithWarrior><WNG_WraithCommander>3.5</WNG_WraithCommander><WNG_WraithKeeper>0.5</WNG_WraithKeeper><WNG_WraithQueen>0.16</WNG_WraithQueen></options></li>
      <li><kindDef>Peaceful</kindDef><commonality>35</commonality><options><WNG_WraithHunter>4</WNG_WraithHunter><WNG_WraithWarrior>3</WNG_WraithWarrior><WNG_WraithKeeper>1</WNG_WraithKeeper><WNG_WraithCommander>0.35</WNG_WraithCommander></options></li>
      <li><kindDef>Settlement</kindDef><options><WNG_WraithHunter>4</WNG_WraithHunter><WNG_WraithWarrior>13</WNG_WraithWarrior><WNG_WraithCommander>4</WNG_WraithCommander><WNG_WraithKeeper>2</WNG_WraithKeeper><WNG_WraithQueen>0.40</WNG_WraithQueen></options></li>
    </pawnGroupMakers>
  </FactionDef>

  <FactionDef ParentName="WNG_WraithFactionBase">
    <defName>WNG_WraithVeiledHive</defName><label>wary wraith hive</label><fixedName>The Veiled Hive</fixedName>
    <description>A cautious Hive that prefers selective feeding, concealment and negotiated access over open territorial war, while remaining biologically predatory.</description>
    <basicMemberKind>WNG_WraithHunter</basicMemberKind><configurationListOrderPriority>122</configurationListOrderPriority><settlementGenerationWeight>0.16</settlementGenerationWeight><permanentEnemy>false</permanentEnemy><autoFlee>true</autoFlee>
    <raidCommonalityFromPointsCurve><points><li>(0,0.045)</li></points></raidCommonalityFromPointsCurve>
    <modExtensions><li Class="WraithNaniteGravtech.WraithFactionHungerExtension"><initialHunger>0.16</initialHunger><hungerPerDay>0.07</hungerPerDay><requestThreshold>0.68</requestThreshold><raidThreshold>0.84</raidThreshold><feedingRelief>0.58</feedingRelief><feedingAgeYears>8</feedingAgeYears><raidDoctrineFactor>0.75</raidDoctrineFactor></li></modExtensions>
    <pawnGroupMakers>
      <li><kindDef>Combat</kindDef><commonality>100</commonality><options><WNG_WraithHunter>12</WNG_WraithHunter><WNG_WraithWarrior>9</WNG_WraithWarrior><WNG_WraithCommander>1.5</WNG_WraithCommander><WNG_WraithKeeper>0.5</WNG_WraithKeeper><WNG_WraithQueen>0.08</WNG_WraithQueen></options></li>
      <li><kindDef>Peaceful</kindDef><commonality>80</commonality><options><WNG_WraithHunter>6</WNG_WraithHunter><WNG_WraithWarrior>4</WNG_WraithWarrior><WNG_WraithKeeper>1.5</WNG_WraithKeeper><WNG_WraithCommander>0.5</WNG_WraithCommander></options></li>
      <li><kindDef>Settlement</kindDef><options><WNG_WraithHunter>8</WNG_WraithHunter><WNG_WraithWarrior>8</WNG_WraithWarrior><WNG_WraithKeeper>2</WNG_WraithKeeper><WNG_WraithCommander>1.5</WNG_WraithCommander><WNG_WraithQueen>0.30</WNG_WraithQueen></options></li>
    </pawnGroupMakers>
  </FactionDef>

  <FactionDef ParentName="WNG_WraithFactionBase">
    <defName>WNG_WraithPaleCovenant</defName><label>wraith exiles</label><fixedName>The Pale Covenant</fixedName>
    <description>A Wraith offshoot that has abandoned indiscriminate predation. They remain biologically dependent on harvested vitality but can trade, negotiate and coexist when supplied.</description>
    <leaderTitle>elder</leaderTitle><configurationListOrderPriority>123</configurationListOrderPriority><settlementGenerationWeight>0.16</settlementGenerationWeight><permanentEnemy>false</permanentEnemy><autoFlee>true</autoFlee><rescueesCanJoin>true</rescueesCanJoin>
    <raidCommonalityFromPointsCurve><points><li>(0,0.045)</li></points></raidCommonalityFromPointsCurve>
    <modExtensions><li Class="WraithNaniteGravtech.WraithFactionHungerExtension"><initialHunger>0.12</initialHunger><hungerPerDay>0.06</hungerPerDay><requestThreshold>0.72</requestThreshold><raidThreshold>0.90</raidThreshold><feedingRelief>0.62</feedingRelief><feedingAgeYears>5</feedingAgeYears><raidDoctrineFactor>0.55</raidDoctrineFactor></li></modExtensions>
    <pawnGroupMakers>
      <li><kindDef>Combat</kindDef><commonality>100</commonality><options><WNG_WraithHunter>8</WNG_WraithHunter><WNG_WraithWarrior>12</WNG_WraithWarrior><WNG_WraithCommander>1.2</WNG_WraithCommander><WNG_WraithKeeper>0.8</WNG_WraithKeeper></options></li>
      <li><kindDef>Peaceful</kindDef><commonality>80</commonality><options><WNG_WraithHunter>3</WNG_WraithHunter><WNG_WraithWarrior>6</WNG_WraithWarrior><WNG_WraithKeeper>1.5</WNG_WraithKeeper><WNG_WraithCommander>0.4</WNG_WraithCommander></options></li>
      <li><kindDef>Settlement</kindDef><options><WNG_WraithHunter>5</WNG_WraithHunter><WNG_WraithWarrior>8</WNG_WraithWarrior><WNG_WraithKeeper>2</WNG_WraithKeeper><WNG_WraithCommander>1.5</WNG_WraithCommander></options></li>
    </pawnGroupMakers>
  </FactionDef>
</Defs>
