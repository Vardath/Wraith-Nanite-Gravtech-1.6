<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <GeneDef>
    <defName>WNG_AsuranNanitePhysiology</defName>
    <label>nanite physiology</label>
    <description>This humanoid is a synthetic body composed of coordinated microscopic nanites. Its ordinary RimWorld food need is replaced by a Nanite Reserve: ingested food is treated as matter feedstock, normal operation drains the reserve, and reconstruction or fabrication spends it directly. At critically low reserve the body weakens and falls back to slower emergency repair rather than biological malnutrition. Missing body parts can be reconstructed over time. EMP disrupts the lattice and suspends self-repair and reconstruction.</description>
    <geneClass>WraithNaniteGravtech.Gene_AsuranNanitePhysiology</geneClass>
    <enablesNeeds><li>WNG_NaniteMatterReserve</li></enablesNeeds>
    <disablesNeeds><li>Food</li></disablesNeeds>
    <makeImmuneTo><li>Malnutrition</li></makeImmuneTo>
    <dontMindRawFood>true</dontMindRawFood>
    <foodPoisoningChanceFactor>0</foodPoisoningChanceFactor>
    <sterilize>true</sterilize>
    <biologicalAgeTickFactorFromAgeCurve><points><li>(0,0)</li><li>(1000,0)</li></points></biologicalAgeTickFactorFromAgeCurve>
    <abilities>
      <li>WNG_AssembleAsuranWorkshop</li>
      <li>WNG_NeuralInterface</li>
    </abilities>
    <modExtensions><li Class="WraithNaniteGravtech.AsuranNanitePhysiologyExtension">
      <reconcileIntervalTicks>120</reconcileIntervalTicks>
      <healIntervalTicks>450</healIntervalTicks>
      <baseHealAmount>0.12</baseHealAmount>
      <reserveFractionPerHealPulse>0.015</reserveFractionPerHealPulse>
      <depletedHealIntervalTicks>1800</depletedHealIntervalTicks>
      <missingPartIntervalTicks>30000</missingPartIntervalTicks>
      <reserveFractionPerRestoredPart>0.25</reserveFractionPerRestoredPart>
      <depletedMissingPartIntervalTicks>90000</depletedMissingPartIntervalTicks>
      <depletionThreshold>0.15</depletionThreshold>
      <empSuppressionTicks>1800</empSuppressionTicks>
    </li></modExtensions>
    <biostatCpx>4</biostatCpx><biostatMet>0</biostatMet>
  </GeneDef>
</Defs>
